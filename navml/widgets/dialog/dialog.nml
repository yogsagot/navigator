from navml.widgets.button import Button
from navml.widgets.static_text import StaticText

#: A prompt with three buttons.
#:
#: The worked example of a component whose *children* raise the events its
#: hand-written half handles: two of the buttons are routed by the
#: ``on_<id>_<event>`` convention and the third by an explicit markup line,
#: which is the escape hatch for a handler named after what the component
#: does rather than after what happened.
Dialog:
    property prompt: ""

    StaticText:
        id: message
        x: 1
        y: 1
        width: max(0, parent.width - 2)
        height: 1
        text: parent.prompt
        align: "left"

    Button:
        id: ok
        x: 1
        y: 3
        width: 10
        height: 1
        text: "OK"

    Button:
        id: cancel
        x: 12
        y: 3
        width: 10
        height: 1
        text: "Cancel"

    Button:
        id: info
        x: 23
        y: 3
        width: 10
        height: 1
        text: "Help"
        on_click: await root.show_info(event)
