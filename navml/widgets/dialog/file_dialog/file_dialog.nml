from navml.widgets.dialog.button import Button
from navml.widgets.dialog.dialog import Dialog
from navml.widgets.dialog.field import Field
from navml.widgets.dialog.file_list import FileInfoPane, FileList
from navml.widgets.dialog.label import Label

#: DOS Navigator's ``TFileDialog`` (``DNSTDDLG.PAS``), as ``GetFileNameDialog``
#: built it with OK and Help.
#:
#: **Not ``TFileDialog.Init``'s rectangles.**  The original was a fixed 47 by
#: 19, sized for a 80 by 25 screen and 8.3 names: fifteen columns showed one
#: of today's names in part.  This one takes the screen less a margin, never
#: less than the original's, and every control is placed against the
#: dialog's edges, so they grow with it: the name line along the top with its
#: label over it, the lists from row 6 down to the info pane's two rows at
#: the bottom, the buttons down the right ten wide and three rows apart.
#:
#: **The lists are swapped**: *Directories* on the left, narrower, and *Files*
#: on the right, taking three fifths of the room -- where one goes, then what
#: is there, read left to right, the way the tab order goes.
#:
#: ``Dialog``'s own row of buttons and its message are not this layout, and
#: the hand-written half hides them.
FileDialog(Dialog):
    modal_width: max(47, parent.width - 6) if parent is not None else 47
    modal_height: max(19, parent.height - 4) if parent is not None else 19
    title: "Open file"

    #: ``InputName``: what the caller calls the name -- *File Name*, *Paste from*.
    Label:
        id: caption
        text: "~N~ame"
        link: target.entry
        x: 2
        y: 2
        width: max(0, parent.width - 18)
        height: 1

    Field:
        id: target
        x: 3
        y: 3
        width: max(0, parent.width - 16)
        height: 1
        label_text: ""
        label_width: 0

    Label:
        id: dirs_caption
        text: "~D~irectories"
        link: dirs
        x: 2
        y: 5
        width: dirs.width
        height: 1

    FileList:
        id: dirs
        framed: False
        x: 3
        y: 6
        width: max(0, parent.width - 17) * 2 // 5
        height: max(0, parent.height - 10)

    Label:
        id: files_caption
        text: "~F~iles"
        link: files
        x: files.x - 1
        y: 5
        width: files.width
        height: 1

    FileList:
        id: files
        framed: False
        x: dirs.x + dirs.width + 2
        y: 6
        width: max(0, parent.width - 17 - dirs.width)
        height: max(0, parent.height - 10)

    #: ``cmFileOpen``, the default: whatever the name line says, a directory or a
    #: wildcard changing what is listed and a file name closing the dialog.
    Button:
        id: pick
        text: "O~K~"
        default: True
        x: max(0, parent.width - 12)
        y: 3
        width: 10
        height: 2

    Button:
        id: abandon
        text: "Cancel"
        x: max(0, parent.width - 12)
        y: 6
        width: 10
        height: 2

    #: No help is written yet, so the button is shown and disabled.
    Button:
        id: helper
        text: "~H~elp"
        disabled: True
        x: max(0, parent.width - 12)
        y: 9
        width: 10
        height: 2

    FileInfoPane:
        id: info
        x: 1
        y: max(0, parent.height - 3)
        width: max(0, parent.width - 2)
        height: 2
