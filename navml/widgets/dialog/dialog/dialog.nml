from navml.widgets.dialog.commands import Cancel, Default, SelectNext, SelectPrevious
from navml.widgets.dialog.button import Button
from navml.widgets.dialog.button_row import ButtonRow
from navml.widgets.dialog.static_text import StaticText
from navml.widgets.dialog.modal import Modal
from navml.widgets.menu.commands import ShowContextMenu

#: A modal window with an OK and a Cancel, and an answer.
#:
#: Still the worked example of a component whose *children* raise the events
#: its hand-written half handles -- a dialog with two buttons in it is what
#: the ``on_<id>_<event>`` convention was written for, and it is now a widget
#: that earns the example rather than a demonstration built to carry it.
#:
#: Its size and its place are :class:`~navml.widgets.dialog.modal.Modal`'s: a derived
#: document says ``modal_width: 44``, and the centring is the base's binding.
Dialog(Modal):
    #: ``ok``, ``ok-cancel``, ``ok-cancel-help``, ``yes-no-cancel``
    #: (``mfYesNoCancel``, OK captioned *Yes*) or ``yes-no`` (``mfYesButton +
    #: mfNoButton``, the same without Cancel; Esc still answers ``None``) --
    #: or ``none``, for a dialog that places buttons of its own, in a
    #: ``ButtonRow`` or by hand, and wants no row of this one's.  Which buttons is a
    #: *visibility* question, because markup has no conditional and needs
    #: none: all four are declared and a hidden one is already out of the
    #: tab order, out of the shortcut walk and out of the paint.
    property buttons: "ok-cancel"

    #: The line of text above the buttons.
    property prompt: ""

    #: Whether a click outside the dialog cancels it, as Esc does.  Off,
    #: because a dialog usually holds the user's work and a stray click must
    #: not cost it; a small one that is opened from another dialog -- and is
    #: cheap to open again -- says yes in its own document.
    property close_on_outside_click: False

    #: Turbo Vision's dialog keys.  Reached only once a key has passed the
    #: control that has the keyboard, so an input line that wants Enter or Tab
    #: for itself takes it first.
    keys:
        escape: Cancel
        enter: Default
        tab: SelectNext
        shift+tab: SelectPrevious
        #: The focused control's context menu, as the global table has it:
        #: that table stands aside while a dialog is up.
        menu: ShowContextMenu
        shift+f10: ShowContextMenu

    #: The commands this component handles itself.
    commands:
        SelectNext: root._application_or_raise().focus_next()
        SelectPrevious: root._application_or_raise().focus_next(reverse=True)

    StaticText:
        id: message
        y: 2
        height: max(1, parent.height - 6)
        anchors:
            left: 2
            right: 2
        text: parent.prompt
        wrap: True
        #: Only while there is something to say: a dialog of controls says
        #: nothing here, and its controls take the space.
        visible: root.prompt != ""

    #: The buttons, centred as a row.  Each is 11 columns -- nine of face, two
    #: of bracket, one of shadow -- with two between, and a hidden one gives
    #: up its slot, so two stay centred as well as three do.
    ButtonRow:
        id: row
        visible: root.buttons != "none"
        anchors:
            left: 0
            right: 0
            bottom: 2

        Button:
            id: ok
            text: "~Y~es" if root.buttons in ("yes-no-cancel", "yes-no") else "O~K~"
            default: True

        #: *No* answers False, where Cancel answers None.
        Button:
            id: no
            text: "~N~o"
            visible: root.buttons in ("yes-no-cancel", "yes-no")
            #: *No* of ``yes-no-cancel`` and ``yes-no``: an answer, and a different one from Cancel's.
            on_click: root.close(False)

        Button:
            id: cancel
            text: "~C~ancel"
            visible: root.buttons not in ("ok", "yes-no")

        #: Routed by an explicit line, because :meth:`show_info` is named for
        #: what the dialog *does* rather than for what happened to it -- the
        #: escape hatch from the ``on_<id>_<event>`` convention, and the third
        #: of the three ways a child's event reaches this component's Python
        #: half.
        Button:
            id: info
            text: "~H~elp"
            visible: root.buttons == "ok-cancel-help"
            on_click: await root.show_info(event)
