from navml.widgets.dialog.button import Button
from navml.widgets.dialog.check_boxes import CheckBoxes
from navml.widgets.dialog.label import Label
from navml.widgets.dialog.list_viewer import ListViewer
from navml.widgets.dialog.radio_buttons import RadioButtons

#: Options > Configuration > Screen savers: DOS Navigator's ``TSaversDialog``
#: (SETUPS.PAS), which DN built in code rather than in ``DN.DNR``.
#:
#: Its lists leave PgUp and PgDn to the tabs of *Settings* (``page_keys``):
#: seven rows need no paging, and the keys mean the next page there.
#:
#: Its rectangles: the selected savers down the left, *Add* and *Remove*
#: between, the available ones down the right, *Time* and *Use mouse* under
#: them, as DN had them -- the lists three rows shorter than DN's, so the
#: page is no taller than *Panel defaults* in *Settings*.  Help is left out,
#: having nothing to show yet.
SaversPage:
    #: The caption on its tab, which *Settings* gives it.
    property title: ""

    Label:
        id: chosen_caption
        x: 2
        y: 2
        width: 17
        height: 1
        text: "~S~elected savers"
        link: chosen

    ListViewer:
        id: chosen
        framed: False
        page_keys: False
        x: 2
        y: 3
        width: 18
        height: 7

    #: DN's ``cmYes``, broadcast: the available saver at its cursor joins.
    Button:
        id: join
        text: "<───── ~A~dd"
        x: 21
        y: 4
        width: 15
        height: 2

    #: ``cmNo``: the selected saver at its cursor goes.
    Button:
        id: drop
        text: "~R~emove ──>"
        x: 21
        y: 6
        width: 15
        height: 2

    Label:
        id: offered_caption
        x: 37
        y: 2
        width: 18
        height: 1
        text: "A~v~ailable savers"
        link: offered

    ListViewer:
        id: offered
        framed: False
        page_keys: False
        x: 37
        y: 3
        width: 18
        height: 7

    Label:
        id: time_caption
        x: 2
        y: 11
        width: 8
        height: 1
        text: "~T~ime"
        link: time

    RadioButtons:
        id: time
        x: 2
        y: 12
        width: 16
        height: 5
        items: ["~N~ever", "~1~ minute", "~2~ minutes", "~5~ minutes", "1~0~ minutes"]

    CheckBoxes:
        id: mouse
        x: 20
        y: 12
        width: 35
        height: 1
        items: ["Use ~m~ouse to call saver"]
