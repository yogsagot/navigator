from navml.widgets.dialog.dialog import Dialog
from navml.widgets.dialog.static_text import StaticText
from navigator.widgets.setup.key_capture_dialog.key_catcher import KeyCatcher

#: Key bindings' *Press a key*: whatever is pressed is the key to bind, two in
#: a row a chord; Enter takes it and Esc leaves it.  Not DOS Navigator's,
#: which had no key editor.
KeyCaptureDialog(Dialog):
    modal_width: 44
    modal_height: 9
    title: "Press a key"
    buttons: "none"

    StaticText:
        id: hint
        y: 2
        height: 2
        anchors:
            left: 2
            right: 2
        text: "Press the key, or two for a chord.\nEnter takes it, Esc cancels."

    KeyCatcher:
        id: catcher
        y: 5
        height: 1
        anchors:
            left: 3
            right: 3
