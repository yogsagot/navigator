from navml.widgets.dialog.field import Field
from navigator.widgets.setup.settings_page import SettingsPage

#: Options > File Manager > Highlight groups: DOS Navigator's ``dlgHighlightGroups``.
#:
#: Its five lines in its rows, each with DN's shared ``hsCustoms`` history,
#: the dialog wider for Navigator's masks.  DN called the lines *Custom 1*
#: to *Custom 5*; Navigator named the five groups (``filetypes.CUSTOM``),
#: and the Colors dialog shows them by these names, so the lines say which
#: is which.
HighlightPage(SettingsPage):
    class help_topic: "settings.md#highlight"
    class section_name: "highlight_groups"

    #: The caption on its tab, which *Settings* gives it.
    property title: ""

    Field:
        id: image
        key: "image"
        y: 2
        anchors:
            left: 2
            right: 2
        label_text: "~I~mages"
        label_width: 18
        history_id: "customs"

    Field:
        id: media
        key: "media"
        y: 4
        anchors:
            left: 2
            right: 2
        label_text: "~A~udio and video"
        label_width: 18
        history_id: "customs"

    Field:
        id: document
        key: "document"
        y: 6
        anchors:
            left: 2
            right: 2
        label_text: "~D~ocuments"
        label_width: 18
        history_id: "customs"

    Field:
        id: source
        key: "source"
        y: 8
        anchors:
            left: 2
            right: 2
        label_text: "~S~ource code"
        label_width: 18
        history_id: "customs"

    Field:
        id: temp
        key: "temp"
        y: 10
        anchors:
            left: 2
            right: 2
        label_text: "~T~emporary files"
        label_width: 18
        history_id: "customs"
