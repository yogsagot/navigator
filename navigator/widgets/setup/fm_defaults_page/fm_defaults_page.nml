from navml.widgets.dialog.check_boxes import CheckBoxes
from navml.widgets.dialog.label import Label
from navml.widgets.dialog.radio_buttons import RadioButtons
from navigator.widgets.manager.manager.manager import sort_radio_captions
from navigator.widgets.setup.settings_page import SettingsPage

#: Options > File Manager > New Manager defaults: DOS Navigator's ``dlgFMDefaults``.
#:
#: The resource whole: *Sort by* in three columns of three (DN's six in
#: two rows, with *Attributes* and *Owner* added), *Display* in two
#: of four, and what the left panel of a new file manager is.  Four columns
#: wider than DN's 48, and four more for the arrows each order's caption ends
#: in; Help is left out, having nothing to show yet.
#: Two captions depart from DN's: *Group* is *Type*, since on POSIX a group
#: is the file's owner group, and the left panel's *Drive* is *Files*.
#: *Panel mode* is not DN's: Ctrl+Y's three modes, for a new panel.
FMDefaultsPage(SettingsPage):
    class section_name: "panel_defaults"

    #: The caption on its tab, which *Settings* gives it.
    property title: ""

    Label:
        id: sort_caption
        x: 2
        y: 1
        width: 12
        text: "Sort by"
        link: sort_by

    #: Not DN's, which had no descending order: a new panel's ``sort_reverse``,
    #: on the caption's row as in *Panel Options*.
    CheckBoxes:
        id: reverse
        key: "sort_reverse"
        y: 1
        width: 22
        height: 1
        anchors:
            right: 2
        items: ["Re~v~erse order"]

    RadioButtons:
        id: sort_by
        key: "sort_by"
        y: 2
        height: 3
        anchors:
            left: 2
            right: 2
        #: Each order's caption ends in the way it runs, following the box.
        items: sort_radio_captions(bool(reverse.value), root.glyphs)

    Label:
        id: display_caption
        x: 2
        y: 6
        width: 12
        text: "Display"
        link: display

    CheckBoxes:
        id: display
        key: "DISPLAY"
        y: 7
        height: 4
        anchors:
            left: 2
            right: 2
        items: ["Director~y~ length", "~C~urrent file", "Se~l~ected files", "T~o~tals", "~F~ree space", "Files ~h~ighlight", "E~x~ecutable first", "~A~rchives first"]

    Label:
        id: left_caption
        x: 2
        y: 12
        width: 40
        text: "Left panel in new Manager will be..."
        link: left_panel

    RadioButtons:
        id: left_panel
        key: "left_panel"
        y: 13
        height: 1
        anchors:
            left: 2
            right: 2
        items: ["File ~p~anel", "~I~nfo", "T~r~ee", "A~b~sent"]

    Label:
        id: mode_caption
        x: 2
        y: 15
        width: 12
        text: "Panel mode"
        link: view_mode

    RadioButtons:
        id: view_mode
        key: "view_mode"
        y: 16
        height: 1
        anchors:
            left: 2
            right: 2
        items: ["Si~m~ple", "~D~etailed", "List"]
