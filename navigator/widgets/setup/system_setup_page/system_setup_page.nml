from navml.widgets.dialog.check_boxes import CheckBoxes
from navml.widgets.dialog.field import Field
from navml.widgets.dialog.label import Label
from navml.widgets.dialog.masked_field import MaskedField
from navml.widgets.dialog.radio_buttons import RadioButtons
from navml.widgets.dialog.static_text import StaticText

#: Options > Configuration > System Setup: DOS Navigator's ``dlgSystemSetup``.
#:
#: The resource's *Options* and *Temporary directory*, less what only meant
#: something on DOS -- *Disable XMS/EMS usage*, *OS-dependent Disk Access*,
#: *Clear read-only from CD*, *"Fast" command execution* (DN's INT 2Fh reload
#: trick), *Advanced copy* (XMS/EMS buffers), the two video modes and the
#: per-drive list -- so it is nine rows shorter.  *Flush disk buffers* is
#: kept as what it means on POSIX: syncing what a copy wrote.  Help is left out, having nothing to show yet.
#: *Use internal terminal* is not DN's but a departure: whether Ctrl+O shows
#: the console in Navigator, or hands the real terminal over as mc does.
#: *Unexpected errors* is another: DN had Turbo Pascal's ``Runtime error``
#: and no choice, where this picks a box with the traceback or quitting
#: with it printed -- never nothing (``SystemData.on_error``).  *Report a
#: stall after* is a third: how long Navigator may stop answering before
#: ``errors.log`` records why (``SystemData.stall_report``).  *Root access*
#: and *Keep root open while idle* are a fourth: what *As root* asks for root
#: with, after a step was refused permission, and for how long it stays open
#: (``SystemData.elevate``, ``root_timeout``; ``navigator.lib.system.elevate``).
#: *Command windows zoomed* and *modal* are a fifth: how a command run in a
#: window of its own opens (``TerminalWindow``), filling the row that was
#: spare under *Options*.
SystemSetupPage:
    #: The caption on its tab, which *Settings* gives it.
    property title: ""

    Label:
        id: options_caption
        x: 3
        y: 1
        width: 12
        height: 1
        text: "~O~ptions"
        link: options

    CheckBoxes:
        id: options
        x: 3
        y: 2
        width: max(0, parent.width - 6)
        height: 4
        items: ["Internal ~e~ditor", "Internal ~v~iewer", "~U~se system clipboard", "~S~how hidden files", "S~y~nc after copying", "Use internal te~r~minal", "Command windows ~z~oomed", "Command windows moda~l~"]

    Label:
        id: temp_caption
        x: 3
        y: 6
        width: 24
        height: 1
        text: "~T~emporary directory"
        link: temp_dir.entry

    Field:
        id: temp_dir
        x: 3
        y: 7
        width: max(0, parent.width - 6)
        height: 1
        label_text: ""
        label_width: 0

    Label:
        id: on_error_caption
        x: 3
        y: 9
        width: 24
        height: 1
        text: "Unexpected ~f~ailures"
        link: on_error

    RadioButtons:
        id: on_error
        x: 3
        y: 10
        width: max(0, parent.width - 6)
        height: 1
        items: ["Show a ~m~essage", "~Q~uit with a traceback"]

    MaskedField:
        id: stall_report
        x: 3
        y: 12
        width: 31
        height: 1
        label_text: "Re~p~ort a stall after"
        label_width: 26
        mask: "999"
        #: PgUp and PgDn are the tabs' in *Settings*.
        page_keys: False

    #: Beside the number where the page is wide enough for the *Root access*
    #: row (tabs on top), under it where it is not (tabs down the left).
    StaticText:
        id: stall_unit
        x: 35 if parent.width >= 67 else 30
        y: 12 if parent.width >= 67 else 13
        width: max(0, parent.width - (38 if parent.width >= 67 else 32))
        height: 1
        text: "seconds (0: never)"

    Label:
        id: elevate_caption
        x: 3
        y: 14 if parent.width >= 67 else 15
        width: 14
        height: 1
        text: "Root a~c~cess"
        link: elevate

    #: Beside its caption on a wide page, on its own row under it on a narrow one.
    RadioButtons:
        id: elevate
        x: 17 if parent.width >= 67 else 3
        y: 14 if parent.width >= 67 else 16
        width: max(0, parent.width - (20 if parent.width >= 67 else 6))
        height: 1
        items: ["~A~uto", "su~d~o", "pke~x~ec", "~N~ever offer"]

    MaskedField:
        id: root_timeout
        x: 3
        y: 16 if parent.width >= 67 else 17
        width: 31
        height: 1
        label_text: "Keep root open ~w~hile idle"
        label_width: 26
        mask: "999"
        page_keys: False

    StaticText:
        id: root_timeout_unit
        x: 35 if parent.width >= 67 else 30
        y: 16 if parent.width >= 67 else 18
        width: max(0, parent.width - (38 if parent.width >= 67 else 32))
        height: 1
        text: "minutes (0: each time)"
