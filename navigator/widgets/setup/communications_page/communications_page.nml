from navml.widgets.dialog.field import Field
from navml.widgets.dialog.label import Label
from navml.widgets.dialog.masked_field import MaskedField
from navml.widgets.dialog.radio_buttons import RadioButtons
from navml.widgets.dialog.static_text import StaticText
from navigator.widgets.setup.settings_page import SettingsPage

#: Options > Configuration > *Communications*: where DOS Navigator set up the
#: modem and the cable its Navigator Link ran over (``cmSetupModem``) --
#: here, connections to servers (``[remote]``, ``RemoteData``).  Nothing of
#: DN's resource is left: a port, a speed and an init string have no meaning
#: for SSH.  *Desktop integration* is not DN's: whose plumbing -- GIO's or
#: KDE's KIO -- mounts volumes, reaches GVfs/KIO links and opens files in the
#: desktop's applications (``[system] desktop_vfs``,
#: ``navigator.lib.system.desktop``); here, System Setup having no room left.
#: *Notify when a long operation ends* is not DN's either: a desktop
#: notification once the terminal is in the background (``[system]
#: notifications``, ``Shell.notify_away``).
CommunicationsPage(SettingsPage):
    class section_name: "remote"

    #: The caption on its tab, which *Settings* gives it.
    property title: ""

    MaskedField:
        id: keepalive
        key: "keepalive"
        x: 3
        y: 1
        width: 33
        label_text: "~K~eep-alive every"
        label_width: 28
        mask: "999"
        page_keys: False

    StaticText:
        id: keepalive_unit
        y: 1
        anchors:
            left: 37
            right: 3
        text: "seconds (0: never)"

    MaskedField:
        id: timeout
        key: "timeout"
        x: 3
        y: 2
        width: 33
        label_text: "Connecting ~w~aits"
        label_width: 28
        mask: "999"
        page_keys: False

    StaticText:
        id: timeout_unit
        y: 2
        anchors:
            left: 37
            right: 3
        text: "seconds"

    MaskedField:
        id: idle_disconnect
        key: "idle_disconnect"
        x: 3
        y: 3
        width: 33
        label_text: "~C~lose an idle connection"
        label_width: 28
        mask: "999"
        page_keys: False

    StaticText:
        id: idle_unit
        y: 3
        anchors:
            left: 37
            right: 3
        text: "minutes (0: never)"

    MaskedField:
        id: refresh
        key: "refresh"
        x: 3
        y: 4
        width: 33
        label_text: "~L~ook for changes every"
        label_width: 28
        mask: "999"
        page_keys: False

    StaticText:
        id: refresh_unit
        y: 4
        anchors:
            left: 37
            right: 3
        text: "seconds (0: never)"

    Label:
        id: upload_caption
        x: 3
        y: 6
        width: 50
        text: "A fetched file a program changed goes ~b~ack"
        link: upload_changed

    RadioButtons:
        id: upload_changed
        key: "upload_changed"
        y: 7
        height: 1
        anchors:
            left: 3
            right: 3
        items: ["~A~sk first", "Alwa~y~s", "Ne~v~er"]

    Label:
        id: desktop_vfs_caption
        y: 9
        anchors:
            left: 3
            right: 3
        text: "~D~esktop integration: volumes, links, opening files"
        link: desktop_vfs

    #: Two rows, two columns: one row is wider than the page with the tabs down the left.
    RadioButtons:
        id: desktop_vfs
        key: "system.desktop_vfs"
        y: 10
        height: 2
        anchors:
            left: 3
            right: 3
        items: ["Au~t~o", "~G~IO (GNOME, Xfce...)", "K~I~O (KDE)", "~O~ff"]

    #: Not DN's: what every Remote shell's ``ssh`` gets (``[remote] ssh_options``).
    Field:
        id: ssh_options
        key: "ssh_options"
        y: 13
        anchors:
            left: 3
            right: 3
        label_text: "Remote shell's ss~h~ options"
        label_width: 28

    #: Not DN's: ``[system] notifications``.  Right under *ssh options*:
    #: the page's last two rows are all a box with the tabs on top shows.
    Label:
        id: notifications_caption
        y: 14
        anchors:
            left: 3
            right: 3
        text: "~N~otify when a long operation ends unwatched"
        link: notifications

    RadioButtons:
        id: notifications
        key: "system.notifications"
        y: 15
        height: 2
        anchors:
            left: 3
            right: 3
        items: ["A~u~to", "Te~r~minal (OSC 9/777)", "notify-~s~end", "O~f~f"]
