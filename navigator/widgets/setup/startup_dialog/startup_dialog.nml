from navml.widgets.dialog.check_boxes import CheckBoxes
from navml.widgets.dialog.dialog import Dialog
from navml.widgets.dialog.label import Label

#: Options > Configuration > Startup: DOS Navigator's ``dlgStartupSetup``.
#:
#: The resource's groups, less what only meant something on DOS --
#: *Restore screen mode*, the two overlay boxes, *Force* and *Restore VGA
#: palette*, *Enable blinking* (VGA attribute bit 7), and the whole
#: *Timeslicing* group (*Sleep when inactive*, *DOS Idle (Int28)*): an event
#: loop already sleeps while nothing happens.
StartupDialog(Dialog):
    modal_width: 60
    modal_height: 12
    title: "Startup"

    Label:
        id: startup_caption
        x: 2
        y: 1
        width: 20
        height: 1
        text: "Startup options"
        link: startup

    CheckBoxes:
        id: startup
        x: 2
        y: 2
        width: max(0, parent.width - 4)
        height: 1
        items: ["Auto run ~U~ser Menu", "Clear ~H~istory"]

    Label:
        id: shutdown_caption
        x: 2
        y: 4
        width: 20
        height: 1
        text: "Shutdown options"
        link: shutdown

    CheckBoxes:
        id: shutdown
        x: 2
        y: 5
        width: max(0, parent.width - 4)
        height: 2
        items: ["~I~nactivity hour exit", "Autosave ~D~esktop", "~P~reserve directory"]
