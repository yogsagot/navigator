from navml.widgets.dialog.check_boxes import CheckBoxes
from navml.widgets.dialog.field import Field
from navml.widgets.dialog.label import Label
from navml.widgets.dialog.radio_buttons import RadioButtons
from navigator.widgets.setup.settings_page import SettingsPage

#: Options > File Manager > Setup: DOS Navigator's ``dlgFMSetup``.
#:
#: The resource's *Behavior* down the left and *Display* and the tag sign down
#: the right, less what only meant something on DOS: *Alt difference* and
#: *Ctrl difference*, the *Quick search* key (Single Alt, Single Ctrl,
#: Caps+Char -- a terminal reports none of them alone, and Ctrl+S is the key),
#: the *Drive line*, and ``descript.ion`` descriptions (*Do not kill
#: descriptions*, *Files with descriptions*).  DN's caption *Use ~/~→ keys*
#: had lost its left arrow; it is *Use ←/→ keys* here.  Three columns wider
#: than DN's 57.  *Auto refresh
#: panels* is not DN's (``[file_manager] auto_refresh``), nor is *Right
#: button* (``[file_manager] right_button``): DN's always selected, nor *Link
#: target line* (``[file_manager] link_line``): DN had no symlinks, nor *Option
#: flags* (``[file_manager] show_options``): the panels' strips on their bottom
#: frames, nor *Git status* (``[file_manager] git_status``): DN knew no git,
#: nor *Miller column width* (``[file_manager] miller_width``): DN had no
#: Miller columns (Alt+F12), nor *F8 moves to Trash* (``[file_manager]
#: use_trash``): DN erased for good (``navigator/lib/file_ops/trash.py``), nor
#: *Pass other files to desktop* (``[file_manager] open_unassociated``): Enter
#: on a file DN.EXT had nothing for did nothing (``gio open``), nor *ENTER
#: mounts disc images* (``[file_manager] enter_mounts_images``): DOS had no
#: loop devices (``udisksctl loop-setup``), nor *Return to last cursor
#: position* and *Remember directory settings* (``[file_manager]
#: restore_cursor``, ``remember_directories``): DN remembered nothing per
#: directory (``navigator/lib/config/directory_settings.py``).
FMSetupPage(SettingsPage):
    class help_topic: "settings.md#file-panels"
    class section_name: "file_manager"

    #: The caption on its tab, which *Settings* gives it.
    property title: ""

    Label:
        id: behavior_caption
        x: 2
        y: 1
        width: 12
        text: "Behavior"
        link: behavior

    CheckBoxes:
        id: behavior
        key: "BEHAVIOR"
        x: 2
        y: 2
        width: 33
        height: 13
        items: ["Auto c~h~ange directory", "Drag~-~and~-~drop from columns", "~B~eep after copy", "~E~NTER opens archive", "ENTER mounts dis~c~ images", "~S~PACE toggles selection", "~D~EL erases file(s)", "Use ←/→ ~k~eys", "BS - go to ~u~pper directory", "Auto ~r~efresh panels", "F8 m~o~ves to Trash", "~P~ass other files to desktop", "Return to last cursor position"]

    Field:
        id: miller_width
        x: 2
        y: 16
        width: 31
        label_text: "Miller column ~w~idth:"
        label_width: 25

    Label:
        id: display_caption
        x: 37
        y: 1
        width: 12
        text: "Display"
        link: display

    CheckBoxes:
        id: display
        key: "DISPLAY"
        y: 2
        height: 6
        anchors:
            left: 37
            right: 2
        items: ["Colu~m~n titles", "~I~nfo divider", "~T~ag character", "Li~n~k target line", "Option ~f~lags", "Git st~a~tus"]

    Field:
        id: tag_sign
        x: 37
        y: 8
        width: 16
        label_text: "Ta~g~ sign:"
        label_width: 12

    Label:
        id: right_button_caption
        x: 37
        y: 10
        width: 14
        text: "Right button"
        link: right_button

    RadioButtons:
        id: right_button
        key: "right_button"
        y: 11
        height: 2
        anchors:
            left: 37
            right: 2
        items: ["Conte~x~t menu", "Se~l~ect files"]

    Label:
        id: remember_caption
        y: 13
        anchors:
            left: 37
            right: 2
        text: "Remember directory settings"
        link: remember_directories

    RadioButtons:
        id: remember_directories
        key: "remember_directories"
        y: 14
        height: 3
        anchors:
            left: 37
            right: 2
        items: ["Off", "Marked directories", "Every directory"]
        tooltips: ["Every directory is shown with the panel's own sort order, view and file mask", "Those Panel > Remember for this directory marks keep their own", "Any directory a setting is changed in keeps its own"]

