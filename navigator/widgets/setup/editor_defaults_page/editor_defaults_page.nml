from navml.widgets.dialog.check_boxes import CheckBoxes
from navml.widgets.dialog.choice_field import ChoiceField
from navml.widgets.dialog.label import Label
from navml.widgets.dialog.masked_field import MaskedField
from navml.widgets.dialog.radio_buttons import RadioButtons

#: Options > Configuration > Editor/Viewer: DOS Navigator's ``dlgEditorDefaults``.
#:
#: The resource's two clusters, four numbers and the line divisor, less *Use
#: EMS memory* and *Use XMS memory*.  The numbers are three-digit masked lines
#: rather than DN's free input lines, so nothing but a number goes in.  Four
#: columns wider than DN's 52; Help is left out, having nothing to show yet.
#: The line divisor lists LF first, a departure from DN's CR+LF, CR, LF:
#: POSIX's own ending leads.  *Option strip* in each cluster is a departure
#: too, the strip being one (``OptionStrip``), and so is *Fallback encoding*,
#: what a file that is not UTF-8 is read as (``[editor] fallback_encoding``).
#: So is *Tab key inserts tabs* (``[editor] insert_tabs``; DN's Tab wrote
#: blanks): the editor cluster is a row taller for it, all below a row down.
#: *Line numbers* (``[editor] line_numbers``; DN numbered no lines) fills
#: the cluster's last place, with no hot key: the page has no letter of it left.
EditorDefaultsPage:
    #: The caption on its tab, which *Settings* gives it.
    property title: ""

    Label:
        id: editor_caption
        x: 2
        y: 1
        width: 16
        text: "Editor options"
        link: editor

    CheckBoxes:
        id: editor
        y: 2
        height: 8
        anchors:
            left: 2
            right: 2
        items: ["~C~reate backup files", "~B~ackspace unindents", "Au~t~oBrackets", "~A~uto indent", "A~u~towrap", "~J~ustify on wrap", "~V~ertical blocks", "Opti~m~al fill", "~H~ighlight line", "H~i~ghlight column", "~P~ersistent blocks", "~O~verwrite blocks", "Lock ~f~ile", "Tab ~k~ey inserts tabs", "Line numbers", "Option ~s~trip"]

    Label:
        id: viewer_caption
        x: 2
        y: 11
        width: 16
        text: "Viewer options"
        link: viewer

    CheckBoxes:
        id: viewer
        x: 2
        y: 12
        width: 20
        height: 3
        items: ["He~x~ mode", "~W~rap lines", "Optio~n~ strip"]

    MaskedField:
        id: left_margin
        x: 30
        y: 11
        width: 20
        label_text: "~L~eft margin"
        label_width: 15
        mask: "999"
        #: PgUp and PgDn are the tabs' in *Settings*.
        page_keys: False

    MaskedField:
        id: right_margin
        x: 30
        y: 12
        width: 20
        label_text: "~R~ight margin"
        label_width: 15
        mask: "999"
        #: PgUp and PgDn are the tabs' in *Settings*.
        page_keys: False

    MaskedField:
        id: paragraph
        x: 30
        y: 13
        width: 20
        label_text: "Para~g~raph"
        label_width: 15
        mask: "999"
        #: PgUp and PgDn are the tabs' in *Settings*.
        page_keys: False

    MaskedField:
        id: tab_size
        x: 30
        y: 15
        width: 20
        label_text: "Tab si~z~e"
        label_width: 15
        mask: "999"
        #: PgUp and PgDn are the tabs' in *Settings*.
        page_keys: False

    Label:
        id: divisor_caption
        x: 2
        y: 15
        width: 24
        text: "Line ~d~ivisor (editor)"
        link: line_divisor

    RadioButtons:
        id: line_divisor
        x: 2
        y: 16
        width: 26
        height: 1
        items: ["LF", "CR+LF", "CR"]

    ChoiceField:
        id: fallback_encoding
        y: 16
        anchors:
            left: 30
            right: 2
        label_text: "Fallback ~e~ncoding"
        label_width: 17
