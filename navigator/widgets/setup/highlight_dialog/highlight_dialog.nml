from navml.widgets.dialog.dialog import Dialog
from navml.widgets.dialog.field import Field

#: Options > File Manager > Highlight groups: DOS Navigator's ``dlgHighlightGroups``.
#:
#: Its five lines in its rows, each with DN's shared ``hsCustoms`` history,
#: the dialog wider for Navigator's masks.  DN called the lines *Custom 1*
#: to *Custom 5*; Navigator named the five groups (``filetypes.CUSTOM``),
#: and the Colors dialog shows them by these names, so the lines say which
#: is which.  Help is left out, having nothing to show yet.
HighlightDialog(Dialog):
    modal_width: 66
    modal_height: 16
    title: "Highlight groups"

    Field:
        id: image
        x: 2
        y: 2
        width: max(0, parent.width - 4)
        height: 1
        label_text: "~I~mages"
        label_width: 18
        history_id: "customs"

    Field:
        id: media
        x: 2
        y: 4
        width: max(0, parent.width - 4)
        height: 1
        label_text: "~A~udio and video"
        label_width: 18
        history_id: "customs"

    Field:
        id: document
        x: 2
        y: 6
        width: max(0, parent.width - 4)
        height: 1
        label_text: "~D~ocuments"
        label_width: 18
        history_id: "customs"

    Field:
        id: source
        x: 2
        y: 8
        width: max(0, parent.width - 4)
        height: 1
        label_text: "~S~ource code"
        label_width: 18
        history_id: "customs"

    Field:
        id: temp
        x: 2
        y: 10
        width: max(0, parent.width - 4)
        height: 1
        label_text: "~T~emporary files"
        label_width: 18
        history_id: "customs"
