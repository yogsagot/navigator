from navml.widgets.dialog.check_boxes import CheckBoxes
from navml.widgets.dialog.choice_field import ChoiceField
from navml.widgets.dialog.label import Label
from navml.widgets.dialog.masked_field import MaskedField
from navml.widgets.dialog.radio_buttons import RadioButtons

#: Options > Configuration > Interface: DOS Navigator's ``dlgInterfaceSetup``.
#:
#: The resource's twelve boxes in its two columns of six, at its width; Help
#: is left out, having nothing to show yet.  *History size* below them is a
#: departure: DN's lists were a fixed 20 long, and *Tooltip delay* beside it
#: (DN had no tooltips); so is *Language*, DN's being
#: the resource set it was installed with, *Colours*, ``[appearance]``'s
#: depth, where DN's was the video mode a DOS adapter was put in, *Glyphs*
#: and *Marks*.
InterfacePage:
    #: The caption on its tab, which *Settings* gives it.
    property title: ""

    CheckBoxes:
        id: options
        x: 2
        y: 1
        width: max(0, parent.width - 4)
        height: 6
        items: ["~C~lock", "Hide ~m~enu bar", "Hide ~s~tatus line", "ESC for ~u~ser screen", "Hide Command ~L~ine", "~A~uto hide Command Line", "~B~lock Insert Cursor", "Store edi~t~or position", "Store vie~w~er position", "Track ~e~diting history", "Track ~v~iewing history", "Track ~d~irectories"]

    MaskedField:
        id: history_size
        x: 2
        y: 8
        width: 20
        height: 1
        label_text: "~H~istory size"
        label_width: 15
        mask: "999"
        #: PgUp and PgDn are the tabs' in *Settings*.
        page_keys: False

    #: Milliseconds, ``[interface] tooltip_delay``; nought for none.  No hot key:
    #: every letter of its caption is taken on this page.
    MaskedField:
        id: tooltip_delay
        x: 26
        y: 8
        width: 26
        height: 1
        label_text: "Tooltip delay (ms)"
        label_width: 20
        mask: "9999"
        page_keys: False

    #: Chosen from the catalogues found, never typed.  At the Nerd tier each
    #: name has its catalogue's ``[meta] flag`` in front, a departure like the
    #: panel's icon gutter (``InterfacePage._flag_languages``).
    ChoiceField:
        id: language
        x: 2
        y: 10
        width: 40
        height: 1
        label_text: "La~n~guage"
        label_width: 15

    #: Not DN's: how many colours the terminal is sent, at once.  Above
    #: *Settings tabs*, so its list drops whole inside the box.
    ChoiceField:
        id: colors
        x: 2
        y: 11
        width: 40
        height: 1
        label_text: "Colou~r~s"
        label_width: 15

    #: Not DN's, which drew CP437 alone: which characters the terminal's font
    #: draws, ``[appearance] glyphs``, applied at once.
    ChoiceField:
        id: glyphs_tier
        x: 2
        y: 12
        width: 40
        height: 1
        label_text: "Gl~y~phs"
        label_width: 15

    #: Not DN's, whose marks were Turbo Vision's alone: how check boxes and
    #: radio buttons are drawn, ``[appearance] marks``.  Above *Settings
    #: tabs*, as *Colours* is, so its list drops whole inside the box.
    ChoiceField:
        id: marks
        x: 2
        y: 13
        width: 40
        height: 1
        label_text: "Mar~k~s"
        label_width: 15

    #: Not DN's, which mirrored nothing: which way the screen reads,
    #: ``[interface] direction``, applied at once.
    ChoiceField:
        id: direction
        x: 2
        y: 14
        width: 40
        height: 1
        label_text: "Te~x~t direction"
        label_width: 15

    #: Not DN's: where *Settings* -- this box -- shows its tabs, the next
    #: time it opens.
    Label:
        id: settings_tabs_caption
        x: 2
        y: 15
        width: 15
        height: 1
        text: "Settin~g~s tabs"
        link: settings_tabs

    RadioButtons:
        id: settings_tabs
        x: 17
        y: 15
        width: 50
        height: 1
        items: ["~O~n top", "On the le~f~t", "Sim~p~le"]

    #: Not DN's: the windows on the menu bar, by number or with titles too.
    Label:
        id: window_strip_caption
        x: 2
        y: 16
        width: 15
        height: 1
        text: "W~i~ndow strip"
        link: window_strip

    RadioButtons:
        id: window_strip
        x: 17
        y: 16
        width: 50
        height: 1
        items: ["Off", "Numbers", "With titles"]
