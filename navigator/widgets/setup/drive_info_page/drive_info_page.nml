from navml.widgets.dialog.check_boxes import CheckBoxes
from navml.widgets.dialog.label import Label
from navigator.widgets.setup.settings_page import SettingsPage

#: Options > File Manager > Information panel: DOS Navigator's ``dlgDriveInfoSetup``.
#:
#: Its boxes in its order, less *EMS* and *XMS Information*, which only
#: meant something on DOS; *Conventional Memory* is the machine's.  *File
#: under the cursor* and *Media information* are Navigator's own.  Help is
#: left out, having nothing to show yet.
DriveInfoPage(SettingsPage):
    class section_name: "drive_info"

    #: The caption on its tab, which *Settings* gives it.
    property title: ""

    Label:
        id: items_caption
        x: 2
        y: 1
        width: 20
        text: "Items to display"
        link: options

    CheckBoxes:
        id: options
        key: "OPTIONS"
        y: 2
        height: 11
        anchors:
            left: 2
            right: 2
        items: ["~D~irectory Title", "~T~otals", "File under the ~c~ursor", "Med~a~ information", "Volume ~S~ize", "Volume ~F~ree space", "Volume ~L~abel", "Total ~m~emory", "M~e~mory for user", "Memory for ~N~avigator", "~I~nformation file"]
