from navigator.widgets.drives.commands import DeleteLinkEntry, NewLinkEntry, ReadLiveLinks, SaveLinkEntry
from navml.widgets.dialog.button import Button
from navml.widgets.dialog.check_boxes import CheckBoxes
from navml.widgets.dialog.dialog import Dialog
from navml.widgets.dialog.field import Field
from navml.widgets.dialog.label import Label
from navigator.widgets.drives.link_manager.saved_list import SavedList
from navml.widgets.dialog.static_text import StaticText

#: Utilities > *SSH link (SFTP)* (Alt+F11, DN's ``cmNavyLink``), *FTP link*,
#: *SMB link*, *S3 link*, *GVfs/KIO link* and *Remote shell* (DN's
#: ``cmTerminal``): one protocol's kept connections down the left, and the one
#: to connect to on the right -- a connection manager after FileZilla's Site
#: Manager, asked for, one a protocol (``LinkManagerDialog.family``).  A
#: departure: DN's link was one cable, with nothing to keep or choose.
#:
#: It opens with the lines empty, a one-off connection kept by nothing;
#: choosing one in the list -- the cursor moved, a row clicked, Space -- makes
#: the lines that connection, kept by *Save* once changed (the row says ``*``,
#: and leaving it asks); a double click connects to it.  *New* makes one at
#: once, under a placeholder name ready to be typed over (or from the one-off
#: lines), and *Delete* takes one away.  Every line remembers what it held when
#: *Connect*, *Save* or *New* was pressed, under its protocol's history ids,
#: dropped by its ``▐↓▌`` or Down.  *Connect* sends the panel there, or opens
#: ``ssh`` in a command window (Remote shell).
#:
#: The lines are ``ConnectDialog``'s, under the same ids; the protocol's
#: captions and TLS box are put in by the hand-written half.  GVfs/KIO places
#: have no host-and-login form: their box shows *Name* and *URI* alone.
LinkManagerDialog(Dialog):
    modal_width: 76
    modal_height: 20
    #: The protocol's, always: ``LinkManagerDialog`` puts it in.
    title: "SSH link (SFTP)"

    keys:
        insert: NewLinkEntry
        f2: SaveLinkEntry
        delete: DeleteLinkEntry
        ctrl+r: ReadLiveLinks

    Label:
        id: links_caption
        x: 2
        y: 1
        width: 20
        height: 1
        text: "~S~aved"
        link: links

    SavedList:
        id: links
        x: 2
        y: 2
        width: 24
        height: 13

    Field:
        id: label
        x: 28
        y: 2
        width: max(0, parent.width - 30)
        height: 1
        label_text: "~N~ame"
        label_width: 12
        history_id: "ssh_name"

    #: GVfs/KIO's one line, in place of Host, Login, Port and Directory.
    Field:
        id: uri
        x: 28
        y: 4
        width: max(0, parent.width - 30)
        height: 1
        label_text: "~U~RI"
        label_width: 12
        history_id: "gvfs_uri"
        visible: False

    Field:
        id: host
        x: 28
        y: 4
        width: max(0, parent.width - 30)
        height: 1
        label_text: "~H~ost"
        label_width: 12
        #: The hosts typed, as every line here remembers its own: not
        #: ``ConnectDialog``'s whole connections, which the list on the left is.
        history_id: "ssh_host"

    Field:
        id: user
        x: 28
        y: 6
        width: max(0, parent.width - 30)
        height: 1
        label_text: "~L~ogin"
        label_width: 12
        history_id: "ssh_login"

    Field:
        id: port
        x: 28
        y: 8
        width: 24
        height: 1
        label_text: "P~o~rt"
        label_width: 12
        history_id: "ssh_port"

    Field:
        id: directory
        x: 28
        y: 10
        width: max(0, parent.width - 30)
        height: 1
        label_text: "~D~irectory"
        label_width: 12
        history_id: "ssh_directory"

    #: SSH's: words added to Remote shell's ``ssh`` -- ``-A -J jump`` -- after
    #: ``[remote] ssh_options``.  Not SSH link's panel: paramiko reads
    #: ``~/.ssh/config``, and no flags.
    Field:
        id: options
        x: 28
        y: 12
        width: max(0, parent.width - 30)
        height: 1
        label_text: "ssh opt~i~ons"
        label_width: 12
        history_id: "ssh_options"
        visible: False

    #: FTP's and S3's: the connection under TLS -- ``ftps://``, ``s3://``.
    CheckBoxes:
        id: secure
        x: 29
        y: 12
        width: max(0, parent.width - 32)
        height: 1
        items: ["Encr~y~pt with TLS"]
        visible: False

    #: Why a connection cannot be made, the state (one-off, changed), or
    #: what a button just did.
    StaticText:
        id: missing
        x: 28
        y: 13
        width: max(0, parent.width - 30)
        height: 2
        text: ""
        wrap: True

    Button:
        id: create
        text: "Ne~w~"
        x: 2
        y: 16
        width: 13
        height: 2

    Button:
        id: save
        text: "Sav~e~"
        x: 16
        y: 16
        width: 12
        height: 2

    Button:
        id: delete
        text: "Dele~t~e"
        x: 29
        y: 16
        width: 12
        height: 2

    Button:
        id: connect
        text: "~C~onnect"
        default: True
        x: 47
        y: 16
        width: 13
        height: 2

    Button:
        id: abandon
        text: "Cancel"
        x: 61
        y: 16
        width: 12
        height: 2
