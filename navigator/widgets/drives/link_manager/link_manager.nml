from navigator.widgets.drives.commands import DeleteLinkEntry, NewLinkEntry, ReadLiveLinks, SaveLinkEntry
from navml.widgets.dialog.button import Button
from navml.widgets.dialog.button_row import ButtonRow
from navml.widgets.dialog.check_boxes import CheckBoxes
from navml.widgets.dialog.dialog import Dialog
from navml.widgets.dialog.field import Field
from navml.widgets.dialog.label import Label
from navigator.widgets.drives.link_manager.saved_list import SavedList
from navml.widgets.dialog.static_text import StaticText

#: Utilities > *SSH link (SFTP)* (Alt+F11, DN's ``cmNavyLink``), *FTP link*,
#: *SMB link*, *S3 link*, *GVfs/KIO link* and *Remote shell* (DN's
#: ``cmTerminal``): one protocol's kept connections down the left, and the one
#: to connect to on the right -- a connection manager after FileZilla's Site
#: Manager, asked for, one a protocol (``LinkManagerDialog.family``).  A
#: departure: DN's link was one cable, with nothing to keep or choose.
#:
#: It opens with the lines empty, a one-off connection kept by nothing;
#: choosing one in the list -- the cursor moved, a row clicked, Space -- makes
#: the lines that connection, kept by *Save* once changed (the row says ``*``,
#: and leaving it asks); a double click connects to it.  *New* makes one at
#: once, under a placeholder name ready to be typed over (or from the one-off
#: lines), and *Delete* takes one away.  Every line remembers what it held when
#: *Connect*, *Save* or *New* was pressed, under its protocol's history ids,
#: dropped by its ``▐↓▌`` or Down.  *Connect* sends the panel there, or opens
#: ``ssh`` in a command window (Remote shell).
#:
#: The lines are ``ConnectDialog``'s, under the same ids; the protocol's
#: captions and TLS box are put in by the hand-written half.  GVfs/KIO places
#: have no host-and-login form: their box shows *Name* and *URI* alone.
LinkManagerDialog(Dialog):
    modal_width: 76
    modal_height: 20
    #: The protocol's, always: ``LinkManagerDialog`` puts it in.
    title: "SSH link (SFTP)"
    buttons: "none"

    keys:
        insert: NewLinkEntry
        f2: SaveLinkEntry
        delete: DeleteLinkEntry
        ctrl+r: ReadLiveLinks

    #: The commands this component handles itself.
    commands:
        NewLinkEntry: root.spawn(root.new_link())
        SaveLinkEntry: root.spawn(root.save_link())
        DeleteLinkEntry: root.spawn(root.delete_link())

    #: The list shows its cursor only while it has the keyboard, so with
    #: nothing chosen the keyboard starts on the top line, Name: no row
    #: looks chosen while the lines are a one-off.  A chosen one starts on
    #: the list, on it.
    first_focus: links if root.chosen is not None else label.entry

    Label:
        id: links_caption
        x: 2
        y: 1
        width: 20
        text: "~S~aved"
        link: links

    SavedList:
        id: links
        x: 2
        y: 2
        width: 24
        height: 13

    Field:
        id: label
        y: 2
        anchors:
            left: 28
            right: 2
        label_text: "~N~ame"
        label_width: 12
        history_id: "ssh_name"

    #: GVfs/KIO's one line, in place of Host, Login, Port and Directory.
    Field:
        id: uri
        y: 4
        anchors:
            left: 28
            right: 2
        label_text: "~U~RI"
        label_width: 12
        history_id: "gvfs_uri"
        visible: False

    Field:
        id: host
        y: 4
        anchors:
            left: 28
            right: 2
        label_text: "~H~ost"
        label_width: 12
        #: The hosts typed, as every line here remembers its own: not
        #: ``ConnectDialog``'s whole connections, which the list on the left is.
        history_id: "ssh_host"

    Field:
        id: user
        y: 6
        anchors:
            left: 28
            right: 2
        label_text: "~L~ogin"
        label_width: 12
        history_id: "ssh_login"

    Field:
        id: port
        x: 28
        y: 8
        width: 24
        label_text: "P~o~rt"
        label_width: 12
        history_id: "ssh_port"

    Field:
        id: directory
        y: 10
        anchors:
            left: 28
            right: 2
        label_text: "~D~irectory"
        label_width: 12
        history_id: "ssh_directory"

    #: SSH's: words added to Remote shell's ``ssh`` -- ``-A -J jump`` -- after
    #: ``[remote] ssh_options``.  Not SSH link's panel: paramiko reads
    #: ``~/.ssh/config``, and no flags.
    Field:
        id: options
        y: 12
        anchors:
            left: 28
            right: 2
        label_text: "ssh opt~i~ons"
        label_width: 12
        history_id: "ssh_options"
        visible: False

    #: SSH's: the connection's port forwards (``-L``/``-R``/``-D``), edited in
    #: ``ForwardsDialog``; opened with the panel's connection and passed to
    #: Remote shell's ``ssh``.  Its caption counts them.
    Button:
        id: forwards_button
        text: "~F~orwards..."
        x: 28
        y: 13
        width: 19
        height: 2
        visible: False
        on_click: root.spawn(root.edit_forwards())

    #: SSH's: ``ssh-copy-id`` -- a public key put on the server, so the next
    #: connection asks no password.
    Button:
        id: copy_key
        text: "Copy ~k~ey..."
        x: 48
        y: 13
        width: 16
        height: 2
        visible: False
        on_click: root.spawn(root.copy_key_to_server())

    #: rclone's: ``rclone config`` in a window, which sets remotes up.
    Button:
        id: configure
        text: "Confi~g~ure..."
        x: 28
        y: 13
        width: 19
        height: 2
        visible: False
        on_click: root.spawn(root.configure_remotes())

    #: FTP's and S3's: the connection under TLS -- ``ftps://``, ``s3://``.
    CheckBoxes:
        id: secure
        y: 12
        height: 1
        anchors:
            left: 29
            right: 3
        items: ["Encr~y~pt with TLS"]
        visible: False

    #: Why a connection cannot be made, the state (one-off, changed), or
    #: what a button just did.
    StaticText:
        id: missing
        y: 13
        height: 2
        anchors:
            left: 28
            right: 2
        text: ""
        wrap: True

    Button:
        id: create
        text: "Ne~w~"
        x: 2
        y: 16
        width: 13
        height: 2
        on_click: root.spawn(root.new_link())

    ButtonRow:
        justify: "start"
        button_width: 12
        spacing: 1
        y: 16
        anchors:
            left: 16
            right: 0

        Button:
            id: save
            text: "Sav~e~"
            on_click: root.spawn(root.save_link())

        Button:
            id: delete
            text: "Dele~t~e"
            on_click: root.spawn(root.delete_link())

    Button:
        id: connect
        text: "~C~onnect"
        default: True
        x: 47
        y: 16
        width: 13
        height: 2
        on_click: root.spawn(root.connect_to())

    Button:
        id: abandon
        text: "Cancel"
        x: 61
        y: 16
        width: 12
        height: 2
        on_click: root.spawn(root._cancel())
