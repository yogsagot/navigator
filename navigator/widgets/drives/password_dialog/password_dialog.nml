from navml.widgets.dialog.check_boxes import CheckBoxes
from navml.widgets.dialog.dialog import Dialog
from navml.widgets.dialog.field import Field

#: A server's password, or a private key's passphrase, asked when a
#: connection needs one (``navigator/lib/drives/sessions.py``).
#:
#: Not DN's: its Navigator Link needed no password across a cable.  The
#: shape of F7's ``InputBox``, with the line masked and one box under it.
PasswordDialog(Dialog):
    modal_width: 58
    modal_height: 10
    title: "Password"

    Field:
        id: entry
        x: 2
        y: 3
        width: max(0, parent.width - 4)
        height: 1
        label_text: "~P~assword"
        label_width: 13

    #: Shown only where a keyring is there to keep it in.
    CheckBoxes:
        id: keep
        x: 3
        y: 5
        width: max(0, parent.width - 6)
        height: 1
        items: ["~S~ave in keyring"]
        tooltips: ["Remember the password in the desktop's keyring, so it is not asked again"]
