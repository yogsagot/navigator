from navigator.widgets.file_ops.commands import ChooseTarget
from navml.widgets.dialog.button import Button
from navml.widgets.dialog.button_row import ButtonRow
from navml.widgets.dialog.check_boxes import CheckBoxes
from navml.widgets.dialog.dialog import Dialog
from navml.widgets.dialog.field import Field
from navml.widgets.dialog.label import Label
from navml.widgets.dialog.radio_buttons import RadioButtons
from navigator.widgets.file_ops.copy_dialog.copy_dialog import choose_target_line

#: Shift+F5: where links to the selected entries are made.
#:
#: A departure with no resource behind it, so it is the Copy dialog cut down:
#: the prompt and the line in the same rows, the kind of link and one check
#: box where the copy modes stood, and the same OK / Cancel / Tree / Help
#: along the bottom.
LinkDialog(Dialog):
    modal_width: 61
    modal_height: 11
    title: "Create link"
    buttons: "none"

    #: F10 opens the tree, as it does in the Copy dialog.
    keys:
        f10: ChooseTarget

    #: The commands this component handles itself.
    commands:
        ChooseTarget: root.spawn(choose_target_line(root, root._here, root._hidden))

    buttons_row: (pick, abandon, tree, help)

    #: ``Create symlink to file NAME in`` (or ``hard link``): the hand-written
    #: half's, as Copy's is.
    Label:
        id: prompt_caption
        y: 1
        anchors:
            left: 2
            right: 2
        link: target.entry

    Field:
        id: target
        y: 2
        anchors:
            left: 2
            right: 2
        label_text: ""
        label_width: 0
        history_id: "link"

    #: A symbolic link, or a hard one: a second name for the file.
    RadioButtons:
        id: kind
        x: 3
        y: 4
        width: 24
        height: 2
        items: ["S~y~mbolic link", "~H~ard link"]
        tooltips: ["A small file holding the path of the original", "A second name for the same file, on the same file system; never for a directory"]

    #: Bit 1: point at the source relative to the link's directory.  Greyed
    #: for a hard link, which holds no path.
    CheckBoxes:
        id: options
        y: 4
        height: 1
        anchors:
            left: 29
            right: 3
        items: ["~R~elative link"]
        tooltips: ["Point the link at a path relative to it, so the two can be moved together"]

    ButtonRow:
        anchors:
            left: 0
            right: 0
            bottom: 2

        Button:
            id: pick
            text: "O~K~"
            default: True

        Button:
            id: abandon
            text: "Cancel"

        Button:
            id: tree
            text: "~T~ree"
            on_click: root.spawn(choose_target_line(root, root._here, root._hidden))

        Button:
            id: help
            text: "Help"
            disabled: True
