from navigator.widgets.file_ops.commands import ChooseTarget
from navml.widgets.dialog.button import Button
from navml.widgets.dialog.button_row import ButtonRow
from navml.widgets.dialog.commands import Help
from navml.widgets.dialog.check_boxes import CheckBoxes
from navml.widgets.dialog.dialog import Dialog
from navml.widgets.dialog.field import Field
from navml.widgets.dialog.label import Label

#: File > Archive > Extract to, and Shift+F2 on an archive: DOS Navigator's
#: ``dlgExtract``.
#:
#: Where to, the two options, and OK / Cancel / Tree / Help.  DN's *Password*
#: line is left out: Python's zip reader knows only the old ZipCrypto, and
#: 7-Zip is asked for none.  A row taller than DN's 49 by 12, for this
#: library's buttons.
ExtractDialog(Dialog):
    modal_width: 49
    modal_height: 11
    title: "Extract files"
    help_topic: "archives.md#extract-files"
    buttons: "none"

    keys:
        f10: ChooseTarget

    #: The commands this component handles itself.
    commands:
        ChooseTarget: root.spawn(root.choose_target())

    buttons_row: (pick, abandon, tree, help)

    Label:
        id: target_caption
        x: 2
        y: 1
        width: 20
        text: "E~x~tract to"
        link: target.entry

    #: DN's ``hsFileCopyName``: the Copy dialog's history.
    Field:
        id: target
        y: 2
        anchors:
            left: 2
            right: 2
        label_text: ""
        label_width: 0
        history_id: "copy"

    CheckBoxes:
        id: options
        y: 4
        height: 2
        anchors:
            left: 2
            right: 2
        items: ["Extract with ~p~ath names", "T~e~st only"]
        tooltips: ["Make the archive's directories; off, every file goes straight into the target", "Check the archive for errors, writing nothing"]

    #: DN's own row now that Help is back: four buttons ten wide and touching,
    #: from column 8, as ``dlgExtract`` has them -- this library's eleven and
    #: a gap of two would pass the frame.
    ButtonRow:
        justify: "start"
        button_width: 10
        spacing: 0
        anchors:
            left: 8
            right: 0
            bottom: 2

        Button:
            id: pick
            text: "O~K~"
            default: True

        Button:
            id: abandon
            text: "Cancel"

        Button:
            id: tree
            text: "~T~ree"
            on_click: root.spawn(root.choose_target())

        #: ``cmHelp``: asks as F1 does, for ``help_topic`` above.
        Button:
            id: help
            text: "Help"
            command: Help
