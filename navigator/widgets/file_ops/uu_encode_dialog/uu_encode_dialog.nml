from navigator.widgets.file_ops.commands import ChooseTarget
from navml.widgets.dialog.button import Button
from navml.widgets.dialog.button_row import ButtonRow
from navml.widgets.dialog.commands import Help
from navml.widgets.dialog.check_boxes import CheckBoxes
from navml.widgets.dialog.dialog import Dialog
from navml.widgets.dialog.field import Field
from navml.widgets.dialog.label import Label
from navml.widgets.dialog.masked_field import MaskedField
from navml.widgets.dialog.radio_buttons import RadioButtons

#: File > Encoding > UU Encode, Ctrl+F7: DOS Navigator's ``dlgUUEncode``.
#:
#: Laid out where the resource puts things: where to on the second row, the
#: *Prefixes* and the *Checksum level* side by side under it, *Lines per
#: section* and the *Target file format* below, and OK / Cancel / Tree / Help
#: along the bottom.  A row taller than DN's 60 by 17, for this library's
#: buttons.
UUEncodeDialog(Dialog):
    modal_width: 60
    modal_height: 18
    title: "UU Encode"
    help_topic: "file-operations.md#encoding"
    buttons: "none"

    #: ``StatusDef``'s ``F10 Tree``, as the Copy dialog's.
    keys:
        f10: ChooseTarget

    #: The commands this component handles itself.
    commands:
        ChooseTarget: root.spawn(root.choose_target())

    buttons_row: (pick, abandon, tree, help)

    #: DN's ``hsUUEncode``.
    Field:
        id: target
        y: 2
        anchors:
            left: 2
            right: 2
        label_text: "~E~ncode to"
        label_width: 12
        history_id: "uuencode"

    Label:
        id: prefixes_caption
        x: 2
        y: 4
        width: 12
        text: "~P~refixes"
        link: prefixes

    #: ``ckFileTime``, ``ckMapTable``, ``ckStatistic``.
    CheckBoxes:
        id: prefixes
        x: 2
        y: 5
        width: 29
        height: 3
        items: ["~F~ile creation date&time", "Char ~m~apping table", "St~a~tistics"]

    Label:
        id: checksum_caption
        x: 32
        y: 4
        width: 18
        text: "~C~hecksum level"
        link: checksum

    #: ``ckNone`` .. ``ck64``: each includes those above it.
    RadioButtons:
        id: checksum
        y: 5
        height: 5
        anchors:
            left: 32
            right: 2
        items: ["~N~one", "of Entire ~i~nput file", "of Each ~s~ection", "of Eac~h~ line", "Advanced ~6~4-bit"]

    MaskedField:
        id: lines
        x: 2
        y: 9
        width: 26
        label_text: "~L~ines per section"
        label_width: 20
        mask: "9999"

    Label:
        id: format_caption
        x: 2
        y: 11
        width: 20
        text: "~T~arget file format"
        link: format

    RadioButtons:
        id: format
        x: 2
        y: 12
        width: 29
        height: 1
        items: ["~D~OS <CR>+<LF>", "~U~NIX"]

    #: DN's own row now that Help is back: four buttons ten wide and touching,
    #: from column 14, as ``dlgUUEncode`` has them -- this library's eleven and a gap
    #: of two would pass the frame.
    ButtonRow:
        justify: "start"
        button_width: 10
        spacing: 0
        anchors:
            left: 14
            right: 0
            bottom: 2

        Button:
            id: pick
            text: "O~K~"
            default: True

        Button:
            id: abandon
            text: "Cancel"

        #: DN's ``~T~ree`` clashed with ``~T~arget file format`` (``DN.DNR:2031,
        #: 2035``); ``T~r~ee`` takes the next free letter -- a departure, as the
        #: hotkey check refuses a clash.
        Button:
            id: tree
            text: "T~r~ee"
            on_click: root.spawn(root.choose_target())

        #: ``cmHelp``: asks as F1 does, for ``help_topic`` above.
        Button:
            id: help
            text: "Help"
            command: Help
