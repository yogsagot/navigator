from navml.widgets.dialog.dialog import Dialog
from navml.widgets.dialog.static_text import StaticText
from navml.widgets.progress_bar import ProgressBar
from navml.widgets.spinner import Spinner

#: Files being hashed, by File > Checksums' Calculate and Verify.  Not DN's
#: (a departure, as the feature is): the file being read, a gauge over the
#: bytes of them all, how many are done, and *Cancel*, which says what Esc does.
ChecksumProgress(Dialog):
    modal_width: min(64, parent.width) if parent is not None else 64
    modal_height: 10
    title: "Checksums"
    buttons: "ok"
    closable: False

    property current: ""
    property position: 0
    property total: 0
    property files_done: 0
    property files_total: 0

    Spinner:
        id: spinner
        x: 2
        y: 1
        width: 1
        height: 1

    StaticText:
        id: current_row
        x: 4
        y: 1
        width: max(0, parent.width - 6)
        height: 1
        wrap: False
        text: root.fit(root.current)

    ProgressBar:
        id: bar
        x: 2
        y: 3
        width: max(0, parent.width - 4)
        height: 1
        value: root.position
        total: root.total

    StaticText:
        id: count_row
        x: 2
        y: 4
        width: max(0, parent.width - 4)
        height: 1
        align: "center"
        text: root.counted(root.files_done, root.files_total, bar.percent)
