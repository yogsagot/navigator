from navigator.widgets.file_ops.commands import ChooseTarget
from navml.widgets.dialog.button import Button
from navml.widgets.dialog.button_row import ButtonRow
from navml.widgets.dialog.check_boxes import CheckBoxes
from navml.widgets.dialog.dialog import Dialog
from navml.widgets.dialog.field import Field
from navml.widgets.dialog.label import Label

#: File > Encoding > UU Decode, Ctrl+F8: DOS Navigator's ``dlgUUDecode``.
#:
#: The target directory under its caption, the three options, and OK /
#: Cancel / Tree; Help is left out, having nothing to show yet.  A row taller
#: than DN's 49 by 11, for this library's buttons.
UUDecodeDialog(Dialog):
    modal_width: 49
    modal_height: 12
    title: "UU Decode"
    buttons: "none"

    keys:
        f10: ChooseTarget

    #: The commands this component handles itself.
    commands:
        ChooseTarget: root.spawn(root.choose_target())

    Label:
        id: target_caption
        x: 2
        y: 1
        width: 20
        text: "Target ~d~irectory"
        link: target.entry

    #: DN's ``hsUUDecode``.
    Field:
        id: target
        y: 2
        anchors:
            left: 2
            right: 2
        label_text: ""
        label_width: 0
        history_id: "uudecode"

    CheckBoxes:
        id: options
        y: 4
        height: 3
        anchors:
            left: 2
            right: 2
        items: ["~C~heck existing files", "Display ~e~rror messages", "~S~ave broken files"]

    ButtonRow:
        justify: "start"
        anchors:
            left: 5
            right: 0
            bottom: 2

        Button:
            id: pick
            text: "O~K~"
            default: True

        Button:
            id: abandon
            text: "Cancel"

        Button:
            id: tree
            text: "~T~ree"
            on_click: root.spawn(root.choose_target())
