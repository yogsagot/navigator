from navml.widgets.dialog.button import Button
from navml.widgets.dialog.check_boxes import CheckBoxes
from navml.widgets.dialog.choice_field import ChoiceField
from navml.widgets.dialog.date_field import DateField
from navml.widgets.dialog.dialog import Dialog
from navml.widgets.dialog.label import Label
from navml.widgets.dialog.list_viewer import ListViewer
from navml.widgets.dialog.masked_field import MaskedField
from navml.widgets.dialog.radio_buttons import RadioButtons
from navml.widgets.dialog.static_text import StaticText
from navml.widgets.dialog.tab_page import TabPage
from navml.widgets.dialog.tab_view import TabView
from navml.widgets.dialog.time_field import TimeField

#: Alt+E: *File Attributes*, DOS Navigator's ``dlgFilesAttr`` read for Linux.
#:
#: A departure in what it edits -- DN's four DOS bits are the twelve mode bits,
#: and the owner and group stand beside DN's date and time -- and DN's in its
#: shape: one dialog over every tagged file, where a bit the files disagree on
#: is ``[?]`` and left alone unless moved.  The grid is one ``CheckBoxes`` of
#: twelve, three tall, which ``Cluster`` lays out in four columns of three:
#: owner, group, others and the special bits, each read/write/execute down.
#:
#: Behind tabs (a departure on a departure, asked for): *Mode* is all of the
#: above, and *ACL*, *Xattrs* and *Flags* are the POSIX ACL, the extended
#: attributes and ``chattr``'s inode flags.  The pages are ``TabPage``s in
#: this document, so every id is the dialog's whichever page it is on.  What
#: the selection is, and *Recurse*, which every page's change obeys, stand
#: outside them.  The tabs are simple ones, bare captions over a rule, a row
#: less than boxed tabs.
AttrDialog(Dialog):
    modal_width: 64
    modal_height: 21
    title: "File Attributes"
    buttons: "ok-cancel"

    #: The entry's kind and name, or how many of each were tagged.
    StaticText:
        id: name_row
        x: 2
        y: 1
        width: max(0, parent.width - 4)
        height: 1

    #: A lone entry's size and where a link points.
    StaticText:
        id: info_row
        x: 2
        y: 2
        width: max(0, parent.width - 4)
        height: 1

    #: The rule under the captions is each page's first row; it meets the
    #: frame at both ends.
    TabView:
        id: tabs
        #: What each page holds, a tab's tooltip, in the pages' order.
        tooltips: [
            "Permissions, owner, group and modification time",
            "Access control list: permissions for particular users and groups",
            "Extended attributes: names and values kept with the file",
            "File system flags, such as immutable and append-only",
        ]
        x: 0
        y: 3
        width: parent.width
        height: 12
        side: "simple"
        joins_frame: True

        TabPage:
            id: mode_page
            title: "Mode"

            #: Over the grid's four columns, which are eleven apart: a mark,
            #: its blank, the widest caption, and two between.
            Label:
                id: heading
                x: 3
                y: 1
                width: max(0, parent.width - 6)
                height: 1
                text: "O~w~ner      Group      Others     Special"
                link: bits

            CheckBoxes:
                id: bits
                x: 3
                y: 2
                width: max(0, parent.width - 6)
                height: 3
                items: ["Read", "Write", "Exec", "Read", "Write", "Exec", "Read", "Write", "Exec", "Set UID", "Set GID", "Sticky"]
                tooltips: ["", "", "", "", "", "", "", "", "", "Run with the file owner's rights", "Run with the group's rights; in a directory, new files take its group", "In a directory, only a file's owner may delete or rename it"]

            #: The mode as ``chmod`` takes it: four octal digits, each setting
            #: the three boxes it stands for.
            MaskedField:
                id: octal
                x: 2
                y: 6
                width: 16
                height: 1
                label_text: "~O~ctal"
                label_width: 10
                mask: "9999"
                base: 8

            #: The mode as ``ls -l`` shows it.
            StaticText:
                id: symbolic
                x: 20
                y: 6
                width: 12
                height: 1

            #: Chosen from the passwd and group databases, never typed: any
            #: key on either drops its list, and typing there searches it.
            ChoiceField:
                id: user
                x: 2
                y: 7
                width: max(0, parent.width - 4)
                height: 1
                label_text: "~U~ser"
                label_width: 10

            ChoiceField:
                id: group
                x: 2
                y: 8
                width: max(0, parent.width - 4)
                height: 1
                label_text: "~G~roup"
                label_width: 10

            #: DN's ``Date (D-M-Y)`` and ``Time (H:M:S)``: the modification
            #: time.  Typed, or picked from the calendar and the clock face
            #: their ``▐↓▌`` drops (Alt+Down).  Both follow *Country support*,
            #: their formats set in ``__init__``: the date in its order, or the
            #: European where that has names a mask cannot hold; the time in 24
            #: hours, or 12 with ``am``/``pm`` (``a`` or ``p`` typed sets it),
            #: for which the line is two cells wider.
            DateField:
                id: date
                x: 2
                y: 9
                width: 26
                height: 1
                label_text: "~D~ate"
                label_width: 10

            TimeField:
                id: clock
                x: 30
                y: 9
                width: 22
                height: 1
                label_text: "~T~ime"
                label_width: 6

        #: The access ACL's named entries and mask, then a directory's
        #: default ACL's; the owner, group and others entries are the mode.
        TabPage:
            id: acl_page
            title: "ACL"

            Label:
                id: acl_caption
                x: 2
                y: 1
                width: 20
                height: 1
                text: "E~n~tries"
                link: acl_list

            ListViewer:
                id: acl_list
                x: 2
                y: 2
                width: max(0, parent.width - 18)
                height: 8

            Button:
                id: acl_add
                text: "~A~dd"
                x: max(0, parent.width - 14)
                y: 2
                width: 12
                height: 2

            Button:
                id: acl_edit
                text: "~E~dit"
                x: max(0, parent.width - 14)
                y: 4
                width: 12
                height: 2

            Button:
                id: acl_delete
                text: "~D~elete"
                x: max(0, parent.width - 14)
                y: 6
                width: 12
                height: 2

            #: ``setfacl -b``: every named entry and the mask, access and default.
            Button:
                id: acl_clear
                text: "~C~lear"
                x: max(0, parent.width - 14)
                y: 8
                width: 12
                height: 2

            #: Why the page cannot be used, where it cannot.
            StaticText:
                id: acl_note
                x: 2
                y: 10
                width: max(0, parent.width - 4)
                height: 1

        TabPage:
            id: xattr_page
            title: "Xattrs"

            Label:
                id: xattr_caption
                x: 2
                y: 1
                width: 20
                height: 1
                text: "Na~m~es"
                link: xattr_list

            ListViewer:
                id: xattr_list
                x: 2
                y: 2
                width: max(0, parent.width - 18)
                height: 8

            Button:
                id: xattr_add
                text: "~A~dd"
                x: max(0, parent.width - 14)
                y: 2
                width: 12
                height: 2

            Button:
                id: xattr_edit
                text: "~E~dit"
                x: max(0, parent.width - 14)
                y: 4
                width: 12
                height: 2

            Button:
                id: xattr_delete
                text: "~D~elete"
                x: max(0, parent.width - 14)
                y: 6
                width: 12
                height: 2

            StaticText:
                id: xattr_note
                x: 2
                y: 10
                width: max(0, parent.width - 4)
                height: 1

        #: ``chattr``'s flags a user may ask for, tri-state as the mode's grid,
        #: four columns of three; the ``lsattr`` line has the rest too.
        TabPage:
            id: flags_page
            title: "Flags"

            Label:
                id: flags_caption
                x: 3
                y: 1
                width: 20
                height: 1
                text: "~F~lags"
                link: flags

            CheckBoxes:
                id: flags
                x: 3
                y: 2
                width: max(0, parent.width - 6)
                height: 3
                items: ["Immutable", "Append", "No dump", "No atime", "Sync", "Dir sync", "No COW", "Compress", "Journal", "Top dir", "Secure rm", "Undelete"]
                tooltips: ["No one may change, rename or delete it, root included", "It can only be added to", "Left out of backups made with dump", "Its access time is never updated", "Its changes are written to the disk at once", "Changes to this directory are written to the disk at once", "Rewritten in place rather than copied on write (btrfs)", "Compressed by the file system", "Its data goes through the file system's journal", "The top of a directory tree, for where the file system places blocks", "Its blocks are cleared when it is deleted, where the file system can", "Its contents are kept when it is deleted, where the file system can"]

            StaticText:
                id: lsattr
                x: 3
                y: 6
                width: max(0, parent.width - 6)
                height: 1

            StaticText:
                id: flags_note
                x: 3
                y: 8
                width: max(0, parent.width - 6)
                height: 1

    #: What to change under a tagged directory, on every page; inert with
    #: none tagged.
    Label:
        id: recurse_caption
        x: 2
        y: 16
        width: 10
        height: 1
        text: "~R~ecurse"
        link: recurse

    RadioButtons:
        id: recurse
        x: 12
        y: 16
        width: max(0, parent.width - 14)
        height: 1
        items: ["No", "Files", "Dirs", "All"]
        tooltips: ["Only the tagged directories themselves change", "The files under a tagged directory change too, the directories in it not", "The directories under a tagged directory change too, the files in it not", "Everything under a tagged directory changes too"]
