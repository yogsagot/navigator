from navigator.widgets.file_ops.multi_rename_dialog.rename_preview import RenamePreview
from navml.widgets.dialog.check_boxes import CheckBoxes
from navml.widgets.dialog.choice_field import ChoiceField
from navml.widgets.dialog.dialog import Dialog
from navml.widgets.dialog.field import Field
from navml.widgets.dialog.label import Label
from navml.widgets.dialog.radio_buttons import RadioButtons
from navml.widgets.dialog.static_text import StaticText

#: File > Multi-rename (Alt+A): the tagged files renamed by one pattern, every
#: new name shown before anything is done.  A departure -- Total Commander's
#: *Multi-Rename Tool*; DOS Navigator's group rename was F6's ``*``/``?`` mask,
#: which stays.  The placeholders are :mod:`navigator.lib.file_ops.multirename`'s.
MultiRenameDialog(Dialog):
    modal_width: 76
    modal_height: 25
    title: "Multi-rename"

    Field:
        id: name_mask
        y: 1
        anchors:
            left: 2
            right: 2
        label_text: "~N~ame mask"
        label_width: 16
        history_id: "rename_name_mask"

    Field:
        id: ext_mask
        y: 2
        anchors:
            left: 2
            right: 2
        label_text: "E~x~tension mask"
        label_width: 16
        history_id: "rename_ext_mask"

    Field:
        id: search
        y: 3
        anchors:
            left: 2
            right: 2
        label_text: "~S~earch for"
        label_width: 16
        history_id: "rename_search"

    Field:
        id: replace
        y: 4
        anchors:
            left: 2
            right: 2
        label_text: "Re~p~lace with"
        label_width: 16
        history_id: "rename_replace"

    CheckBoxes:
        id: options
        x: 3
        y: 6
        width: 26
        height: 4
        items: ["Regular ~e~xpression", "Case sens~i~tive", "~F~irst match only", "Clean up na~m~es"]
        tooltips: ["The search is a regular expression, not plain text", "", "Replace only the first match in each name", "Bytes that are not UTF-8 read in the code page below, NFC, control characters to _, names differing only by case numbered"]

    #: *Clean up names*' code page for bytes that are not UTF-8: the
    #: viewer's Shift+F6 list.
    ChoiceField:
        id: codepage
        x: 2
        y: 11
        width: 47
        label_text: "C~o~de page"
        label_width: 11
        disabled: not (options.value & 8)

    Label:
        id: case_caption
        x: 31
        y: 5
        width: 10
        text: "Case"
        link: case

    RadioButtons:
        id: case
        x: 31
        y: 6
        width: 18
        height: 5
        items: ["Unchan~g~ed", "~l~ower", "~U~PPER", "~W~ord Caps", "Fi~r~st only"]

    Field:
        id: start
        x: 51
        y: 6
        width: 22
        label_text: "Coun~t~er"
        label_width: 9

    Field:
        id: step
        x: 51
        y: 7
        width: 22
        label_text: "Step"
        label_width: 9

    Field:
        id: digits
        x: 51
        y: 8
        width: 22
        label_text: "~D~igits"
        label_width: 9

    RenamePreview:
        id: preview
        anchors:
            left: 2
            right: 2
            top: 13
            bottom: 5

    StaticText:
        id: status
        anchors:
            left: 2
            right: 2
            bottom: 4
        align: "center"
