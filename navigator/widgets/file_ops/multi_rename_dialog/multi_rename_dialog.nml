from navigator.widgets.file_ops.multi_rename_dialog.rename_preview import RenamePreview
from navml.widgets.dialog.check_boxes import CheckBoxes
from navml.widgets.dialog.dialog import Dialog
from navml.widgets.dialog.field import Field
from navml.widgets.dialog.label import Label
from navml.widgets.dialog.radio_buttons import RadioButtons
from navml.widgets.dialog.static_text import StaticText

#: Panel > Multi-rename (Alt+A): the tagged files renamed by one pattern, every
#: new name shown before anything is done.  A departure -- Total Commander's
#: *Multi-Rename Tool*; DOS Navigator's group rename was F6's ``*``/``?`` mask,
#: which stays.  The placeholders are :mod:`navigator.lib.file_ops.multirename`'s.
MultiRenameDialog(Dialog):
    modal_width: 76
    modal_height: 23
    title: "Multi-rename"

    Field:
        id: name_mask
        x: 2
        y: 1
        width: max(0, parent.width - 4)
        height: 1
        label_text: "~N~ame mask"
        label_width: 16
        history_id: "rename_name_mask"

    Field:
        id: ext_mask
        x: 2
        y: 2
        width: max(0, parent.width - 4)
        height: 1
        label_text: "E~x~tension mask"
        label_width: 16
        history_id: "rename_ext_mask"

    Field:
        id: search
        x: 2
        y: 3
        width: max(0, parent.width - 4)
        height: 1
        label_text: "~S~earch for"
        label_width: 16
        history_id: "rename_search"

    Field:
        id: replace
        x: 2
        y: 4
        width: max(0, parent.width - 4)
        height: 1
        label_text: "Re~p~lace with"
        label_width: 16
        history_id: "rename_replace"

    CheckBoxes:
        id: options
        x: 3
        y: 6
        width: 26
        height: 3
        items: ["Regular ~e~xpression", "Case sens~i~tive", "~F~irst match only"]
        tooltips: ["The search is a regular expression, not plain text", "", "Replace only the first match in each name"]

    Label:
        id: case_caption
        x: 31
        y: 5
        width: 10
        height: 1
        text: "Case"
        link: case

    RadioButtons:
        id: case
        x: 31
        y: 6
        width: 18
        height: 5
        items: ["Unchan~g~ed", "~l~ower", "~U~PPER", "~W~ord Caps", "Fi~r~st only"]

    Field:
        id: start
        x: 51
        y: 6
        width: 22
        height: 1
        label_text: "Coun~t~er"
        label_width: 9

    Field:
        id: step
        x: 51
        y: 7
        width: 22
        height: 1
        label_text: "Step"
        label_width: 9

    Field:
        id: digits
        x: 51
        y: 8
        width: 22
        height: 1
        label_text: "~D~igits"
        label_width: 9

    RenamePreview:
        id: preview
        x: 2
        y: 11
        width: max(0, parent.width - 4)
        height: max(0, parent.height - 16)

    StaticText:
        id: status
        x: 2
        y: max(0, parent.height - 5)
        width: max(0, parent.width - 4)
        height: 1
        align: "center"
