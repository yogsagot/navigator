from navml.widgets.dialog.button import Button
from navml.widgets.dialog.button_row import ButtonRow
from navml.widgets.dialog.dialog import Dialog
from navml.widgets.dialog.static_text import StaticText

#: ``dlFileExist`` with ``mfYesButton + mfNoButton + mfAllButton +
#: mfCancelButton``: what UU Encode and UU Decode ask of a file that is there
#: already.  *Yes* first and the default, as the message box had it.
ExistsQuery(Dialog):
    modal_width: 58
    modal_height: 9
    title: "Confirm"

    StaticText:
        id: details
        y: 1
        height: 2
        anchors:
            left: 1
            right: 1
        align: "center"

    #: The answers, centred in a row as the message box's were.
    ButtonRow:
        anchors:
            left: 0
            right: 0
            bottom: 2

        Button:
            id: agree
            text: "~Y~es"
            default: True

        Button:
            id: refuse
            text: "~N~o"

        Button:
            id: every
            text: "~A~ll"

        Button:
            id: abandon
            text: "Cancel"
