from navml.widgets.dialog.button import Button
from navml.widgets.dialog.dialog import Dialog
from navml.widgets.dialog.static_text import StaticText

#: ``dlFileExist`` with ``mfYesButton + mfNoButton + mfAllButton +
#: mfCancelButton``: what UU Encode and UU Decode ask of a file that is there
#: already.  *Yes* first and the default, as the message box had it.
ExistsQuery(Dialog):
    modal_width: 58
    modal_height: 9
    title: "Confirm"

    StaticText:
        id: details
        x: 1
        y: 1
        width: max(0, parent.width - 2)
        height: 2
        align: "center"

    Button:
        id: agree
        text: "~Y~es"
        default: True
        x: root.slot(0)
        y: max(0, parent.height - 4)
        width: 11
        height: 2

    Button:
        id: refuse
        text: "~N~o"
        x: root.slot(1)
        y: max(0, parent.height - 4)
        width: 11
        height: 2

    Button:
        id: every
        text: "~A~ll"
        x: root.slot(2)
        y: max(0, parent.height - 4)
        width: 11
        height: 2

    Button:
        id: abandon
        text: "Cancel"
        x: root.slot(3)
        y: max(0, parent.height - 4)
        width: 11
        height: 2
