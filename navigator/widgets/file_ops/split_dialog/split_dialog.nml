from navigator.widgets.file_ops.commands import ChooseTarget
from navml.widgets.dialog.button import Button
from navml.widgets.dialog.button_row import ButtonRow
from navml.widgets.dialog.commands import Help
from navml.widgets.dialog.check_boxes import CheckBoxes
from navml.widgets.dialog.dialog import Dialog
from navml.widgets.dialog.field import Field
from navml.widgets.dialog.label import Label

#: File > Split/combine on a file that is not a part: DOS Navigator's
#: ``dlgSplitFile``.
#:
#: *Split NAME to* over the target line, as ``LongCopy``'s ``CopyDialog``
#: inserted the name into the label, and OK / Cancel / Tree / Help along the
#: bottom (*Help* without DN's ``~H~``, as Copy's is).  A row taller than
#: DN's 50 by 11, for this library's buttons.
#:
#: **A departure**: *Part size* is new -- DN split where each floppy filled,
#: and a POSIX disk does not fill a part at a time -- and its two boxes,
#: *Binary splitting only* (the ``.D01`` header, which the ``.001`` parts do
#: not have) and *Verify disk writes* (as Copy's was), are dropped for *Write
#: checksum file*, the set's ``NAME.crc`` (``navigator/lib/file_ops/splitfile.py``).
SplitDialog(Dialog):
    modal_width: 50
    modal_height: 12
    title: "Split file"
    help_topic: "file-operations.md#splitting"
    buttons: "none"

    keys:
        f10: ChooseTarget

    #: The commands this component handles itself.
    commands:
        ChooseTarget: root.spawn(root.choose_target())

    buttons_row: (pick, abandon, tree, help)

    Label:
        id: target_caption
        y: 1
        anchors:
            left: 2
            right: 2
        text: "~S~plit to"
        link: target.entry

    #: DN's ``hsFBBCopy``.
    Field:
        id: target
        y: 2
        anchors:
            left: 2
            right: 2
        label_text: ""
        label_width: 0
        history_id: "splitfile"

    Field:
        id: size
        x: 2
        y: 4
        width: 28
        label_text: "Part si~z~e"
        label_width: 12
        history_id: "split_size"

    CheckBoxes:
        id: options
        y: 6
        height: 1
        anchors:
            left: 2
            right: 2
        items: ["~W~rite checksum file (.crc)"]

    #: DN's own row now that Help is back: four buttons ten wide and touching,
    #: from column 8, as ``dlgSplitFile`` has them -- this library's eleven and a gap
    #: of two would pass the frame.
    ButtonRow:
        justify: "start"
        button_width: 10
        spacing: 0
        anchors:
            left: 8
            right: 0
            bottom: 2

        Button:
            id: pick
            text: "O~K~"
            default: True

        Button:
            id: abandon
            text: "Cancel"

        Button:
            id: tree
            text: "~T~ree"
            on_click: root.spawn(root.choose_target())

        #: ``cmHelp``: asks as F1 does, for ``help_topic`` above.
        Button:
            id: help
            text: "Help"
            command: Help
