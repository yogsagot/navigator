from navkit.bidi import display_width
from navml.widgets.dialog.dialog import Dialog
from navml.widgets.dialog.static_text import StaticText
from navml.widgets.progress_bar import ProgressBar

#: A copy under way: the ``TWhileView`` ``FILECOPY.PAS`` opened 40 by 13 (14 here, for the speed row).
#:
#: DN's rows were the file being read and its gauge, then the file being
#: written and its; a copy here reads and writes in one pass, so the rows are
#: the file and where it goes, the file's gauge, and the whole copy's gauge
#: with the bytes done.  DN's ``dlFC_Total``, *Total N bytes*, is on the
#: bottom frame where it wrote it.  While the sources are counted the first
#: row says DN's *Checking directories...* (``measuring``).  A rename reads
#: *Moving FROM / to TO*, DN's three lines (``DoRename``) in two.
#: One *Stop*, which asks before it stops, as ``dlQueryAbort`` did.
#:
#: The row under the total gauge, the speed and the time left, is a
#: departure: DN never said how fast a copy went.  ``speed`` is bytes a
#: second and ``left`` seconds, each negative while not known yet.  DN's
#: own lines take it over while they have something to say (``note``):
#: *File exists - skipped*, *Older file - skipped*, *Deleting source
#: file...*.
#:
#: ``packing`` is a copy into an archive being written at the end
#: (``ArchiveDrive.finish``), which DN's archivers did with their own
#: output: the rows say *Packing* the member *into* the archive, and the
#: gauges count the packing.
CopyProgress(Dialog):
    modal_width: 60
    modal_height: 14
    title: "Rename/move" if root.move else "Copy"
    #: *Background* beside the one button, while the watcher can let the box
    #: go (``navigator.widgets.file_ops.background_button``).
    buttons: "yes-no" if root.background else "ok"
    closable: False

    property background: False
    property move: False
    property packing: False
    property source: ""
    property dest: ""
    property file_done: 0
    property file_bytes: 0
    property done: 0
    property total: 0
    property speed: -1.0
    property measuring: False
    property note: ""
    property left: -1.0

    StaticText:
        id: source_row
        y: 1
        height: 1
        anchors:
            left: 2
            right: 2
        text: root.checking() if root.measuring else root.fit(" Packing " if root.packing else " Moving " if root.move else " Copying ", root.source)
        tooltip: root.whole(" Packing " if root.packing else " Moving " if root.move else " Copying ", root.source)

    StaticText:
        id: dest_row
        y: 2
        height: 1
        anchors:
            left: 2
            right: 2
        text: "" if root.measuring else root.fit(" into " if root.packing else " to ", root.dest)
        tooltip: root.whole(" into " if root.packing else " to ", root.dest)

    #: Both gauges are as wide as the box less four columns a side.
    ProgressBar:
        id: file_bar
        y: 4
        height: 1
        anchors:
            left: 4
            right: 4
        value: root.file_done
        total: root.file_bytes

    StaticText:
        id: file_count
        y: 5
        height: 1
        anchors:
            left: 2
            right: 2
        align: "center"
        text: "" if root.measuring else root.count(root.file_done, file_bar.percent)

    ProgressBar:
        id: total_bar
        y: 6
        height: 1
        anchors:
            left: 4
            right: 4
        value: root.done
        total: root.total

    StaticText:
        id: total_count
        y: 7
        height: 1
        anchors:
            left: 2
            right: 2
        align: "center"
        text: "" if root.measuring else root.count(root.done, total_bar.percent)

    StaticText:
        id: pace_row
        y: 8
        height: 1
        anchors:
            left: 2
            right: 2
        align: "center"
        text: root.status(root.note, root.speed, root.left)

    #: DN's ``dlFC_Total``: the whole copy's size, on the bottom frame.
    StaticText:
        id: frame_total
        name: "frame-total"
        width: min(display_width(self.text), max(0, parent.width - 4))
        height: 1
        anchors:
            center: horizontal
            bottom: 0
        text: "" if root.measuring else root.total_text(root.total)
