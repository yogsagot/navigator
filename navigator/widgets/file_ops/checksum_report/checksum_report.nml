from navml.widgets.dialog.dialog import Dialog
from navml.widgets.dialog.label import Label
from navml.widgets.dialog.list_viewer import ListViewer
from navml.widgets.dialog.static_text import StaticText

#: File > Checksums > Verify's answer.  Not DN's: a departure, asked for.
#:
#: The counts at the top and, when anything did not match, every such file
#: in a list under them -- as many as there are, which a message box's few
#: lines could not hold.
ChecksumReport(Dialog):
    modal_width: min(70, parent.width) if parent is not None else 70
    modal_height: min(20, parent.height) if parent is not None else 20
    title: "Verify Checksums"
    buttons: "ok"

    StaticText:
        id: summary
        x: 2
        y: 1
        width: max(0, parent.width - 4)
        height: 4
        wrap: False

    Label:
        id: bad_caption
        x: 2
        y: 6
        width: 12
        height: 1
        text: "~P~roblems"
        link: bad
        visible: len(bad.items) > 0

    ListViewer:
        id: bad
        x: 2
        y: 7
        width: max(0, parent.width - 4)
        height: max(1, parent.height - 12)
        visible: len(self.items) > 0
