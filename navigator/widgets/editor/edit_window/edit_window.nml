from navkit.bidi import display_width
from navigator.commands import NewView, PrintFile
from navigator.widgets.manager.commands import Calculator, EditNamed
from navigator.widgets.editor.commands import BlockStart, BlockEnd, MarkWord, MarkLine, MoveBlockStart, MoveBlockEnd, PlaceMarker, GotoMarker, DeleteWordRight, DeleteToEnd, ChooseEncoding, ChooseLineEnding, ChooseFileType, AsciiTable, CalcBlock, SwitchHiColumn, SwitchHiLine, SwitchHighLight, SwitchHiddenChars, SwitchFill, SwitchTabs, SwitchLineNumbers, SwitchSoftWrap, ShowFindBar, ShowReplaceBar, CapString, CapWord, LowString, LowWord, UpString, UpWord, DuplicateLine, DeleteLine, DeleteWordLeft, InsertLine, HideBlock, BracketPair, SwitchDrawMode, SwitchBack, SwitchIndent, SwitchBrackets, SwitchSave, SwitchWrap, FCenter, FJustify, FLeft, FRight, LCenter, LJustify, LLeft, LRight, SetMargins, ContSearch, LoadText, Replace, ReverseSearch, StartSearch, SaveAll, SaveTextAs, CapitalizeBlock, Clear, ClipboardCopy, ClipboardCut, ClipboardPaste, CopyBlock, GotoLineNumber, PrintBlock, IndentBlock, InsertDate, InsertTime, BlockRead, BlockWrite, LowcaseBlock, MoveBlock, SaveText, SortBlock, UnindentBlock, Undo, Redo, UpcaseBlock, SwitchBlock
from navigator.widgets.editor.file_editor import FileEditor, FormatMarks, InfoLine, LineGutter, gutter_width
from navigator.widgets.editor.find_bar import FindBar
from navigator.settings import SETTINGS
from navml.commands import CloseWindow
from navml.widgets.menu.commands import MainMenu
from navml.widgets.option_strip import OptionStrip
from navml.widgets.dialog.scroll_bar import ScrollBar
from navml.widgets.menu.menu_item import MenuItem
from navml.widgets.menu.menu_line import MenuLine
from navml.widgets.menu.sub_menu import SubMenu
from navml.widgets.window import Window

#: F4: DOS Navigator's ``TEditWindow`` (``MICROED.PAS``).
#:
#: A standard window titled ``Edit - `` and the file's path, the editor filling
#: the inside of its frame, a vertical scroll bar on the right frame column, a
#: horizontal one along the bottom frame, and ``TInfoLine`` over the bottom
#: frame's left end -- the views ``TEditWindow.Init`` inserts, in the places it
#: puts them.  **It opens zoomed**, as the viewer does -- unless *Store editor
#: position* has a last editor rectangle (``file_history.place_last_edit``).
#:
#: Both scroll bars and the info line show only while the window is active, as
#: ``TFileEditor.SetState`` hid the bars and ``TInfoLine.Draw`` drew nothing.
EditWindow(Window):
    zoomed: True

    #: ``StatusDef hcEditor``: what it captions.  The editing keys are the
    #: editor's own table, and Esc and Alt+F3 close the window, asking first
    #: about a text that has changed.
    keys:
        escape: CloseWindow
        alt+f3: CloseWindow
        f2: SaveText
        #: A departure, with the editor's other modern keys: Ctrl+S was
        #: WordStar's cursor left in DN (``FileEditor.keys``).
        ctrl+s: SaveText
        f3: LoadText
        shift+f2: SaveTextAs
        ctrl+f2: SaveAll
        #: ``StatusDef hcEditor``: ``F7 Search``, ``Alt-F7 Rev. Search``,
        #: ``Ctrl-F7 Replace``, ``Shift-F7 Cont. Search`` -- and Ctrl+L, the
        #: editor table's other ``cmContSearch`` key.
        f7: StartSearch
        alt+f7: ReverseSearch
        ctrl+f7: Replace
        shift+f7: ContSearch
        ctrl+l: ContSearch
        #: ``Ctrl-F6 Calc`` and ``Shift-F4 Edit...`` (``cmXEditFile``): the
        #: Shell's, as in the panels and the viewer.
        ctrl+f6: Calculator
        shift+f4: EditNamed
        #: The *File type* menu in a box: a departure, as the menu is.
        #: Ctrl+Shift+H needs the kitty keyboard protocol.
        ctrl+shift+h: ChooseFileType
        #: *Hidden characters*, a departure: Word's key for its ¶.  Needs the
        #: kitty keyboard protocol too.
        ctrl+shift+8: SwitchHiddenChars
        #: ``StatusDef hcEditor``'s ``:~F8~ Print Block``.
        #: ``~F8~ Print``: the text the editor holds.
        f8: PrintFile
        shift+f8: PrintBlock

    #: *Line numbers* (a departure: DN numbered no lines), left of the text
    #: and as wide as the line count's digits and a blank; the editor is
    #: narrowed by it, so its own columns never change.  Off, it is nothing.
    LineGutter:
        id: gutter
        target: editor
        visible: editor.line_numbers
        x: 1
        width: min(gutter_width(editor.line_count), max(0, parent.width - 3)) if editor.line_numbers else 0
        anchors:
            top: 1
            bottom: 1

    FileEditor:
        id: editor
        x: 1 + gutter.width
        width: max(0, parent.width - 2 - gutter.width)
        anchors:
            top: 1
            bottom: 1

    #: Ctrl+F's Find bar and Ctrl+R's Replace bar (a departure): over the edit
    #: area's top-right corner, a cell short of the scroll bar, and hidden
    #: where the area is too narrow for it.  Shown by ``open``, never bound.
    FindBar:
        id: find_bar
        width: min(50, editor.width - 1) if editor.width >= 36 else 0
        height: 4 if self.replace else 3
        x: editor.x + editor.width - self.width - 1
        y: editor.y

    #: Its value is the cursor's line, as ``VScroll`` was ``Delta.Y``.  Shown
    #: only while there are more lines than the area holds (a departure, asked
    #: for, as the viewer's: DN's was always there).
    ScrollBar:
        id: vbar
        visible: root.active and editor.overflows
        width: 1
        anchors:
            right: 0
            top: 1
            bottom: 1
        value: editor.line
        maximum: max(0, editor.line_count - 1)
        page: max(1, editor.height)

    #: From column 24 to the corner, as ``ChangeBounds`` sized it -- or from
    #: after the line-ending and encoding markers, when they reach further
    #: (a departure, with them).  With the
    #: option strip showing it ends a cell short of the strip instead, and
    #: narrower than its two arrows, thumb and a cell of track it is not shown
    #: at all.  Shown only while a line on screen is wider than the area, or it
    #: is scrolled sideways, and its range is the widest of them
    #: (``FileEditor.row_span``) -- a departure, asked for, as the viewer's:
    #: DN's was always there and ran 0 to 255.
    ScrollBar:
        id: hbar
        orientation: "horizontal"
        visible: root.active and editor.overflows_across and self.width >= 4
        x: max(24, marks.x + marks.width + 1) if marks.visible and marks.width else 24
        height: 1
        anchors:
            before: options + 1
            right: 2
            bottom: 0
        value: editor.col
        maximum: max(0, editor.row_span - 1)
        page: max(1, editor.width)

    #: ``TInfoLine``: over the bottom frame, two columns in, as wide as it says.
    InfoLine:
        id: info
        #: Named, so the sheet can give it the frame's colours.
        name: "info"
        visible: root.active
        x: 2
        width: min(display_width(editor.info_text), max(0, parent.width - 4))
        height: 1
        anchors:
            bottom: 0
        text: editor.info_text

    #: A departure, asked for: the line ending and the encoding, ``[LF]═[UTF-8]``,
    #: a cell after the info line, each a click away from its box
    #: (``FormatMarks``, ``format_menu``).  Second to the info line when the
    #: frame is short, before the option strip and the scroll bar.
    FormatMarks:
        id: marks
        name: "info"
        visible: root.active
        width: min(display_width(editor.format_text), max(0, parent.width - 3 - self.x))
        height: 1
        anchors:
            after: info + 1
            bottom: 0
        text: editor.format_text

    #: A departure: DN had no such strip.  The editor's options on the bottom
    #: frame, right-aligned before the corner, each lit while on and switched by
    #: a click (``option_items.editor_items``) -- DN showed them only in the
    #: menu, and a mode kept per file went unnoticed.  The info line comes first
    #: when the frame is short, then the strip, then the scroll bar.
    OptionStrip:
        id: options
        visible: root.active and SETTINGS.editor.show_options
        target: editor
        room: max(0, parent.width - 3 - (marks.x + marks.width if marks.visible and marks.width else info.x + info.width) - 1)
        width: self.used_width
        height: 1
        anchors:
            right: 3
            bottom: 0

    #: DOS Navigator's ``dlgEditorMenu`` (``DN.DNR``): its entries in the
    #: original's order and with its captions, the keys what the key table
    #: binds now, and Navigator's additions (the clipboard four at the top,
    #: *Delete*, *Redo*, *Find bar*/*Replace bar*, *Line endings*/*Encoding*,
    #: *File type*... -- the ``navigator-editor`` skill lists them) -- but as one
    #: *Editor* entry on the main bar, after *File*, while this window is the
    #: active one, rather than as a bar of its own inside the window
    #: (``TEditWindow.Init``).  Its seven menus would not fit beside the main
    #: bar's, and *File*, *Options* and four of its letters are the main bar's
    #: already, so they are submenus here -- all but *Edit*, whose entries are
    #: the menu's own (below).  F10 and ^K^Q drop this menu
    #: (``EditWindow.f10_menu``), as ``cmMenu`` reached DN's in-window bar
    #: first, and *File > Main menu* (``cmMainMenu``) goes to the bar's start.
    #:
    #: Every entry names a command the editor does.  DN showed each option's
    #: ``Off``/``On`` in the key column; here an option's entry is ticked
    #: while it is on (``FileEditor.checks``).
    #: *ASCII Table* is *Character table*, a departure: DN's was CP437's 256
    #: bytes, and the text here is Unicode.
    SubMenu:
        id: edit_menu
        text: '~E~ditor'
        tooltip: "Editing, the file, search, paragraphs and blocks"
        after: 'File'
        #: *Edit*'s entries on the *Editor* menu itself rather than a submenu
        #: of it -- a departure, asked for: they are what the menu is opened
        #: for most.  Its letters are theirs, so *Paragraph*, *Options* and
        #: *File type* give up ``P``, ``O`` and ``T``.
        MenuItem:
            text: '~U~ndo'
            command: Undo
            key: 'Alt-BkSp'
        MenuItem:
            text: 'R~e~do'
            command: Redo
            key: 'Alt-Shift-BkSp'
        MenuLine:
        MenuItem:
            text: 'Cu~t~'
            command: ClipboardCut
            key: 'Shift-Del'
        MenuItem:
            text: '~C~opy'
            command: ClipboardCopy
            key: 'Ctrl-Ins'
        MenuItem:
            text: '~P~aste'
            command: ClipboardPaste
            key: 'Shift-Ins'
        MenuItem:
            text: 'C~o~py to...'
            tooltip: "Write the block to a file"
            command: BlockWrite
        MenuItem:
            text: 'P~a~ste from...'
            tooltip: "Insert a file's text at the cursor"
            command: BlockRead
        MenuLine:
        MenuItem:
            text: 'C~l~ear'
            tooltip: "Delete the selection without copying it to the clipboard"
            command: Clear
            key: 'Ctrl-Del'
        #: The deletes on a submenu of their own: on the menu itself the box
        #: would outgrow 25 rows.  Delete line was not on DN's menu, where ^Y
        #: was the only way; Ctrl+Backspace had no entry either; ^T and ^Q Y
        #: were keys alone, and with the default keys modern the menu is how
        #: they are reached (WordStar's sets bind them) -- departures, asked for.
        SubMenu:
            id: edit_menu_delete
            text: '~D~elete'
            tooltip: "Delete a line, a word or the rest of the line"
            MenuItem:
                text: '~D~elete line'
                command: DeleteLine
                key: 'Ctrl-Y'
            MenuItem:
                text: 'Delete ~w~ord left'
                command: DeleteWordLeft
                key: 'Ctrl-BkSp'
            MenuItem:
                text: 'Delete word ri~g~ht'
                tooltip: "Delete from the cursor to the start of the next word"
                command: DeleteWordRight
            MenuItem:
                text: 'Delete to e~n~d of line'
                tooltip: "Delete from the cursor to the end of the line"
                command: DeleteToEnd
        MenuItem:
            text: 'Insert l~i~ne'
            command: InsertLine
            key: 'Ctrl-N'
        MenuLine:
        SubMenu:
            id: edit_menu_file
            text: '~F~ile'
            MenuItem:
                text: '~O~pen...'
                command: LoadText
                key: 'F3'
            MenuItem:
                text: '~S~ave'
                command: SaveText
                key: 'F2'
            MenuItem:
                text: 'Save ~a~s...'
                command: SaveTextAs
                key: 'Shift-F2'
            MenuItem:
                text: 'Save a~l~l...'
                command: SaveAll
                key: 'Ctrl-F2'
            #: Not DN's: another window on this text (Window > *New view* too).
            MenuItem:
                text: 'New ~v~iew'
                tooltip: "Open another window on this text"
                command: NewView
            MenuLine:
            #: A departure, asked for, as the bottom frame's markers are:
            #: filled by ``format_menu``.
            SubMenu:
                id: edit_menu_line_endings
                text: 'Line en~d~ings'
                key_command: ChooseLineEnding
            SubMenu:
                id: edit_menu_encoding
                text: 'En~c~oding'
                key_command: ChooseEncoding
            MenuLine:
            MenuItem:
                text: '~P~rint'
                command: PrintFile
                key: 'F8'
            MenuItem:
                text: 'Print ~b~lock'
                command: PrintBlock
                key: 'Shift-F8'
            MenuLine:
            #: ``cmMainMenu``: the main bar's first entry, F10 in DN's key column.
            MenuItem:
                text: '~M~ain menu'
                command: MainMenu
                key: 'F10'
            MenuItem:
                text: 'E~x~it'
                command: CloseWindow
                key: 'Ctrl-F4'
        SubMenu:
            id: edit_menu_search
            text: '~S~earch'
            #: The Find and Replace bars, a departure; DN's dialogs follow.
            MenuItem:
                text: 'Find ~b~ar'
                tooltip: "Search as you type, in a bar over the text"
                command: ShowFindBar
                key: 'Ctrl-F'
            MenuItem:
                text: 'Replace b~a~r'
                command: ShowReplaceBar
                key: 'Ctrl-R'
            MenuLine:
            MenuItem:
                text: '~F~ind...'
                command: StartSearch
                key: 'F7'
            MenuItem:
                text: '~R~eplace...'
                command: Replace
                key: 'Ctrl-F7'
            MenuItem:
                text: '~S~earch again'
                command: ContSearch
                key: 'Shift-F7'
            MenuItem:
                text: 'Re~v~ersed search'
                command: ReverseSearch
                key: 'Alt-F7'
            MenuItem:
                text: '~G~o to line number...'
                command: GotoLineNumber
                key: 'Alt-G'
            #: ^Q[ / ^Q] had no menu entry in DN -- a departure, asked for.
            MenuItem:
                text: '~M~atching bracket'
                tooltip: "Jump to the bracket that pairs with the one at the cursor"
                command: BracketPair
                key: 'Alt-Left'
            #: The markers, ^K 1-9 and ^Q 1-9, were keys alone in DN -- a
            #: departure: with the default keys modern, these are how they are
            #: reached; the key column shows WordStar's when its set is in use.
            MenuLine:
            SubMenu:
                id: edit_menu_place_marker
                text: 'Pla~c~e marker'
                tooltip: "Keep the cursor's place as one of nine markers"
                MenuItem:
                    text: 'Marker ~1~'
                    tooltip: "Keep the cursor's place as marker 1"
                    command: PlaceMarker(1)
                MenuItem:
                    text: 'Marker ~2~'
                    tooltip: "Keep the cursor's place as marker 2"
                    command: PlaceMarker(2)
                MenuItem:
                    text: 'Marker ~3~'
                    tooltip: "Keep the cursor's place as marker 3"
                    command: PlaceMarker(3)
                MenuItem:
                    text: 'Marker ~4~'
                    tooltip: "Keep the cursor's place as marker 4"
                    command: PlaceMarker(4)
                MenuItem:
                    text: 'Marker ~5~'
                    tooltip: "Keep the cursor's place as marker 5"
                    command: PlaceMarker(5)
                MenuItem:
                    text: 'Marker ~6~'
                    tooltip: "Keep the cursor's place as marker 6"
                    command: PlaceMarker(6)
                MenuItem:
                    text: 'Marker ~7~'
                    tooltip: "Keep the cursor's place as marker 7"
                    command: PlaceMarker(7)
                MenuItem:
                    text: 'Marker ~8~'
                    tooltip: "Keep the cursor's place as marker 8"
                    command: PlaceMarker(8)
                MenuItem:
                    text: 'Marker ~9~'
                    tooltip: "Keep the cursor's place as marker 9"
                    command: PlaceMarker(9)
            SubMenu:
                id: edit_menu_goto_marker
                text: 'G~o~ to marker'
                tooltip: "Take the cursor back to a place kept as a marker"
                MenuItem:
                    text: 'Marker ~1~'
                    tooltip: "Take the cursor back to marker 1"
                    command: GotoMarker(1)
                MenuItem:
                    text: 'Marker ~2~'
                    tooltip: "Take the cursor back to marker 2"
                    command: GotoMarker(2)
                MenuItem:
                    text: 'Marker ~3~'
                    tooltip: "Take the cursor back to marker 3"
                    command: GotoMarker(3)
                MenuItem:
                    text: 'Marker ~4~'
                    tooltip: "Take the cursor back to marker 4"
                    command: GotoMarker(4)
                MenuItem:
                    text: 'Marker ~5~'
                    tooltip: "Take the cursor back to marker 5"
                    command: GotoMarker(5)
                MenuItem:
                    text: 'Marker ~6~'
                    tooltip: "Take the cursor back to marker 6"
                    command: GotoMarker(6)
                MenuItem:
                    text: 'Marker ~7~'
                    tooltip: "Take the cursor back to marker 7"
                    command: GotoMarker(7)
                MenuItem:
                    text: 'Marker ~8~'
                    tooltip: "Take the cursor back to marker 8"
                    command: GotoMarker(8)
                MenuItem:
                    text: 'Marker ~9~'
                    tooltip: "Take the cursor back to marker 9"
                    command: GotoMarker(9)
        SubMenu:
            id: edit_menu_paragraph
            text: 'Pa~r~agraph'
            MenuItem:
                text: '~J~ustify'
                tooltip: "Justify the block's paragraph to both margins"
                command: FJustify
                key: 'Alt-J'
            MenuItem:
                text: '~R~ight'
                command: FRight
                key: 'Alt-R'
            MenuItem:
                text: '~L~eft'
                command: FLeft
                key: 'Alt-L'
            MenuItem:
                text: '~C~enter'
                command: FCenter
                key: 'Alt-C'
            #: ``cmLJustify``, ``cmLRight``, ``cmLLeft`` and ``cmLCenter``: the
            #: cursor's line alone.  DN gave them no key and no entry, only its
            #: macros' names -- a departure: with the default keys modern, the
            #: menu is how they are reached.
            SubMenu:
                id: edit_menu_line_format
                text: 'Current li~n~e'
                tooltip: "Format the cursor's line alone"
                MenuItem:
                    text: '~J~ustify'
                    tooltip: "Justify the cursor's line to both margins"
                    command: LJustify
                MenuItem:
                    text: '~R~ight'
                    tooltip: "Put the cursor's line against the right margin"
                    command: LRight
                MenuItem:
                    text: '~L~eft'
                    tooltip: "Put the cursor's line at the left margin"
                    command: LLeft
                MenuItem:
                    text: '~C~enter'
                    tooltip: "Center the cursor's line between the margins"
                    command: LCenter
            MenuLine:
            MenuItem:
                text: '~M~argins...'
                command: SetMargins
        SubMenu:
            id: edit_menu_block
            text: '~B~lock'
            #: Marking and going to the block's ends, ^K B/K/T/L and ^Q B/K, were
            #: keys alone in DN -- a departure: with the default keys modern, the
            #: menu is how they are reached (WordStar's sets bind DN's chords).
            MenuItem:
                text: 'Mar~k~ start'
                tooltip: "Begin the block at the cursor"
                command: BlockStart
            MenuItem:
                text: 'Mark ~e~nd'
                tooltip: "End the block at the cursor"
                command: BlockEnd
            MenuItem:
                text: 'Mark ~w~ord'
                tooltip: "Mark the word at the cursor as the block"
                command: MarkWord
            MenuItem:
                text: 'Mark li~n~e'
                tooltip: "Mark the cursor's line as the block"
                command: MarkLine
            MenuLine:
            MenuItem:
                text: '~G~o to block start'
                tooltip: "Take the cursor to where the block begins"
                command: MoveBlockStart
            MenuItem:
                text: 'Go to block en~d~'
                tooltip: "Take the cursor to where the block ends"
                command: MoveBlockEnd
            MenuLine:
            MenuItem:
                text: '~M~ove'
                command: MoveBlock
                key: 'Alt-Shift-V'
            MenuItem:
                text: '~C~opy'
                command: CopyBlock
                key: 'Alt-Shift-K'
            MenuItem:
                text: '~I~ndent'
                command: IndentBlock
                key: 'Alt-Shift-I'
            MenuItem:
                text: '~U~nindent'
                command: UnindentBlock
                key: 'Alt-Shift-O'
            #: ^K H had no menu entry in DN -- a departure, asked for.
            MenuItem:
                text: '~H~ide/show block'
                tooltip: "Hide the marked block, or show it again"
                command: HideBlock
                key: 'Alt-H'
            MenuLine:
            MenuItem:
                text: 'U~p~percase'
                command: UpcaseBlock
                key: 'Alt-Shift-U'
            MenuItem:
                text: '~L~owercase'
                command: LowcaseBlock
                key: 'Alt-Shift-L'
            MenuItem:
                text: 'Capi~t~alize'
                command: CapitalizeBlock
                key: 'Alt-Shift-C'
            MenuLine:
            MenuItem:
                text: '~S~ort'
                tooltip: "Sort the lines by the column block"
                command: SortBlock
                key: 'Alt-T'
            #: ``a``, not DN's ``u``, which its *Unindent* had too.
            MenuItem:
                text: 'C~a~lculate sum'
                tooltip: "Add up the column block's numbers; the sum goes to the clipboard"
                command: CalcBlock
                key: 'Alt-Ins'
        SubMenu:
            id: edit_menu_misc
            text: '~M~isc'
            MenuItem:
                text: 'Insert ~d~ate'
                command: InsertDate
                key: 'Alt-Shift-D'
            MenuItem:
                text: 'Insert ~t~ime'
                command: InsertTime
                key: 'Alt-Shift-T'
            MenuItem:
                text: 'Du~p~licate line'
                command: DuplicateLine
                key: 'F6'
            MenuItem:
                text: 'Character ta~b~le'
                command: AsciiTable
                key: 'Ctrl P'
            MenuItem:
                text: 'Line Dra~w~ing'
                tooltip: "Draw lines with the arrow keys: off, single, double"
                command: SwitchDrawMode
                key: 'F4'
            MenuLine:
            SubMenu:
                id: edit_menu_misc_uppercase
                text: '~U~ppercase'
                MenuItem:
                    text: '~W~ord'
                    command: UpWord
                    key: 'Ctrl ['
                MenuItem:
                    text: '~L~ine'
                    command: UpString
                    key: 'Ctrl+Shift ['
                MenuItem:
                    text: '~B~lock'
                    command: UpcaseBlock
                    key: 'Alt-Shift-U'
            SubMenu:
                id: edit_menu_misc_lowercase
                text: '~L~owercase'
                MenuItem:
                    text: '~W~ord'
                    command: LowWord
                    key: 'Ctrl ]'
                MenuItem:
                    text: '~L~ine'
                    command: LowString
                    key: 'Ctrl+Shift ]'
                MenuItem:
                    text: '~B~lock'
                    command: LowcaseBlock
                    key: 'Alt-Shift-L'
            SubMenu:
                id: edit_menu_misc_capitalize
                text: '~C~apitalize'
                MenuItem:
                    text: '~W~ord'
                    command: CapWord
                    key: 'Ctrl \\'
                MenuItem:
                    text: '~L~ine'
                    command: CapString
                    key: 'Ctrl+Shift \\'
                MenuItem:
                    text: '~B~lock'
                    command: CapitalizeBlock
                    key: 'Alt-Shift-C'
        SubMenu:
            id: edit_menu_options
            text: 'Optio~n~s'
            MenuItem:
                text: '~B~ackspace indents'
                tooltip: "Backspace at a line's start goes back to an indent above"
                command: SwitchBack
            MenuItem:
                text: 'AutoB~r~ackets'
                command: SwitchBrackets
            MenuItem:
                text: 'Auto~i~ndent'
                command: SwitchIndent
            MenuItem:
                text: '~A~uto wrap'
                command: SwitchSave
            MenuItem:
                text: '~J~ustify on wrap'
                tooltip: "Widen a wrapped line to the margin"
                command: SwitchWrap
            MenuItem:
                text: '~V~ertical blocks'
                tooltip: "Mark column blocks instead of line ones"
                command: SwitchBlock
            MenuItem:
                text: 'Opti~m~al fill'
                tooltip: "Write blanks as tabs where they reach a tab stop"
                command: SwitchFill
            #: A departure: DN's Tab always wrote blanks.
            MenuItem:
                text: '~T~ab characters'
                tooltip: "Tab types tab characters, not spaces"
                command: SwitchTabs
            #: A departure: DN's *Auto wrap* broke lines; this only shows them so.
            MenuItem:
                text: 'Soft ~w~rap'
                tooltip: "Show long lines wrapped at the edge, the text unchanged"
                command: SwitchSoftWrap
            #: A departure: DN numbered no lines.
            MenuItem:
                text: 'Line ~n~umbers'
                tooltip: "Number the lines in a gutter beside the text"
                command: SwitchLineNumbers
            MenuItem:
                text: 'Current ~l~ine highlight'
                command: SwitchHiLine
            MenuItem:
                text: 'Current ~c~olumn highlight'
                command: SwitchHiColumn
            MenuItem:
                text: 'Syntax ~h~ighlight'
                command: SwitchHighLight
            #: A departure: DN had no such option.
            MenuItem:
                text: 'Show hi~d~den characters'
                command: SwitchHiddenChars
        #: Filled from ``highlight.FILE_TYPES`` by ``file_type_menu``.  On the
        #: *Editor* menu itself rather than under *Options*, so it is one step
        #: away, as the viewer's is on *View*; ``Y`` because *File* has ``F`` and
        #: *Cut* ``T``.
        SubMenu:
            id: edit_menu_file_type
            text: 'File t~y~pe'
            key_command: ChooseFileType
