from navigator.commands import PrintFile
from navigator.widgets.editor.commands import ChooseFileType, AsciiTable, CalcBlock, SwitchHiColumn, SwitchHiLine, SwitchHighLight, SwitchFill, CapString, CapWord, LowString, LowWord, UpString, UpWord, DuplicateLine, SwitchDrawMode, SwitchBack, SwitchIndent, SwitchBrackets, SwitchSave, SwitchWrap, FCenter, FJustify, FLeft, FRight, SetMargins, ContSearch, LoadText, Replace, ReverseSearch, StartSearch, SaveAll, SaveTextAs, CapitalizeBlock, Clear, ClipboardCopy, ClipboardCut, ClipboardPaste, CopyBlock, GotoLineNumber, PrintBlock, IndentBlock, InsertDate, InsertTime, BlockRead, BlockWrite, LowcaseBlock, MoveBlock, SaveText, SortBlock, UnindentBlock, Undo, UpcaseBlock, SwitchBlock
from navigator.widgets.editor.file_editor import FileEditor, InfoLine
from navml.commands import CloseWindow
from navml.widgets.dialog.scroll_bar import ScrollBar
from navml.widgets.menu.menu_item import MenuItem
from navml.widgets.menu.menu_line import MenuLine
from navml.widgets.menu.sub_menu import SubMenu
from navml.widgets.window import Window

#: F4: DOS Navigator's ``TEditWindow`` (``MICROED.PAS``).
#:
#: A standard window titled ``Edit - `` and the file's path, the editor filling
#: the inside of its frame, a vertical scroll bar on the right frame column, a
#: horizontal one along the bottom frame, and ``TInfoLine`` over the bottom
#: frame's left end -- the views ``TEditWindow.Init`` inserts, in the places it
#: puts them.  **It opens zoomed**, as the viewer does.
#:
#: Both scroll bars and the info line show only while the window is active, as
#: ``TFileEditor.SetState`` hid the bars and ``TInfoLine.Draw`` drew nothing.
EditWindow(Window):
    zoomed: True

    #: ``StatusDef hcEditor``: what it captions.  The editing keys are the
    #: editor's own table, and Esc and Alt+F3 close the window, asking first
    #: about a text that has changed.
    keys:
        escape: CloseWindow
        alt+f3: CloseWindow
        f2: SaveText
        f3: LoadText
        shift+f2: SaveTextAs
        ctrl+f2: SaveAll
        #: ``StatusDef hcEditor``: ``F7 Search``, ``Alt-F7 Rev. Search``,
        #: ``Ctrl-F7 Replace``, ``Shift-F7 Cont. Search``.
        f7: StartSearch
        alt+f7: ReverseSearch
        ctrl+f7: Replace
        shift+f7: ContSearch
        #: The *File type* menu in a box: a departure, as the menu is.
        #: Ctrl+Shift+H needs the kitty keyboard protocol.
        ctrl+shift+h: ChooseFileType
        #: ``StatusDef hcEditor``'s ``:~F8~ Print Block``.
        #: ``~F8~ Print``: the text the editor holds.
        f8: PrintFile
        shift+f8: PrintBlock

    FileEditor:
        id: editor
        x: 1
        y: 1
        width: max(0, parent.width - 2)
        height: max(0, parent.height - 2)

    #: Its value is the cursor's line, as ``VScroll`` was ``Delta.Y``.
    ScrollBar:
        id: vbar
        visible: root.active
        x: parent.width - 1
        y: 1
        width: 1
        height: max(0, parent.height - 2)
        value: editor.line
        maximum: max(0, editor.line_count - 1)
        page: max(1, editor.height)

    #: From column 24 to the corner, as ``ChangeBounds`` sized it; its range is
    #: DN's 0 to 255 until the cursor goes further.
    ScrollBar:
        id: hbar
        orientation: "horizontal"
        visible: root.active
        x: 24
        y: max(0, parent.height - 1)
        width: max(0, parent.width - 26)
        height: 1
        value: editor.col
        maximum: max(255, editor.col)
        page: max(1, editor.width)

    #: ``TInfoLine``: over the bottom frame, two columns in, as wide as it says.
    InfoLine:
        id: info
        visible: root.active
        x: 2
        y: max(0, parent.height - 1)
        width: min(len(editor.info_text), max(0, parent.width - 4))
        height: 1
        text: editor.info_text

    #: DOS Navigator's ``dlgEditorMenu`` (``DN.DNR``), every entry in the
    #: original's order with the original's captions and keys -- but as one
    #: *Editor* entry on the main bar, after *File*, while this window is the
    #: active one, rather than as a bar of its own inside the window
    #: (``TEditWindow.Init``).  Its seven menus would not fit beside the main
    #: bar's, and *File*, *Options* and four of its letters are the main bar's
    #: already, so they are submenus here.  *Main menu* (F10) is left out: the
    #: menu it would open is the one it is in.
    #:
    #: An entry names a command once the editor can do it and is greyed until
    #: then, as in ``main_menu.nml``.  DN showed each option's ``Off``/``On``
    #: in the key column; a ticked entry will say it once the option exists.
    #: *ASCII Table* is *Character table*, a departure: DN's was CP437's 256
    #: bytes, and the text here is Unicode.
    SubMenu:
        id: edit_menu
        text: '~E~ditor'
        after: 'File'
        SubMenu:
            id: edit_menu_file
            text: '~F~ile'
            MenuItem:
                text: '~O~pen...'
                command: LoadText
                key: 'F3'
            MenuItem:
                text: '~S~ave'
                command: SaveText
                key: 'F2'
            MenuItem:
                text: 'Save ~a~s...'
                command: SaveTextAs
                key: 'Shift-F2'
            MenuItem:
                text: 'Save a~l~l...'
                command: SaveAll
                key: 'Ctrl-F2'
            MenuLine:
            MenuItem:
                text: '~P~rint'
                command: PrintFile
                key: 'F8'
            MenuItem:
                text: 'Print ~b~lock'
                command: PrintBlock
                key: 'Shift-F8'
            MenuLine:
            MenuItem:
                text: 'E~x~it'
                command: CloseWindow
                key: 'Ctrl-F4'
        SubMenu:
            id: edit_menu_edit
            text: '~E~dit'
            MenuItem:
                text: '~U~ndo'
                command: Undo
                key: 'Alt-BkSp'
            MenuLine:
            MenuItem:
                text: 'Cu~t~'
                command: ClipboardCut
                key: 'Shift-Del'
            MenuItem:
                text: '~C~opy'
                command: ClipboardCopy
                key: 'Ctrl-Ins'
            MenuItem:
                text: '~P~aste'
                command: ClipboardPaste
                key: 'Shift-Ins'
            MenuItem:
                text: 'C~o~py to...'
                command: BlockWrite
            MenuItem:
                text: 'P~a~ste from...'
                command: BlockRead
            MenuLine:
            MenuItem:
                text: 'C~l~ear'
                command: Clear
                key: 'Ctrl-Del'
        SubMenu:
            id: edit_menu_search
            text: '~S~earch'
            MenuItem:
                text: '~F~ind...'
                command: StartSearch
                key: 'F7'
            MenuItem:
                text: '~R~eplace...'
                command: Replace
                key: 'Ctrl-F7'
            MenuItem:
                text: '~S~earch again'
                command: ContSearch
                key: 'Shift-F7'
            MenuItem:
                text: 'Re~v~ersed search'
                command: ReverseSearch
                key: 'Alt-F7'
            MenuItem:
                text: '~G~o to line number...'
                command: GotoLineNumber
                key: 'Alt-G'
        SubMenu:
            id: edit_menu_paragraph
            text: '~P~aragraph'
            MenuItem:
                text: '~J~ustify'
                command: FJustify
                key: 'Alt-J'
            MenuItem:
                text: '~R~ight'
                command: FRight
                key: 'Alt-R'
            MenuItem:
                text: '~L~eft'
                command: FLeft
                key: 'Alt-L'
            MenuItem:
                text: '~C~enter'
                command: FCenter
                key: 'Alt-C'
            MenuLine:
            MenuItem:
                text: '~M~argins...'
                command: SetMargins
        SubMenu:
            id: edit_menu_block
            text: '~B~lock'
            MenuItem:
                text: '~M~ove'
                command: MoveBlock
                key: 'Ctrl K V'
            MenuItem:
                text: '~C~opy'
                command: CopyBlock
                key: 'Ctrl K C'
            MenuItem:
                text: '~I~ndent'
                command: IndentBlock
                key: 'Ctrl K I'
            MenuItem:
                text: '~U~nindent'
                command: UnindentBlock
                key: 'Ctrl K U'
            MenuLine:
            MenuItem:
                text: 'U~p~percase'
                command: UpcaseBlock
                key: 'Ctrl K ['
            MenuItem:
                text: '~L~owercase'
                command: LowcaseBlock
                key: 'Ctrl K ]'
            MenuItem:
                text: 'Capi~t~alize'
                command: CapitalizeBlock
                key: 'Ctrl K \\'
            MenuLine:
            MenuItem:
                text: '~S~ort'
                command: SortBlock
                key: 'Alt-T'
            MenuItem:
                text: 'Calc~u~late sum'
                command: CalcBlock
                key: 'Alt-Ins'
        SubMenu:
            id: edit_menu_misc
            text: '~M~isc'
            MenuItem:
                text: 'Insert ~d~ate'
                command: InsertDate
                key: 'Ctrl Q D'
            MenuItem:
                text: 'Insert ~t~ime'
                command: InsertTime
                key: 'Ctrl Q T'
            MenuItem:
                text: 'Du~p~licate line'
                command: DuplicateLine
                key: 'F6'
            MenuItem:
                text: 'Character ta~b~le'
                command: AsciiTable
                key: 'Ctrl P'
            MenuItem:
                text: 'Line Dra~w~ing'
                command: SwitchDrawMode
                key: 'F4'
            MenuLine:
            SubMenu:
                id: edit_menu_misc_uppercase
                text: '~U~ppercase'
                MenuItem:
                    text: '~W~ord'
                    command: UpWord
                    key: 'Ctrl ['
                MenuItem:
                    text: '~L~ine'
                    command: UpString
                    key: 'Ctrl+Shift ['
                MenuItem:
                    text: '~B~lock'
                    command: UpcaseBlock
                    key: 'Ctrl K ['
            SubMenu:
                id: edit_menu_misc_lowercase
                text: '~L~owercase'
                MenuItem:
                    text: '~W~ord'
                    command: LowWord
                    key: 'Ctrl ]'
                MenuItem:
                    text: '~L~ine'
                    command: LowString
                    key: 'Ctrl+Shift ]'
                MenuItem:
                    text: '~B~lock'
                    command: LowcaseBlock
                    key: 'Ctrl K ]'
            SubMenu:
                id: edit_menu_misc_capitalize
                text: '~C~apitalize'
                MenuItem:
                    text: '~W~ord'
                    command: CapWord
                    key: 'Ctrl \\'
                MenuItem:
                    text: '~L~ine'
                    command: CapString
                    key: 'Ctrl+Shift \\'
                MenuItem:
                    text: '~B~lock'
                    command: CapitalizeBlock
                    key: 'Ctrl K \\'
        SubMenu:
            id: edit_menu_options
            text: '~O~ptions'
            MenuItem:
                text: '~B~ackspace indents'
                command: SwitchBack
            MenuItem:
                text: 'AutoB~r~ackets'
                command: SwitchBrackets
            MenuItem:
                text: 'Auto~i~ndent'
                command: SwitchIndent
            MenuItem:
                text: '~A~uto wrap'
                command: SwitchSave
            MenuItem:
                text: '~J~ustify on wrap'
                command: SwitchWrap
            MenuItem:
                text: '~V~ertical blocks'
                command: SwitchBlock
            MenuItem:
                text: 'Opti~m~al fill'
                command: SwitchFill
            MenuItem:
                text: 'Current ~l~ine highlight'
                command: SwitchHiLine
            MenuItem:
                text: 'Current ~c~olumn highlight'
                command: SwitchHiColumn
            MenuItem:
                text: 'Syntax ~h~ighlight'
                command: SwitchHighLight
            #: Filled from ``highlight.FILE_TYPES`` by ``file_type_menu``.
            SubMenu:
                id: edit_menu_file_type
                text: '~F~ile type'
                key_command: ChooseFileType
