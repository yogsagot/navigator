from navigator.widgets.game.commands import GameSetup, LevelUp, NewGame, PauseGame, ShowTopTen, TogglePreview
from navigator.widgets.game.game_window.glass import Glass
from navigator.widgets.game.game_window.info import GameInfo
from navml.commands import CloseWindow
from navml.widgets.dialog.button import Button
from navml.widgets.dialog.button_row import ButtonRow
from navml.widgets.menu.menu_item import MenuItem
from navml.widgets.menu.menu_line import MenuLine
from navml.widgets.menu.sub_menu import SubMenu
from navml.widgets.window import Window

#: ≡ > Game: DOS Navigator's ``TGameWindow``, *Navigator's game*.
#:
#: A dialog DN put on the desktop as a window, one at a time: the glass down
#: the left, *Info* with *Next* and *Best* beside it, and *New*, *Setup*,
#: *Top 10* and *Pause* under them, where ``TGameWindow.Init`` put them --
#: the glass's frame on the window's bottom edge, as its rectangles put it
#: there in DN.  Its keys are ``StatusDef hcTetris``'s.
GameWindow(Window):
    title: "Navigator's game"
    zoomable: False
    resizable: False

    keys:
        escape: CloseWindow
        f2: NewGame
        f3: PauseGame
        f4: ShowTopTen
        f5: GameSetup
        kp_plus: LevelUp
        kp_multiply: TogglePreview
        alt+n: NewGame
        alt+p: PauseGame
        alt+t: ShowTopTen
        alt+s: GameSetup

    #: The commands this component handles itself.
    commands:
        ShowTopTen: root.spawn(root.show_scores())
        GameSetup: root.spawn(root.setup())

    Glass:
        id: glass
        x: 1
        y: 1
        width: 26
        height: 21

    GameInfo:
        id: info
        x: 28
        y: 1
        width: 23
        height: 15

    ButtonRow:
        justify: "start"
        spacing: 0
        y: 17
        anchors:
            left: 28
            right: 0

        Button:
            id: new_button
            text: "~N~ew"
            command: NewGame

        Button:
            id: setup_button
            text: "~S~etup"
            command: GameSetup

    ButtonRow:
        justify: "start"
        spacing: 0
        y: 19
        anchors:
            left: 28
            right: 0

        Button:
            id: top_button
            text: "~T~op 10"
            command: ShowTopTen

        Button:
            id: pause_button
            text: "~P~ause"
            command: PauseGame

    #: The window's own menu on the bar after *File* while it is active -- a
    #: departure, asked for: DN had its status line, whose ``~+~ Level`` and
    #: ``~*~ Preview`` our key bar of function keys does not show.  *Pause*
    #: and *Preview* are ticked while on.  Also its right-click menu.
    SubMenu: text='~G~ame', after='File'
        id: game_menu
        tooltip: "A new game, pause, the Top Ten and setup"
        MenuItem: text='~N~ew', command=NewGame
        MenuItem: text='~P~ause', command=PauseGame
        MenuItem: text='~T~op 10', command=ShowTopTen
        MenuItem: text='~S~etup', command=GameSetup
        MenuLine:
        MenuItem: text='~L~evel up', command=LevelUp
            tooltip: "Play at the next level, faster"
        MenuItem: text='Pre~v~iew', command=TogglePreview
            tooltip: "Show the next figure"
        MenuLine:
        MenuItem: text='~C~lose', command=CloseWindow
