from navml.widgets.dialog.button import Button
from navml.widgets.dialog.button_row import ButtonRow
from navml.widgets.dialog.commands import Help
from navml.widgets.dialog.dialog import Dialog
from navml.widgets.dialog.field import Field

#: DOS Navigator's ``dlgTetrisWinner``: a name for the Top Ten, its history
#: ``hsTetris``.  A row taller than DN's 50 by 7, for this library's
#: buttons.
WinnerDialog(Dialog):
    modal_width: 50
    modal_height: 8
    title: "You have entered Top Ten!"
    help_topic: "game.md#the-top-ten"
    buttons: "none"

    buttons_row: (pick, abandon, helper)

    Field:
        id: player
        y: 2
        anchors:
            left: 2
            right: 2
        label_text: "Enter your name:"
        label_width: 18
        history_id: "tetris"

    #: ``dlgTetrisWinner``'s own row: OK, Cancel and Help ten wide from column 17.
    ButtonRow:
        justify: "start"
        button_width: 10
        spacing: 0
        anchors:
            left: 17
            right: 0
            bottom: 2

        Button:
            id: pick
            text: "O~K~"
            default: True

        Button:
            id: abandon
            text: "Cancel"

        #: ``cmHelp``: asks as F1 does, for ``help_topic`` above.
        Button:
            id: helper
            text: "Help"
            command: Help
