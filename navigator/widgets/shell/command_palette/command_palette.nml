from navml.widgets.dialog.dialog import Dialog
from navml.widgets.dialog.input_line import InputLine
from navml.widgets.dialog.static_text import StaticText
from navigator.widgets.shell.command_palette.command_list import CommandList

#: ≡ > *Command palette* (Alt+Shift+P): every command that applies where the
#: keyboard was -- the menus' items, the active window's own menus among
#: them, and the commands keys are bound to there that no menu holds -- each
#: with its key, greyed when it cannot run.  The line across the top narrows
#: them by a few of their letters, in order (``navml.fuzzy``); Enter runs the
#: one under the cursor.  Not DOS Navigator's (a departure, asked for).
#:
#: ``Dialog``'s own row of buttons and its message are not this layout, and
#: the hand-written half hides them.
CommandPalette(Dialog):
    modal_width: max(40, min(parent.width - 4, 72)) if parent is not None else 72
    modal_height: max(10, min(parent.height - 2, 22)) if parent is not None else 22
    title: "Commands"
    close_on_outside_click: True

    InputLine:
        id: filter
        x: 2
        y: 2
        width: max(1, parent.width - 4)
        height: 1

    CommandList:
        id: results
        x: 2
        y: 3
        width: max(1, parent.width - 4)
        height: max(3, parent.height - 6)

    #: Where the command under the cursor is in the menus, or why it cannot
    #: run here.
    StaticText:
        id: hint
        x: 2
        y: max(0, parent.height - 3)
        width: max(0, parent.width - 4)
        height: 1
