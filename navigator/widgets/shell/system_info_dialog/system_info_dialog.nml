from navml.widgets.dialog.dialog import Dialog
from navml.widgets.dialog.group_box import GroupBox
from navml.widgets.dialog.static_text import StaticText

#: Utilities > System Information: DOS Navigator's ``SystemInfo`` dialog.
#:
#: Its 70 by 22 and its four ``ofFramed`` boxes, each titled on its frame --
#: *Main board* across the top, *Disk drives* under it, *Memory* and *Other*
#: side by side at the foot -- filled with Linux's answers
#: (:mod:`navigator.lib.system.sysinfo`); OK alone, centred.
SystemInfoDialog(Dialog):
    modal_width: 70
    modal_height: 22
    title: "System Information"
    buttons: "ok"

    GroupBox:
        id: board_box
        x: 3
        y: 1
        width: 64
        height: 5
        title: "Main board"

        StaticText:
            id: board
            anchors:
                left: 2
                right: 2
                top: 1
                bottom: 1

    GroupBox:
        id: disks_box
        x: 3
        y: 6
        width: 64
        height: 6
        title: "Disk drives"

        StaticText:
            id: disks
            anchors:
                left: 2
                right: 2
                top: 1
                bottom: 1

    GroupBox:
        id: memory_box
        x: 3
        y: 12
        width: 26
        height: 6
        title: "Memory"

        StaticText:
            id: memory
            anchors:
                left: 2
                right: 2
                top: 1
                bottom: 1

    GroupBox:
        id: other_box
        x: 30
        y: 12
        width: 37
        height: 6
        title: "Other"

        StaticText:
            id: other
            anchors:
                left: 2
                right: 2
                top: 1
                bottom: 1
