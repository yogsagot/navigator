from navml.widgets.dialog.dialog import Dialog
from navml.widgets.dialog.group_box import GroupBox
from navml.widgets.dialog.static_text import StaticText

#: Utilities > System Information: DOS Navigator's ``SystemInfo`` dialog.
#:
#: Its 70 by 22 and its four ``ofFramed`` boxes, each titled on its frame --
#: *Main board* across the top, *Disk drives* under it, *Memory* and *Other*
#: side by side at the foot -- filled with Linux's answers
#: (:mod:`navigator.sysinfo`); OK alone, centred.
SystemInfoDialog(Dialog):
    modal_width: 70
    modal_height: 22
    title: "System Information"
    buttons: "ok"

    GroupBox:
        id: board_box
        x: 3
        y: 1
        width: 64
        height: 5
        title: "Main board"

        StaticText:
            id: board
            x: 2
            y: 1
            width: max(0, parent.width - 4)
            height: max(0, parent.height - 2)

    GroupBox:
        id: disks_box
        x: 3
        y: 6
        width: 64
        height: 6
        title: "Disk drives"

        StaticText:
            id: disks
            x: 2
            y: 1
            width: max(0, parent.width - 4)
            height: max(0, parent.height - 2)

    GroupBox:
        id: memory_box
        x: 3
        y: 12
        width: 26
        height: 6
        title: "Memory"

        StaticText:
            id: memory
            x: 2
            y: 1
            width: max(0, parent.width - 4)
            height: max(0, parent.height - 2)

    GroupBox:
        id: other_box
        x: 30
        y: 12
        width: 37
        height: 6
        title: "Other"

        StaticText:
            id: other
            x: 2
            y: 1
            width: max(0, parent.width - 4)
            height: max(0, parent.height - 2)
