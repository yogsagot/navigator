            MenuItem:
                text: 'AR~J~ - ARJ (C) Robert K. Jung'
            MenuItem:
                text: '~B~SA - BSArc v1.xx (C) PhysTechSoft'
            MenuItem:
                text: 'BS~2~ - BSArc v2.xx (C) PhysTechSoft'
            MenuItem:
                text: '~C~HZ - ChArc (C) Dialogue'
            MenuItem:
