from navigator.commands import About, Calculator, ChangeAttributes, Copy, Delete, DeleteSingle, Edit, MakeDirectory, MakeLink, NewManager, OpenTreeWindow, Quit, RenameMove, ToggleConsole, UserMenu, View, ViewAsHex, ViewAsText
from navml.commands import CascadeWindows, CloseAllWindows, CloseWindow, NextWindow, PreviousWindow, SizeMoveWindow, TileWindows, WindowManager, ZoomWindow
from navml.widgets.menu.menu_bar import MenuBar
from navml.widgets.menu.menu_item import MenuItem
from navml.widgets.menu.menu_line import MenuLine
from navml.widgets.menu.sub_menu import SubMenu

#: DOS Navigator 1.51's main menu, transcribed from ``dlgMainMenu`` in
#: ``RESOURCE/ENGLISH/DN.DNR`` -- every entry, in the original's order and
#: with the original's captions and hotkeys.
#:
#: Every submenu carries an ``id``, which is how Python reaches it: an id is
#: an attribute of the document's class, so a plugin adds to the File menu
#: with ``app.shell.menu.file.add_item(...)``.  A nested submenu's id is its
#: parent's joined to its own -- ``file_view``, ``options_configuration`` --
#: because an id is unique across the whole document.
#:
#: An entry names a ``command`` once the feature behind it exists, and is
#: greyed until then: an entry with no command is one nobody can run, the
#: same rule as a command nobody handles.  ``key`` is the original's caption
#: for the entry's key, shown while no key table binds the command; a bound
#: key is read off the binding instead.  Giving a feature its entry is one
#: ``command:`` line here.
#:
#: **Panel is not here**: it acts on a file manager's panels and nothing else,
#: so it is the file manager's own menu (``manager.nml``), on the bar only
#: while one is the active window.  Manager stays, because *New* has to be
#: reachable with no file manager open.  Its *Directory tree*, *Info* and
#: *Quick view* went with Panel -- a departure from ``dlgMainMenu``: they put
#: something in the passive panel's place, which is a panel's business.
MainMenu(MenuBar):
    SubMenu:
        id: system
        text: '~≡~'
        MenuItem:
            text: '~A~bout...'
            command: About
        MenuItem:
            text: '~R~efresh display'
        MenuItem:
            text: '~S~creen rest'
        MenuLine:
        MenuItem:
            text: 'Screen gra~b~ber'
            key: 'Shift-Alt-Ins'
        MenuItem:
            text: '~U~ser screen'
            key: 'Alt-F5'
        MenuItem:
            text: '~O~utput window'
            command: ToggleConsole
            key: 'Ctrl-O'
        MenuItem:
            text: 'S~m~artPad (TM)'
            key: 'Alt-Q'
        MenuItem:
            text: '~T~rashcan on/off'
        MenuLine:
        MenuItem:
            text: '~E~GA/VGA lines'
            key: 'Shift-F10'
        MenuItem:
            text: 'Custom video mode ~1~'
            key: 'Alt-F10'
        MenuItem:
            text: 'Custom video mode ~2~'
            key: 'Ctrl-F10'
        MenuLine:
        MenuItem:
            text: '~G~ame'
            key: 'Alt-F9'
    SubMenu:
        id: file
        text: '~F~ile'
        SubMenu:
            id: file_view
            text: '~V~iew'
            MenuItem:
                text: '~A~s is'
                command: View
                key: 'F3'
            MenuItem:
                text: 'As ~T~ext'
                command: ViewAsText
            MenuItem:
                text: 'As He~x~'
                command: ViewAsHex
            MenuItem:
                text: 'As ~D~ataBase'
            MenuItem:
                text: 'As ~S~preadsheet'
            MenuLine:
            MenuItem:
                text: 'Alternate vie~w~'
                key: 'Alt-F3'
        SubMenu:
            id: file_edit
            text: '~E~dit'
            MenuItem:
                text: '~E~dit'
                command: Edit
                key: 'F4'
            MenuItem:
                text: '~A~lternate edit'
                key: 'Alt-F4'
            MenuLine:
            MenuItem:
                text: 'Edit ~n~ew file...'
                key: 'Shift-F4'
        MenuItem:
            text: '~F~ind...'
            key: 'Alt-F7'
        MenuItem:
            text: '~C~opy...'
            command: Copy
            key: 'F5'
        MenuItem:
            text: '~R~ename/Move...'
            command: RenameMove
            key: 'F6'
        MenuItem:
            text: 'Cop~y~ to archive...'
            key: 'Shift-F1'
        MenuItem:
            text: 'Ex~t~ract archive...'
            key: 'Shift-F2'
        MenuItem:
            text: 'Create ~s~ymlink...'
            command: MakeLink
            key: 'Shift-F5'
        MenuItem:
            text: '~P~rint'
            key: 'Ctrl-F9'
        MenuItem:
            text: '~M~ake directory'
            command: MakeDirectory
            key: 'F7'
        MenuItem:
            text: '~D~elete'
            command: Delete
            key: 'F8'
        MenuItem:
            text: 'File ~A~ttributes...'
            command: ChangeAttributes
            key: 'Alt-E'
        MenuItem:
            text: 'UU E~n~code...'
            key: 'Ctrl-F7'
        MenuItem:
            text: '~U~U Decode...'
            key: 'Ctrl-F8'
        MenuItem:
            text: 'Unpack diskette images'
            key: 'Ctrl-I'
        MenuItem:
            text: 'Delete single file'
            command: DeleteSingle
            key: 'Shift-Del'
        MenuLine:
        MenuItem:
            text: 'Execute ~O~S command'
        MenuItem:
            text: 'E~x~it'
            command: Quit
            key: 'Alt-X'
    SubMenu:
        id: disk
        text: '~D~isk'
        MenuItem:
            text: '~F~ormat disk...'
            key: 'Shift-F7'
        MenuItem:
            text: '~V~olume label...'
        MenuItem:
            text: '~R~eanimator...'
            key: 'Shift-F6'
        MenuItem:
            text: 'Disk ~e~ditor'
        MenuItem:
            text: '~D~irectory tree'
            command: OpenTreeWindow
    SubMenu:
        id: utilities
        text: '~U~tilities'
        MenuItem:
            text: '~M~emory Information'
            key: 'Alt-Y'
        MenuItem:
            text: 'S~y~stem Information'
        MenuLine:
        MenuItem:
            text: '~C~alculator'
            command: Calculator
            key: 'Ctrl-F6'
        MenuItem:
            text: 'ASCII Ta~b~le'
            key: 'Ctrl-B'
        MenuItem:
            text: '~P~hone Book'
            key: 'Shift-F3'
        MenuItem:
            text: '~O~pen spreadsheet'
            key: 'Shift-F11'
        MenuItem:
            text: 'C~D~ Player'
            key: 'Ctrl-F11'
        MenuLine:
        MenuItem:
            text: 'Te~r~minal'
            key: 'Alt-J'
        MenuItem:
            text: 'Navigator ~L~ink'
            key: 'Alt-F11'
        MenuItem:
            text: 'Manual di~a~l...'
            key: 'Alt-A'
        MenuItem:
            text: 'Di~s~connect'
            key: 'Alt-H'
        MenuLine:
        MenuItem:
            text: 'Edi~t~ DOS Environment'
        MenuItem:
            text: '~U~ser menu'
            command: UserMenu
            key: 'F2'
        MenuItem:
            text: 'Commands ~H~istory'
            key: 'Alt-F8'
        MenuItem:
            text: 'File ~E~dit History'
            key: 'Alt-PgUp'
        MenuItem:
            text: 'File ~V~iew History'
            key: 'Alt-PgDn'
    SubMenu:
        id: manager
        text: '~M~anager'
        MenuItem:
            text: '~N~ew'
            command: NewManager
            key: 'Ctrl-F3'
        MenuItem:
            text: '~S~wap panels'
            key: 'Ctrl-U'
        MenuItem:
            text: 'Show/hide ~l~eft panel'
            key: 'Ctrl-F1'
        MenuItem:
            text: 'Show/hide ~r~ight panel'
            key: 'Ctrl-F2'
        MenuItem:
            text: 'Show/hide inactive ~p~anel'
            key: 'Ctrl-P'
        MenuLine:
        MenuItem:
            text: 'Change drive le~f~t'
            key: 'Alt-F1'
        MenuItem:
            text: 'Change drive rig~h~t'
            key: 'Alt-F2'
    SubMenu:
        id: options
        text: '~O~ptions'
        SubMenu:
            id: options_configuration
            text: '~C~onfiguration'
            MenuItem:
                text: 'S~y~stem Setup...'
            MenuItem:
                text: '~S~tartup...'
            MenuItem:
                text: '~I~nterface...'
            MenuItem:
                text: '~C~onfirmations...'
            MenuLine:
            MenuItem:
                text: 'Screen sa~v~ers...'
            MenuItem:
                text: 'P~r~inter setup...'
            MenuItem:
                text: 'C~o~untry support...'
            MenuItem:
                text: '~M~ouse...'
            MenuItem:
                text: 'Comm~u~nications...'
            MenuLine:
            MenuItem:
                text: '~E~ditor/Viewer...'
            MenuItem:
                text: '~T~erminal...'
        SubMenu:
            id: options_file_manager
            text: '~F~ile Manager'
            MenuItem:
                text: '~S~etup...'
            MenuItem:
                text: '~I~nformation panel...'
            MenuItem:
                text: 'New Manager ~d~efaults...'
            MenuItem:
                text: '~C~olumn defaults...'
            MenuItem:
                text: '~H~ighlight groups...'
        SubMenu:
