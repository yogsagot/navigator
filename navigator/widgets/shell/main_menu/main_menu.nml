        MenuLine:
        MenuItem:
            text: '~Q~uick run file edit...'
        MenuItem:
            text: 'E~x~tension file edit...'
        MenuItem:
            text: '~H~ighlight file edit...'
        MenuItem:
            text: '~G~lobal menu definition...'
        MenuItem:
            text: 'Local ~m~enu definition...'
        MenuItem:
            text: '~V~iewers...'
        MenuItem:
            text: '~E~ditors...'
        MenuLine:
        MenuItem:
            text: '~S~ave desktop'
        MenuItem:
            text: '~L~oad desktop'
        MenuLine:
        MenuItem:
            text: 'C~o~lors...'
        MenuItem:
