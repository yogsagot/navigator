from navigator.commands import AsciiTable, OpenSmartpad, Quit, ToggleConsole
from navigator.widgets.manager.commands import Calculator, ChangeAttributes, ChangeLeft, ChangeRight, Copy, Delete, DeleteSingle, Edit, EditNamed, FindFile, HideInactive, HideLeft, HideRight, MakeDirectory, MakeLink, RenameMove, SwapPanels, UserMenu, View, ViewAsHex, ViewAsText
from navigator.widgets.shell.commands import About, DriveInfoSetup, EditHistory, EditorDefaults, FileManagerDefaults, FileManagerSetup, InterfaceSetup, LocalMenuFileEdit, MenuFileEdit, NewManager, OpenTreeWindow, SetupConfirmation, StartupSetup, SystemSetup, ViewHistory
from navml.commands import CascadeWindows, CloseAllWindows, CloseWindow, NextWindow, PreviousWindow, SizeMoveWindow, TileWindows, WindowManager, ZoomWindow
from navml.widgets.menu.menu_bar import MenuBar
from navml.widgets.menu.menu_item import MenuItem
from navml.widgets.menu.menu_line import MenuLine
from navml.widgets.menu.sub_menu import SubMenu

#: DOS Navigator 1.51's main menu, transcribed from ``dlgMainMenu`` in
#: ``RESOURCE/ENGLISH/DN.DNR`` -- every entry that has a POSIX meaning, in
#: the original's order and with the original's captions and hotkeys.
#:
#: Every submenu carries an ``id``, which is how Python reaches it: an id is
#: an attribute of the document's class, so a plugin adds to the File menu
#: with ``app.shell.menu.file.add_item(...)``.  A nested submenu's id is its
#: parent's joined to its own -- ``file_view``, ``options_configuration`` --
#: because an id is unique across the whole document.
#:
#: An entry names a ``command`` once the feature behind it exists, and is
#: greyed until then: an entry with no command is one nobody can run, the
#: same rule as a command nobody handles.  ``key`` is the original's caption
#: for the entry's key, shown while no key table binds the command; a bound
#: key is read off the binding instead.  Giving a feature its entry is one
#: ``command:`` line here.
#:
#: **Panel is not here**: it acts on a file manager's panels and nothing else,
#: so it is the file manager's own menu (``manager.nml``), on the bar only
#: while one is the active window.  Manager stays, because *New* has to be
#: reachable with no file manager open.  Its *Directory tree*, *Info* and
#: *Quick view* went with Panel -- a departure from ``dlgMainMenu``: they put
#: something in the passive panel's place, which is a panel's business.
#:
#: **What only meant something on DOS is not here either**, a departure from
#: the rule that an entry with no feature yet stays greyed: some can never
#: have one on POSIX.  Gone are *EGA/VGA lines* and the two *Custom video
#: modes*; *View as Spreadsheet* and *Unpack diskette images* (DN's own
#: formats); *Format disk*, *Volume label*, *Reanimator* (FAT undelete) and
#: *Disk editor* (sectors); *Memory Information* (conventional/XMS/EMS),
#: *Phone Book*, *Open spreadsheet*, *CD Player*, and the modem's *Terminal*,
#: *Navigator Link*, *Manual dial* and *Disconnect*; *Printer setup*,
#: *Country support*, *Mouse*, *Communications* and *Terminal* under
#: Configuration; and the seventeen DOS archivers under Archives, which a list
#: of POSIX ones replaces once archives can be opened.  Two captions say what
#: they mean here: *ASCII Table* is *Character table*, and *Edit DOS
#: Environment* is *Edit environment*.  *Change drive left/right* are
#: *Bookmarks left/right*: the box they open lists bookmarked directories
#: where DN's listed drive letters (``navigator/bookmarks.py``).
MainMenu(MenuBar):
    SubMenu:
        id: system
        text: '~≡~'
        MenuItem:
            text: '~A~bout...'
            command: About
        MenuItem:
            text: '~R~efresh display'
        MenuItem:
            text: '~S~creen rest'
        MenuLine:
        MenuItem:
            text: 'Screen gra~b~ber'
            key: 'Shift-Alt-Ins'
        MenuItem:
            text: '~U~ser screen'
            key: 'Alt-F5'
        MenuItem:
            text: '~O~utput window'
            command: ToggleConsole
            key: 'Ctrl-O'
        MenuItem:
            text: 'S~m~artPad (TM)'
            command: OpenSmartpad
            key: 'Alt-Q'
        MenuItem:
            text: '~T~rashcan on/off'
        MenuLine:
        MenuItem:
            text: '~G~ame'
            key: 'Alt-F9'
    SubMenu:
        id: file
        text: '~F~ile'
        SubMenu:
            id: file_view
            text: '~V~iew'
            MenuItem:
                text: '~A~s is'
                command: View
                key: 'F3'
            MenuItem:
                text: 'As ~T~ext'
                command: ViewAsText
            MenuItem:
                text: 'As He~x~'
                command: ViewAsHex
            MenuItem:
                text: 'As ~D~ataBase'
            MenuLine:
            MenuItem:
                text: 'Alternate vie~w~'
                key: 'Alt-F3'
        SubMenu:
            id: file_edit
            text: '~E~dit'
            MenuItem:
                text: '~E~dit'
                command: Edit
                key: 'F4'
            MenuItem:
                text: '~A~lternate edit'
                key: 'Alt-F4'
            MenuLine:
            MenuItem:
                text: 'Edit ~n~ew file...'
                command: EditNamed
                key: 'Shift-F4'
        MenuItem:
            text: '~F~ind...'
            command: FindFile
            key: 'Alt-F7'
        MenuItem:
            text: '~C~opy...'
            command: Copy
            key: 'F5'
        MenuItem:
            text: '~R~ename/Move...'
            command: RenameMove
            key: 'F6'
        MenuItem:
            text: 'Cop~y~ to archive...'
            key: 'Shift-F1'
        MenuItem:
            text: 'Ex~t~ract archive...'
            key: 'Shift-F2'
        MenuItem:
            text: 'Create ~s~ymlink...'
            command: MakeLink
            key: 'Shift-F5'
        MenuItem:
            text: '~P~rint'
            key: 'Ctrl-F9'
        MenuItem:
            text: '~M~ake directory'
            command: MakeDirectory
            key: 'F7'
        MenuItem:
            text: '~D~elete'
            command: Delete
            key: 'F8'
        MenuItem:
            text: 'File ~A~ttributes...'
            command: ChangeAttributes
            key: 'Alt-E'
        MenuItem:
            text: 'UU E~n~code...'
            key: 'Ctrl-F7'
        MenuItem:
            text: '~U~U Decode...'
            key: 'Ctrl-F8'
        MenuItem:
            text: 'Delete single file'
            command: DeleteSingle
            key: 'Shift-Del'
        MenuLine:
        MenuItem:
            text: 'Execute ~O~S command'
        MenuItem:
            text: 'E~x~it'
            command: Quit
            key: 'Alt-X'
    SubMenu:
        id: disk
        text: '~D~isk'
        MenuItem:
            text: '~D~irectory tree'
            command: OpenTreeWindow
    SubMenu:
        id: utilities
        text: '~U~tilities'
        MenuItem:
            text: 'S~y~stem Information'
        MenuLine:
        MenuItem:
            text: '~C~alculator'
            command: Calculator
            key: 'Ctrl-F6'
        MenuItem:
            text: 'Character ta~b~le'
            command: AsciiTable
            key: 'Ctrl-B'
        MenuLine:
        MenuItem:
            text: 'Edi~t~ environment'
        MenuItem:
            text: '~U~ser menu'
            command: UserMenu
            key: 'F2'
        MenuItem:
            text: 'Commands ~H~istory'
            key: 'Alt-F8'
        MenuItem:
            text: 'File ~E~dit History'
            command: EditHistory
            key: 'Alt-PgUp'
        MenuItem:
            text: 'File ~V~iew History'
            command: ViewHistory
            key: 'Alt-PgDn'
    SubMenu:
        id: manager
        text: '~M~anager'
        MenuItem:
            text: '~N~ew'
            command: NewManager
            key: 'Ctrl-F3'
        MenuItem:
            text: '~S~wap panels'
            command: SwapPanels
            key: 'Ctrl-U'
        MenuItem:
            text: 'Show/hide ~l~eft panel'
            command: HideLeft
            key: 'Ctrl-F1'
        MenuItem:
            text: 'Show/hide ~r~ight panel'
            command: HideRight
            key: 'Ctrl-F2'
        MenuItem:
            text: 'Show/hide inactive ~p~anel'
            command: HideInactive
            key: 'Ctrl-P'
        MenuLine:
        MenuItem:
            text: 'Bookmarks le~f~t'
            command: ChangeLeft
            key: 'Alt-F1'
        MenuItem:
            text: 'Bookmarks rig~h~t'
            command: ChangeRight
            key: 'Alt-F2'
    SubMenu:
        id: options
        text: '~O~ptions'
        SubMenu:
            id: options_configuration
            text: '~C~onfiguration'
            MenuItem:
                text: 'S~y~stem Setup...'
                command: SystemSetup
            MenuItem:
                text: '~S~tartup...'
                command: StartupSetup
            MenuItem:
                text: '~I~nterface...'
                command: InterfaceSetup
            MenuItem:
                text: '~C~onfirmations...'
                command: SetupConfirmation
            MenuLine:
            MenuItem:
                text: 'Screen sa~v~ers...'
            MenuLine:
            MenuItem:
                text: '~E~ditor/Viewer...'
                command: EditorDefaults
        SubMenu:
            id: options_file_manager
            text: '~F~ile Manager'
            MenuItem:
                text: '~S~etup...'
                command: FileManagerSetup
            MenuItem:
                text: '~I~nformation panel...'
                command: DriveInfoSetup
            MenuItem:
                text: 'New Manager ~d~efaults...'
                command: FileManagerDefaults
            MenuItem:
                text: '~C~olumn defaults...'
            MenuItem:
                text: '~H~ighlight groups...'
        SubMenu:
            id: options_archives
            text: 'A~r~chives'
            MenuItem:
                text: 'Current archiver...'
                key: 'Alt-N'
        MenuLine:
        MenuItem:
            text: '~Q~uick run file edit...'
        MenuItem:
            text: 'E~x~tension file edit...'
        MenuItem:
            text: '~H~ighlight file edit...'
        MenuItem:
            text: '~G~lobal menu definition...'
            command: MenuFileEdit
        MenuItem:
            text: 'Local ~m~enu definition...'
            command: LocalMenuFileEdit
        MenuItem:
            text: '~V~iewers...'
        MenuItem:
            text: '~E~ditors...'
        MenuLine:
        MenuItem:
            text: '~S~ave desktop'
        MenuItem:
            text: '~L~oad desktop'
        MenuLine:
        MenuItem:
            text: 'C~o~lors...'
        MenuItem:
            text: 'S~t~ore palette'
        MenuItem:
            text: 'Lo~a~d palette'
    SubMenu:
        id: window
        text: '~W~indow'
        MenuItem:
            text: '~T~ile'
            command: TileWindows
        MenuItem:
            text: 'C~a~scade'
            command: CascadeWindows
        MenuItem:
            text: 'Cl~o~se all'
            command: CloseAllWindows
        MenuLine:
        MenuItem:
            text: '~S~ize/Move'
            command: SizeMoveWindow
            key: 'Ctrl-F5'
        MenuItem:
            text: '~Z~oom'
            command: ZoomWindow
            key: 'Alt-Z'
        MenuItem:
            text: '~N~ext'
            command: NextWindow
            key: 'Alt-Tab'
        MenuItem:
            text: '~P~revious'
            command: PreviousWindow
            key: 'Ctrl-Tab'
        MenuItem:
            text: '~C~lose'
            command: CloseWindow
            key: 'Ctrl-F4'
        MenuLine:
        MenuItem:
            text: '~L~ist...'
            command: WindowManager
            key: 'Alt-0'
