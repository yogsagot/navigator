from navigator.widgets.shell.command_history_dialog.history_list import HistoryList
from navml.widgets.dialog.button import Button
from navml.widgets.dialog.button_row import ButtonRow
from navml.widgets.dialog.dialog import Dialog

#: Alt+F8, Utilities > Commands History: DOS Navigator's ``dlgCommandsHistory``.
#:
#: The commands typed, the newest at the foot and the cursor on it, over
#: *Run*, *Drop*, *Edit*, *Kill* and *Cancel* where ``DN.DNR`` put them.
CommandHistoryDialog(Dialog):
    modal_width: 59
    modal_height: 17
    title: "Commands history"
    buttons: "none"

    HistoryList:
        id: commands
        framed: False
        x: 2
        y: 2
        width: 55
        height: 11

    #: ``cmOK``: the command on the line, and run.
    ButtonRow:
        justify: "start"
        button_width: 10
        spacing: 1
        y: 14
        anchors:
            left: 3
            right: 0

        Button:
            id: run
            text: "~R~un"
            default: True

        #: ``cmYes``: the command on the line, not run.
        Button:
            id: drop
            text: "~D~rop"

        #: ``cmOK`` broadcast to the list: the command edited in place.
        Button:
            id: edit
            text: "~E~dit"

        #: ``cmYes`` broadcast to the list: the command forgotten.
        Button:
            id: kill
            text: "~K~ill"

        Button:
            id: abandon
            text: "Cancel"
