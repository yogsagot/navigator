from navigator.widgets.manager.commands import Rescan
from navigator.widgets.shell.commands import KillProcess, ProcessDetails, ProcessMineOnly, ProcessSortCommand, ProcessSortCpu, ProcessSortMemory, ProcessSortPid, ProcessSortState, ProcessSortUser, ProcessTree, SignalProcess
from navigator.widgets.shell.process_list import ProcessList
from navml.commands import CloseWindow
from navml.widgets.dialog.button import Button
from navml.widgets.dialog.check_boxes import CheckBoxes
from navml.widgets.dialog.commands import QuickSearch, SelectNext, SelectPrevious
from navml.widgets.dialog.static_text import StaticText
from navml.widgets.menu.menu_item import MenuItem
from navml.widgets.menu.menu_line import MenuLine
from navml.widgets.menu.sub_menu import SubMenu
from navml.widgets.window import Window

#: Utilities > Process list: every running process -- its number, owner,
#: state, CPU share, resident memory and command -- a row each, read again
#: every ``[processes] refresh`` seconds.  **Not DOS Navigator's**: a
#: departure, asked for -- DOS ran one program at a time.  It is FAR
#: Manager's process panel, in a window as Disk > Volumes is;
#: ``navigator/lib/system/processes.py`` says how ``/proc`` is read.
#:
#: Laid out as Disk > Volumes is: the list without a frame of its own, one
#: column into the window's; under it the status line -- how many processes,
#: and what is being searched for -- then *Mine only* and *Tree* on the left,
#: *Signal*, *Kill*, *Details* and *Close* on the right.
#:
#: Ctrl+P, Ctrl+U, Ctrl+E, Ctrl+L, Ctrl+Z and Ctrl+N sort by number, user,
#: state, CPU (the load), memory (the size) and command (the name), as does a
#: click on a column's title; the same again turns the order round.  Not the
#: Ctrl+F keys FAR sorts a panel by: the desktop and the global table hold
#: them here.  Ctrl+T shows each process under its parent; Ctrl+H only the
#: user's own.  F3 tells what ``/proc`` says of the one under the cursor; F7
#: sends it a signal chosen from a box, F8 or Del asks it to end (SIGTERM).
#: A signal the user may not send is offered *As root*, through the root
#: helper's ``kill``.  Ctrl+S, or typing, searches.  Esc closes the window;
#: Ctrl+R and Alt+R read again at once.
ProcessWindow(Window):
    title: "Process list"

    keys:
        escape: CloseWindow
        ctrl+r: Rescan
        alt+r: Rescan
        ctrl+p: ProcessSortPid
        ctrl+u: ProcessSortUser
        ctrl+e: ProcessSortState
        ctrl+l: ProcessSortCpu
        ctrl+z: ProcessSortMemory
        ctrl+n: ProcessSortCommand
        ctrl+t: ProcessTree
        ctrl+h: ProcessMineOnly
        f3: ProcessDetails
        f7: SignalProcess
        f8: KillProcess
        delete: KillProcess
        tab: SelectNext
        shift+tab: SelectPrevious

    ProcessList:
        id: processes
        framed: False
        x: 1
        y: 1
        width: max(0, parent.width - 1)
        height: max(0, parent.height - 5)

    StaticText:
        id: status
        x: 2
        y: max(0, parent.height - 4)
        width: max(0, parent.width - 4)
        height: 1

    CheckBoxes:
        id: mine_box
        x: 2
        y: max(0, parent.height - 3)
        width: 16
        height: 1
        items: ["~M~ine only"]
        tooltips: ["Only your own processes"]

    CheckBoxes:
        id: tree_box
        x: 2
        y: max(0, parent.height - 2)
        width: 16
        height: 1
        items: ["~T~ree"]
        tooltips: ["Each process under its parent"]

    Button:
        id: signal_button
        text: "~S~ignal"
        x: max(0, parent.width - 47)
        y: max(0, parent.height - 3)
        width: 11
        height: 2
        disabled: not root.allows("signal")

    Button:
        id: kill_button
        text: "~K~ill"
        x: max(0, parent.width - 35)
        y: max(0, parent.height - 3)
        width: 9
        height: 2
        disabled: not root.allows("signal")

    Button:
        id: details_button
        text: "~D~etails"
        default: True
        x: max(0, parent.width - 25)
        y: max(0, parent.height - 3)
        width: 12
        height: 2
        disabled: not root.allows("details")

    Button:
        id: close_button
        text: "Close"
        x: max(0, parent.width - 12)
        y: max(0, parent.height - 3)
        width: 10
        height: 2

    #: The window's own menu on the bar after *File* while it is active, as
    #: Disk > Volumes' is; the sort in force, *Tree* and *Mine only* ticked.
    #: Also its right-click menu.
    SubMenu:
        id: process_menu
        text: '~P~rocesses'
        tooltip: "Sort, search and signal the running processes"
        after: 'File'
        MenuItem:
            text: '~R~e-read'
            command: Rescan
            key: 'Ctrl-R'
        MenuLine:
        MenuItem:
            text: 'Sort by ~P~ID'
            command: ProcessSortPid
            key: 'Ctrl-P'
        MenuItem:
            text: 'Sort by ~u~ser'
            command: ProcessSortUser
            key: 'Ctrl-U'
        MenuItem:
            text: 'Sort by s~t~ate'
            command: ProcessSortState
            key: 'Ctrl-E'
        MenuItem:
            text: 'Sort by CPU ~l~oad'
            command: ProcessSortCpu
            key: 'Ctrl-L'
        MenuItem:
            text: 'Sort by ~m~emory'
            command: ProcessSortMemory
            key: 'Ctrl-Z'
        MenuItem:
            text: 'Sort by comma~n~d'
            command: ProcessSortCommand
            key: 'Ctrl-N'
        MenuLine:
        MenuItem:
            text: 'Tr~e~e'
            tooltip: "Each process under its parent"
            command: ProcessTree
            key: 'Ctrl-T'
        MenuItem:
            text: 'M~i~ne only'
            tooltip: "Only your own processes"
            command: ProcessMineOnly
            key: 'Ctrl-H'
        MenuItem:
            text: '~Q~uick search'
            command: QuickSearch
            key: 'Ctrl-S'
        MenuLine:
        MenuItem:
            text: '~D~etails...'
            command: ProcessDetails
            key: 'F3'
        MenuItem:
            text: '~S~ignal...'
            command: SignalProcess
            key: 'F7'
        MenuItem:
            text: '~K~ill...'
            command: KillProcess
            key: 'F8'
        MenuLine:
        MenuItem:
            text: '~C~lose'
            command: CloseWindow
