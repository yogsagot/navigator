from navigator.widgets.manager.commands import Rescan
from navigator.widgets.shell.commands import DisableService, EditUnitFile, EnableService, FilterServices, MaskService, ReloadService, RestartService, ServiceAllTypes, ServiceDetails, ServiceJournal, ServiceSortActive, ServiceSortDescription, ServiceSortFileState, ServiceSortName, ServiceUserUnits, StartService, StopService, UnmaskService
from navigator.widgets.shell.process_list import ProcessFilter
from navigator.widgets.shell.service_list import ServiceList
from navml.commands import CloseWindow
from navml.widgets.dialog.button import Button
from navml.widgets.dialog.check_boxes import CheckBoxes
from navml.widgets.dialog.commands import SelectNext, SelectPrevious
from navml.widgets.dialog.label import Label
from navml.widgets.dialog.static_text import StaticText
from navml.widgets.menu.menu_item import MenuItem
from navml.widgets.menu.menu_line import MenuLine
from navml.widgets.menu.sub_menu import SubMenu
from navml.widgets.window import Window

#: Utilities > Services: the system's services -- systemd's units, OpenRC's or
#: runit's services: name, whether it runs, how it starts, what it is -- a row each,
#: read again every ``[services] refresh`` seconds.  **Not DOS Navigator's**:
#: a departure, asked for -- DOS had no service manager.  Process list's
#: sibling, laid out as it is; ``navigator/lib/system/services/`` says how
#: each manager is asked, and what one has not is greyed with the reason.
#:
#: *Filter* and its X across the top; the list under them; the status line,
#: then *User units* and *All types* on the left, *Start*, *Stop*, *Journal*,
#: *Edit* and *Close* on the right, the window never narrower than all of them.
#:
#: F4 opens the unit's file in the editor -- a package's through a drop-in, an
#: OpenRC service's ``/etc/conf.d`` file -- and saving it runs ``systemctl
#: daemon-reload`` (as root when the user may not), or OpenRC offers a restart.  Not Filter, as F4 is in
#: Process list: F4 is Edit everywhere else in Navigator.
#:
#: F5 starts the unit under the cursor, F6 restarts it, F7 reloads it, F8 or
#: Del stops it after asking; Ctrl+E enables it and Ctrl+D disables it, and
#: the menu masks and unmasks.  What the user may not do alone is offered *As
#: root*, through the root helper's ``service``.  F3 opens the unit's
#: journal (OpenRC: its log, or the system log's lines naming it) in the
#: viewer, following its end; Enter says what its status is.  Ctrl+U lists the user's own manager's units, Ctrl+A every
#: type rather than services; Ctrl+N and Ctrl+L sort by name and state, as a
#: click on a column's title does.  Typing, Ctrl+S or Alt+F goes to the
#: filter; Esc empties it, then closes the window; Ctrl+R reads again.
ServiceWindow(Window):
    title: "Services"
    min_width: max(user_box.width, types_box.width) + start_button.width + stop_button.width + journal_button.width + edit_button.width + close_button.width + 9

    keys:
        escape: CloseWindow
        ctrl+r: Rescan
        alt+r: Rescan
        f3: ServiceJournal
        f5: StartService
        f6: RestartService
        f7: ReloadService
        f8: StopService
        delete: StopService
        ctrl+e: EnableService
        ctrl+d: DisableService
        ctrl+u: ServiceUserUnits
        ctrl+a: ServiceAllTypes
        ctrl+n: ServiceSortName
        ctrl+l: ServiceSortActive
        f4: EditUnitFile
        ctrl+s: FilterServices
        tab: SelectNext
        shift+tab: SelectPrevious

    #: As wide as its caption and a blank, whatever the language.
    Label:
        id: filter_caption
        x: 2
        y: 1
        width: root.caption_width(self.text) + 1
        height: 1
        text: "~F~ilter"
        link: filter

    #: Narrows the list to the units whose name or description holds what is
    #: typed, as it is typed.
    ProcessFilter:
        id: filter
        x: filter_caption.x + filter_caption.width
        y: 1
        width: max(1, parent.width - 6 - self.x)
        height: 1
        tooltip: "Show only the units whose name or description holds this"

    #: Empties the filter.
    Button:
        id: clear_filter
        flat: True
        x: max(0, parent.width - 5)
        y: 1
        width: 3
        height: 1
        tooltip: "Clear the filter"

    ServiceList:
        id: units
        framed: False
        x: 1
        y: 2
        width: max(0, parent.width - 1)
        height: max(0, parent.height - 6)

    StaticText:
        id: status
        x: 2
        y: max(0, parent.height - 4)
        width: max(0, parent.width - 4)
        height: 1

    #: As wide as its caption and the gap after it, whatever the language.
    CheckBoxes:
        id: user_box
        x: 2
        y: max(0, parent.height - 3)
        width: self.column_x(1)
        height: 1
        items: ["~U~ser units"]
        tooltips: ["Your own service manager's units (systemctl --user), not the system's"]

    CheckBoxes:
        id: types_box
        x: 2
        y: max(0, parent.height - 2)
        width: self.column_x(1)
        height: 1
        items: ["~A~ll types"]
        tooltips: ["Timers, sockets, mounts and the rest too, not only services"]

    Button:
        id: start_button
        text: "S~t~art"
        x: max(0, stop_button.x - 1 - self.width)
        y: max(0, parent.height - 3)
        width: root.caption_width(self.text) + 5
        height: 2
        disabled: not root.allows()

    Button:
        id: stop_button
        text: "St~o~p"
        x: max(0, journal_button.x - 1 - self.width)
        y: max(0, parent.height - 3)
        width: root.caption_width(self.text) + 5
        height: 2
        disabled: not root.allows()

    Button:
        id: journal_button
        text: "~J~ournal"
        default: True
        x: max(0, edit_button.x - 1 - self.width)
        y: max(0, parent.height - 3)
        width: root.caption_width(self.text) + 5
        height: 2
        disabled: not root.allows()

    Button:
        id: edit_button
        text: "~E~dit"
        x: max(0, close_button.x - 1 - self.width)
        y: max(0, parent.height - 3)
        width: root.caption_width(self.text) + 5
        height: 2
        disabled: not root.allows()

    Button:
        id: close_button
        text: "Close"
        x: max(0, parent.width - 2 - self.width)
        y: max(0, parent.height - 3)
        width: root.caption_width(self.text) + 5
        height: 2

    #: The window's own menu on the bar after *File* while it is active, as
    #: Process list's is; the sort in force and the two boxes ticked.  Also
    #: its right-click menu.
    SubMenu:
        id: service_menu
        text: '~S~ervices'
        tooltip: "Start, stop, enable and follow the system's services"
        after: 'File'
        MenuItem:
            text: '~R~e-read'
            command: Rescan
            key: 'Ctrl-R'
        MenuLine:
        MenuItem:
            text: 'Sort by ~n~ame'
            command: ServiceSortName
            key: 'Ctrl-N'
        MenuItem:
            text: 'Sort by ~s~tate'
            command: ServiceSortActive
            key: 'Ctrl-L'
        MenuItem:
            text: 'Sort by start-~u~p'
            command: ServiceSortFileState
        MenuItem:
            text: 'Sort by ~d~escription'
            command: ServiceSortDescription
        MenuLine:
        MenuItem:
            text: 'Us~e~r units'
            tooltip: "Your own service manager's units (systemctl --user), not the system's"
            command: ServiceUserUnits
            key: 'Ctrl-U'
        MenuItem:
            text: '~A~ll types'
            tooltip: "Timers, sockets, mounts and the rest too, not only services"
            command: ServiceAllTypes
            key: 'Ctrl-A'
        MenuItem:
            text: '~F~ilter'
            tooltip: "Show only the units whose name or description holds what is typed"
            command: FilterServices
            key: 'Ctrl-S'
        MenuLine:
        MenuItem:
            text: '~J~ournal'
            tooltip: "The unit's journal in the viewer, following its end"
            command: ServiceJournal
            key: 'F3'
        MenuItem:
            text: 'Edit unit file'
            tooltip: "The unit's file in the editor, a package's through a drop-in override; saved, systemd reads its unit files again"
            command: EditUnitFile
            key: 'F4'
        MenuItem:
            text: 'Detai~l~s...'
            command: ServiceDetails
            key: 'Enter'
        MenuLine:
        MenuItem:
            text: 'S~t~art'
            command: StartService
            key: 'F5'
        MenuItem:
            text: 'Restart'
            command: RestartService
            key: 'F6'
        MenuItem:
            text: 'Rel~o~ad'
            command: ReloadService
            key: 'F7'
        MenuItem:
            text: 'Sto~p~...'
            command: StopService
            key: 'F8'
        MenuLine:
        MenuItem:
            text: 'Ena~b~le'
            tooltip: "Started at boot, or at log-in for a user unit"
            command: EnableService
            key: 'Ctrl-E'
        MenuItem:
            text: 'D~i~sable'
            tooltip: "Not started at boot any more"
            command: DisableService
            key: 'Ctrl-D'
        MenuItem:
            text: '~M~ask...'
            tooltip: "Never started, not even by another unit"
            command: MaskService
        MenuItem:
            text: 'Unmas~k~'
            command: UnmaskService
        MenuLine:
        MenuItem:
            text: '~C~lose'
            command: CloseWindow
