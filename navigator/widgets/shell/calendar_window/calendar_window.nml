from navml.commands import CloseWindow
from navml.widgets.dialog.button import Button
from navml.widgets.dialog.commands import ChooseMonth, ChooseYear, GoToToday, NextMonth, NextYear, PreviousMonth, PreviousYear, SwapCalendars
from navml.widgets.dialog.date_button import CalendarView
from navml.widgets.menu.menu_item import MenuItem
from navml.widgets.menu.menu_line import MenuLine
from navml.widgets.menu.sub_menu import SubMenu
from navml.widgets.window import Window

#: Utilities > Calendar: Turbo Vision's ``TCalendarWindow`` (TVDEMO), not DOS
#: Navigator's -- DN 1.51 had no calendar; a departure, asked for.
#:
#: A month on the desktop, one window at a time: the month and year between
#: the arrows that turn it, the weekdays, six weeks with today marked.  It is
#: navml's ``CalendarView``, the one a date line's ``▐↓▌`` drops, so it pages
#: and picks a month or a year the same way; here it only shows, as TVDEMO's
#: did.  *Go to current date* (Alt+D, or ``T`` in the month) brings today
#: back under the cursor -- not TVDEMO's, asked for.  Under the weeks the
#: day under the cursor is spelled in *Country support*'s date format, as a
#: date line's drop-down spells it in the line's (bound in ``__init__``).
#: Esc closes it.
#:
#: **The month can be in another calendar** (``navml.calendars``: Julian,
#: Hebrew, Islamic, Persian, Indian national, Ethiopian, Coptic), paged and
#: picked in its own months and years, the Gregorian day still spelled under
#: them -- not TVDEMO's, whose month was Gregorian only; asked for with the
#: Hebrew, Arabic, Chinese and Japanese catalogues.  Which one is *Calendar
#: system*'s choice on the menu, else *Country support*'s (``[country]
#: calendar``, the language's own by default).  *View* says what of it is shown
#: beside the Gregorian (``[country] calendar_view`` by default): its month
#: alone, the day spelled in it under the Gregorian month, its month with the
#: Gregorian day spelled under, or the two months side by side, the calendar
#: on the left and the Gregorian on the right, one day under both cursors.  ``C`` swaps the month between
#: the calendar and the Gregorian (not beside each other, where both show).  Its month alone, or the two,
#: spell nothing under them: the grids already say the day.
CalendarWindow(Window):
    title: "Calendar"
    #: The calendar the menu chose, a key of ``navml.calendars.SYSTEMS``;
    #: empty, *Country support*'s.
    property chosen: ""
    #: What of it is shown, a ``CountryData.VIEWS`` key; empty, *Country
    #: support*'s.
    property display: ""
    #: *Selected calendar only* swapped by ``C`` to the Gregorian alone.
    property swapped: False
    zoomable: False
    resizable: False

    #: T is the month's own key too; here it also works while the button has
    #: the keyboard, which the month's table is not on the way out from.
    keys:
        escape: CloseWindow
        t: GoToToday
        shift+t: GoToToday
        c: SwapCalendars
        shift+c: SwapCalendars

    CalendarView:
        id: month
        x: 2
        y: 1
        width: 22
        height: 9
        can_focus: True

    #: The Gregorian month beside the calendar system's, in *View*'s *Both
    #: months*; on the same day as ``month``, which the window keeps.
    CalendarView:
        id: other
        x: 27
        y: 1
        width: 22
        height: 9
        can_focus: True
        visible: False

    Button:
        id: today_button
        text: "Go to current ~d~ate"
        x: 2
        y: 11
        width: 23
        height: 2

    #: The window's own menu on the bar after *File* while it is active, as
    #: the Directory Tree window's -- a departure, asked for: TVDEMO's had
    #: none, and its paging and picking keys showed nowhere.  Each key is the
    #: view's table's; written here too for when the button has the keyboard,
    #: where the view's table is not on the way out.  Also its right-click menu.
    SubMenu:
        id: calendar_menu
        text: '~C~alendar'
        tooltip: "Move between months and years"
        after: 'File'
        MenuItem:
            text: '~P~revious month'
            command: PreviousMonth
            key: 'PgUp'
        MenuItem:
            text: '~N~ext month'
            command: NextMonth
            key: 'PgDn'
        MenuItem:
            text: 'P~r~evious year'
            command: PreviousYear
            key: 'Ctrl-PgUp'
        MenuItem:
            text: 'Ne~x~t year'
            command: NextYear
            key: 'Ctrl-PgDn'
        MenuLine:
        MenuItem:
            text: 'Choose ~m~onth...'
            command: ChooseMonth
            key: 'M'
        MenuItem:
            text: 'Choose ~y~ear...'
            command: ChooseYear
            key: 'Y'
        MenuLine:
        MenuItem:
            text: 'Go to current ~d~ate'
            command: GoToToday
            key: 'T'
        MenuItem:
            text: 'S~w~ap calendars'
            command: SwapCalendars
            key: 'C'
        MenuLine:
        #: Filled from ``navml.calendars.SYSTEMS`` in ``__init__``, so a
        #: calendar added there is offered here.
        SubMenu:
            id: system_menu
            text: 'Calendar ~s~ystem'
        #: Filled in ``__init__`` too, from ``VIEWS``.
        SubMenu:
            id: view_menu
            text: 'Calendar ~v~iew'
        MenuLine:
        MenuItem:
            text: '~C~lose'
            command: CloseWindow
