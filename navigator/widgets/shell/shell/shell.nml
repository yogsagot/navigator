from navigator.widgets.shell.clock import Clock
from navigator.widgets.shell.command_line import CommandLine
from navigator.widgets.shell.console import Console
from navigator.widgets.shell.keybar import KeyBar
from navigator.widgets.shell.main_menu import MainMenu
from navml.widgets.desktop import Desktop
from navml.widgets.layout.dock_layout import DockLayout

#: The Navigator screen: the console, the desktop over it, the menu bar and
#: clock over that, the command line, key bar.
#:
#: The band between the two bars holds two layers, and the order of the
#: children is the whole of how they stack.  The console is the bottom one and
#: is **always showing** -- it is the background the windows float over, as the
#: user screen was in DOS Navigator.  The desktop is the layer above it and
#: holds every window; it paints nothing of its own, so the console shows
#: between them.  Ctrl+O hides the desktop, which is one reactive flag and one
#: ``visible`` line.  The key bar is last so nothing covers it, and a modal is
#: overlaid on this root, which puts it above the desktop by construction.
#:
#: The bars dock against the top and bottom edges, and the two layers both
#: *fill*, which a dock layout gives them as one shared rectangle -- it places
#: every fill after every edge, so the key bar can come last in the child
#: order, and so last in the paint, and still be carved off first.
#:
#: The command line docks after the key bar, which is what puts it on the row
#: above it: edges are carved in child order, so the key bar takes the last
#: row and the line the one left at the bottom.  DOS Navigator's
#: ``InitCommandLine`` put it there, and gave up that row from the desktop.
Shell(DockLayout):
    #: Whether Ctrl+O has put the windows away.  One flag that the desktop's
    #: ``visible`` line reads, which is the whole of Ctrl+O.
    property console_visible: False

    Console:
        id: console

    Desktop:
        id: desktop
        visible: not parent.console_visible

    #: ``context`` is whose menus join the bar: the active window's, while
    #: the windows are showing -- so F9, a click, closing it and Ctrl+O all
    #: take a window's menu off the bar by changing one of the two.
    #:
    #: After the desktop, so it paints over it: Interface's *Hide menu bar*
    #: (``ouiHideMenu``) gives the desktop the top row and shows the bar
    #: there, floating, only while a menu is open.  Its dock and visibility
    #: are bound in ``__init__``; its geometry is its own, so floating or
    #: docked it is the top row.
    MainMenu:
        id: menu
        context: None if parent.console_visible else desktop.active_window
        width: parent.width
        height: 1

    #: Over the menu bar's right end, which is why it comes after it, and
    #: outside the docking altogether: it floats where its own lines put it.
    #: Shown while Interface's *Clock* is ticked: bound in ``__init__``.
    Clock:
        id: clock
        x: max(0, parent.width - self.width)
        y: 0
        style:
            dock: none

    #: DN's status line, which Interface's *Hide status line* takes away
    #: (bound in ``__init__``), and the dock then gives its row to the layers.
    KeyBar:
        id: keybar
        style:
            dock: bottom
            basis: 1

    #: ``TCommandLine``.  Never focused: the keys a window declines walk up
    #: to this screen, which hands them to it.  Interface's *Hide Command
    #: Line* (``ouiHideCmdline``) takes it away, row and keys: bound in
    #: ``__init__``.
    CommandLine:
        id: command_line
        prompt: parent.command_prompt
        prompt_cells: parent.command_prompt_cells
        style:
            dock: bottom
            basis: 1
