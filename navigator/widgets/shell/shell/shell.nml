from navigator.widgets.shell.clock import Clock
from navigator.widgets.shell.command_line import CommandLine
from navigator.widgets.shell.console import Console
from navigator.widgets.shell.keybar import KeyBar
from navigator.widgets.shell.job_mark import JobMark
from navigator.widgets.shell.macro_mark import MacroMark
from navigator.widgets.shell.main_menu import MainMenu
from navigator.widgets.shell.root_mark import RootMark
from navigator.widgets.shell.trash_can import TrashCan
from navigator.lib.config import country
from navigator.settings import SETTINGS
from navml.widgets.desktop import Desktop
from navml.widgets.layout.dock_layout import DockLayout
from navml.widgets.window_strip import WindowStrip

#: The Navigator screen: the console, the desktop over it, the menu bar and
#: clock over that, the command line, key bar.
#:
#: The band between the two bars holds two layers, and the order of the
#: children is the whole of how they stack.  The console is the bottom one and
#: is **always showing** -- it is the background the windows float over, as the
#: user screen was in DOS Navigator.  The desktop is the layer above it and
#: holds every window; it paints nothing of its own, so the console shows
#: between them.  Ctrl+O hides the desktop, which is one reactive flag and one
#: ``visible`` line.  The key bar is last so nothing covers it, and a modal is
#: overlaid on this root, which puts it above the desktop by construction.
#:
#: The bars dock against the top and bottom edges, and the two layers both
#: *fill*, which a dock layout gives them as one shared rectangle -- it places
#: every fill after every edge, so the key bar can come last in the child
#: order, and so last in the paint, and still be carved off first.
#:
#: The command line docks after the key bar, which is what puts it on the row
#: above it: edges are carved in child order, so the key bar takes the last
#: row and the line the one left at the bottom.  DOS Navigator's
#: ``InitCommandLine`` put it there, and gave up that row from the desktop.
Shell(DockLayout):
    #: Whether Ctrl+O has put the windows away.  One flag that the desktop's
    #: ``visible`` line reads, which is the whole of Ctrl+O.
    property console_visible: False

    Console:
        id: console

    Desktop:
        id: desktop
        visible: not parent.console_visible

    #: ``context`` is whose menus join the bar: the active window's, while
    #: the windows are showing -- so F9, a click, closing it and Ctrl+O all
    #: take a window's menu off the bar by changing one of the two.
    #:
    #: After the desktop, so it paints over it: Interface's *Hide menu bar*
    #: (``ouiHideMenu``) gives the desktop the top row and shows the bar
    #: there, floating, only while a menu is open (``current`` is -1 only
    #: while none is); its geometry is its own, so floating or docked it is
    #: the top row.  The clock floats over the bar's end: a bar that would
    #: reach it closes up its captions (``MenuBar.tight``).
    MainMenu:
        id: menu
        context: None if parent.console_visible else desktop.active_window
        width: parent.width
        height: 1
        inline_style: "dock: none" if SETTINGS.interface.hide_menu_bar else "dock: top; basis: 1"
        visible: not SETTINGS.interface.hide_menu_bar or self.current >= 0
        reserve: max(0, self.width - clock.x + 1) if clock.visible else 0

    #: Interface's *Window strip*: the windows by number, over the stretch of
    #: the menu bar between its last menu and the clock, kept to the clock's
    #: end -- after the bar, so it paints over it, and floating as the clock
    #: does: from a cell after the last menu, less the cells it gives up
    #: to the mark of work in the background, to a cell before *ROOT* or the
    #: clock, on a bar that is docked and over windows that are showing.
    WindowStrip:
        id: window_strip
        desktop: parent.desktop
        align: "right"
        x: menu.item_span(len(menu.entries()))[0] + 1 + (job_mark.width if job_mark.visible else 0)
        y: 0
        height: 1
        anchors:
            before: macro_mark, root_mark, clock + 1
            right: 1
        labels: SETTINGS.interface.window_strip == "full"
        visible: SETTINGS.interface.window_strip != "off" and not SETTINGS.interface.hide_menu_bar and not parent.console_visible
        style:
            dock: none

    #: Over the menu bar's right end, which is why it comes after it, and
    #: outside the docking altogether: it floats where its own lines put it.
    #: Shown while Interface's *Clock* is ticked (``ouiClock``); *Country
    #: support*'s 12 hours put ``am``/``pm`` after the minutes.
    Clock:
        id: clock
        visible: SETTINGS.interface.clock
        width: 7 if country.twelve_hours() else 5
        y: 0
        anchors:
            right: 0
        style:
            dock: none

    #: *ROOT* before the clock while root access is open (``open`` set once
    #: a second by ``follow_root``): floating as the clock does, over the
    #: bar's row.
    RootMark:
        id: root_mark
        y: 0
        width: self.natural_width
        anchors:
            before: clock + 1
            right: 0
        visible: self.open and not SETTINGS.interface.hide_menu_bar and not parent.console_visible
        style:
            dock: none

    #: DN's ``>MACRO<`` while keys are recorded (``navigator.lib.config.macros``):
    #: before *ROOT*, or the clock, floating as they do.
    MacroMark:
        id: macro_mark
        y: 0
        width: self.natural_width
        anchors:
            before: root_mark, clock + 1
            right: 1
        visible: self.slot > 0 and not SETTINGS.interface.hide_menu_bar and not parent.console_visible
        style:
            dock: none

    #: How far the operations in the background are, just before the window
    #: strip's chips -- which keep to the clock's end, the strip giving up
    #: its first cells to the mark (its ``x``), so it never reaches the
    #: menus.  With no chips, or no strip, just before *ROOT* or the clock.
    JobMark:
        id: job_mark
        x: root.strip_start() - self.width
        y: 0
        width: self.natural_width
        visible: self.busy and not SETTINGS.interface.hide_menu_bar and not parent.console_visible
        style:
            dock: none

    #: ≡ > Trashcan on/off's ``TTrashCan``: over the desktop's windows, at
    #: the desktop's bottom right corner by its own bindings.
    TrashCan:
        id: trash
        desktop: parent.desktop
        style:
            dock: none

    #: DN's status line, which Interface's *Hide status line* takes away
    #: (``ouiHideStatus``), and the dock then gives its row to the layers.
    KeyBar:
        id: keybar
        visible: not SETTINGS.interface.hide_status_line
        #: The columns *ROOT* takes at its right end, kept clear of items.
        reserve: key_root_mark.width + 1 if key_root_mark.visible else 0
        style:
            dock: bottom
            basis: 1

    #: *ROOT* again at the status line's right end while the menu bar's own
    #: cannot be seen -- the console up (Ctrl+O), or *Hide menu bar* -- so
    #: root access open is never out of sight.  Its tooltip and click are
    #: the menu bar's mark's.
    RootMark:
        id: key_root_mark
        open: root_mark.open
        y: keybar.y
        width: self.natural_width
        anchors:
            right: 0
        visible: self.open and keybar.visible and (SETTINGS.interface.hide_menu_bar or parent.console_visible)
        style:
            dock: none

    #: ``TCommandLine``.  Never focused: the keys a window declines walk up
    #: to this screen, which hands them to it.  Interface's *Hide Command
    #: Line* (``ouiHideCmdline``) takes it away, row and keys.  *Auto hide
    #: Command Line*: DN 1.51 declared the box and never read it, so this is
    #: the behaviour its ``CheckSize`` and ``ToggleCmdLine`` gave a hidden
    #: line -- shown once it holds text, its row back to the desktop once it
    #: is empty again.
    CommandLine:
        id: command_line
        prompt: parent.command_prompt
        prompt_cells: parent.command_prompt_cells
        visible: not SETTINGS.interface.hide_command_line and (not SETTINGS.interface.auto_hide_command_line or self.value != "")
        style:
            dock: bottom
            basis: 1
