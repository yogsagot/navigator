from navigator.widgets.manager.commands import Delete, Rescan
from navigator.widgets.shell.commands import GoToUsage, ToggleApparentSize, UsageSortItems, UsageSortName, UsageSortSize
from navigator.widgets.shell.usage_list import UsageList
from navml.commands import CloseWindow
from navml.widgets.dialog.button import Button
from navml.widgets.dialog.check_boxes import CheckBoxes
from navml.widgets.dialog.commands import SelectNext, SelectPrevious
from navml.widgets.dialog.static_text import StaticText
from navml.widgets.menu.menu_item import MenuItem
from navml.widgets.menu.menu_line import MenuLine
from navml.widgets.menu.sub_menu import SubMenu
from navml.widgets.dialog.scroll_bar import ScrollBar
from navml.widgets.window import Window

#: Disk > Directory sizes: what takes the room under a directory, biggest
#: first, a row each with its size, its share, a bar and how many entries are
#: under it -- ``ncdu``'s view.  **Not DOS Navigator's**: a departure, asked
#: for; ``navigator/lib/file_ops/dirusage.py`` says what of DN's it borders.
#:
#: Laid out as Disk > Volumes is: the list without a frame of its own, one
#: column into the window's; under it the status line -- where the listed
#: directory is and what it adds up to, or what the scan has met so far --
#: *Apparent size* on the left, *Go* and *Close* on the right.
#:
#: The whole tree is read once, on a thread, when the window opens -- on the
#: active panel's directory, any drive's -- and again only on Ctrl+R; going
#: down (Enter, Right) and up (Backspace, Left, Enter on ``..``) is then free.
#: Another file system is not entered, as ``ncdu -x``.  F8 or Del erases the
#: entry under the cursor as F8 in a panel does -- its dialog, its Trash, its
#: questions -- and takes it off the totals with no second read.  *Go* sends
#: the active panel there and closes the window; Enter on a file does that
#: and leaves it open.  Ctrl+N, Ctrl+S and Ctrl+E sort by name, size and
#: entries -- not the F-keys DN sorted a panel by, which the desktop and the
#: global table already hold here (Ctrl+F3 *New manager*, Ctrl+F4 closing,
#: Ctrl+F5 sizing); the same key again turns the order round.  Ctrl+A, or the box, shows the bytes
#: files say they hold instead of the room they take on the disk.
UsageWindow(Window):
    help_topic: "trees.md#directory-sizes"
    title: "Directory sizes"

    keys:
        escape: CloseWindow
        ctrl+r: Rescan
        alt+r: Rescan
        f8: Delete
        delete: Delete
        ctrl+a: ToggleApparentSize
        ctrl+n: UsageSortName
        ctrl+s: UsageSortSize
        ctrl+e: UsageSortItems
        tab: SelectNext
        shift+tab: SelectPrevious

    #: The commands this component handles itself.
    commands:
        Rescan: root.rescan()
        ToggleApparentSize: root.apparent = not root.apparent
        UsageSortName: root._sort_by('name')
        UsageSortSize: root._sort_by('size')
        UsageSortItems: root._sort_by('items')
        SelectNext: root._step(1)
        SelectPrevious: root._step(-1)

    first_focus: entries

    local_menu: usage_menu

    UsageList:
        id: entries
        framed: False
        anchors:
            left: 1
            right: 0
            top: 1
            bottom: 3

    #: A departure, asked for, as the process list's: on the bottom frame
    #: under the *Name* column, how far Shift+Left/Right (Ctrl, twenty) have
    #: scrolled it, while a name on screen is cut there or it is scrolled.
    ScrollBar:
        id: hbar
        orientation: "horizontal"
        visible: entries.overflows_across and self.width >= 4
        x: entries.x + entries.name_x
        width: max(0, parent.width - 2 - self.x)
        height: 1
        anchors:
            bottom: 0
        value: entries.x_delta
        maximum: max(0, entries.name_span - entries.name_room, entries.x_delta)
        page: entries.name_room

    StaticText:
        id: status
        anchors:
            left: 2
            right: 26
            bottom: 2

    CheckBoxes:
        id: apparent_box
        x: 2
        width: 22
        height: 1
        anchors:
            bottom: 1
        items: ["~A~pparent size"]
        tooltips: ["The bytes files hold rather than the room they take on the disk"]

    Button:
        id: go_button
        text: "~G~o"
        default: True
        width: 10
        height: 2
        anchors:
            right: 13
            bottom: 1
        command: GoToUsage

    Button:
        id: close_button
        text: "Close"
        width: 10
        height: 2
        anchors:
            right: 2
            bottom: 1
        on_click: root.request_close()

    #: The window's own menu on the bar after *File* while it is active, as
    #: Disk > Volumes' is; the sort it is in and *Apparent size* ticked.  Also
    #: its right-click menu.
    SubMenu: text='~S~izes', after='File'
        id: usage_menu
        tooltip: "Sort, re-read and erase what the directory sizes list"
        MenuItem: text='~R~e-read', command=Rescan, key='Ctrl-R'
        MenuLine:
        MenuItem: text='Sort by ~n~ame', command=UsageSortName, key='Ctrl-N'
        MenuItem: text='Sort by ~s~ize', command=UsageSortSize, key='Ctrl-S'
        MenuItem: text='Sort by ~e~ntries', command=UsageSortItems, key='Ctrl-E'
        MenuItem: text='~A~pparent size', command=ToggleApparentSize, key='Ctrl-A'
            tooltip: "The bytes files hold rather than the room they take on the disk"
        MenuLine:
        MenuItem: text='~G~o to directory', command=GoToUsage
        MenuItem: text='~D~elete...', command=Delete, key='F8'
        MenuLine:
        MenuItem: text='~C~lose', command=CloseWindow
