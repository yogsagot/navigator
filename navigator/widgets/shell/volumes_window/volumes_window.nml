from navigator.widgets.manager.commands import MountImage, Rescan, ToggleHidden, UnmountImage
from navigator.widgets.shell.commands import EjectVolume, MountVolume, UnmountVolume
from navigator.widgets.shell.volume_list import VolumeList
from navml.commands import CloseWindow
from navml.widgets.dialog.button import Button
from navml.widgets.dialog.check_boxes import CheckBoxes
from navml.widgets.dialog.commands import SelectNext, SelectPrevious
from navml.widgets.menu.menu_item import MenuItem
from navml.widgets.menu.menu_line import MenuLine
from navml.widgets.menu.sub_menu import SubMenu
from navml.widgets.dialog.scroll_bar import ScrollBar
from navml.widgets.window import Window

#: Disk > Volumes: every mounted volume -- its name, type, mount point, free
#: space and size -- a row each.  **Not DOS Navigator's**: a departure, asked
#: for.  DN 1.51's drive chooser (``SelectDrive``, FILESCOL.PAS) listed bare
#: drive letters, and only ``TDiskInfo`` (Ctrl+L) told a drive's size, free
#: space and label -- of the current drive alone.  This is the two together:
#: what ``TDiskInfo`` said, for every drive ``SelectDrive`` would offer, in
#: the place and under the letter of DN's *Volume label*, which has no POSIX
#: meaning.
#:
#: Laid out as the Directory Tree window is: the list without a frame of its
#: own, one column into the window's, its scroll bar on the right edge; under
#: it, a dialog's row: *Show all mounts* on the left, *Go* and *Close* on the
#: right.  Enter in the list sends the file manager's active panel to the
#: volume's mount point, as Enter in the tree window sends it to a directory,
#: and the window stays; *Go* does the same and closes it.  Esc closes it;
#: Ctrl+R and Alt+R read the mounts again, as they re-read a panel; *Show all
#: mounts* -- or Ctrl+H, as it shows a panel's dot-files -- lists the kernel's
#: own file systems as well; *Show free %* turns the *Use %* column, ``df``'s,
#: into *Free %*.  Tab walks the controls, Alt and a marked letter
#: takes one, as in a dialog.
#:
#: Where the desktop's ``gio`` or KDE's Solid is -- else udisks2's own
#: ``udisksctl`` -- the volumes udisks knows but has not
#: mounted are listed too, *not mounted*, and *Mount* (F5, Ctrl+N), *Unmount*
#: (F6, Ctrl+U) and *Eject* (F7, Ctrl+E) act on the one under the cursor, as
#: the desktop's file manager does -- a further departure.  Each is a button
#: too, greyed where the volume cannot: on *Go* and *Close*'s row where the
#: window is wide enough beside the boxes, in a row over them where it is
#: not; the F-keys are what puts them on the key bar.  Enter or *Go* on one not
#: mounted mounts it first.  *Mount image...* asks for a disk image file and
#: mounts it (``udisksctl loop-setup``); *Unmount image*, on a row of one,
#: unmounts every file system of that image and detaches it -- the Disk
#: menu's two, which this window answers while it is active.
VolumesWindow(Window):
    title: "Volumes"

    keys:
        escape: CloseWindow
        ctrl+r: Rescan
        alt+r: Rescan
        ctrl+h: ToggleHidden
        f5: MountVolume
        ctrl+n: MountVolume
        f6: UnmountVolume
        ctrl+u: UnmountVolume
        f7: EjectVolume
        ctrl+e: EjectVolume
        tab: SelectNext
        shift+tab: SelectPrevious

    #: The commands this component handles itself.
    commands:
        MountImage: root.spawn(root._mount_image())
        Rescan: root.reload()
        ToggleHidden: root.show_all = not root.show_all
        SelectNext: root._step(1)
        SelectPrevious: root._step(-1)

    first_focus: volumes

    VolumeList:
        id: volumes
        framed: False
        anchors:
            left: 1
            right: 0
            top: 1
            bottom: 4
        #: Narrow, the buttons go up a row to stand right of the check boxes.
        when parent.width < 82:
            anchors:
                bottom: 6

    #: A departure, asked for, as the process list's: on the bottom frame
    #: under the *Mount point* column, how far Left and Right have scrolled
    #: it, while a mount point on screen is cut there or it is scrolled.  The
    #: column opens on the mount points' ends, so its thumb starts on the right.
    ScrollBar:
        id: hbar
        orientation: "horizontal"
        visible: volumes.overflows_across and self.width >= 4
        x: volumes.x + volumes.mount_x
        width: volumes.mount_width
        height: 1
        anchors:
            bottom: 0
        value: max(0, volumes.mount_reach - volumes.back)
        maximum: max(volumes.mount_reach, volumes.back)
        page: volumes.mount_room

    CheckBoxes:
        id: everything
        x: 2
        width: 22
        height: 1
        anchors:
            bottom: 2
        items: ["~S~how all mounts"]
        tooltips: ["Show the kernel's own file systems too"]

    CheckBoxes:
        id: free_box
        x: 2
        width: 22
        height: 1
        anchors:
            bottom: 1
        items: ["Show ~f~ree %"]
        tooltips: ["Show the share that is free rather than the share used"]

    #: ``gio``'s, Solid's or udisks' three, each greyed as its command is (``VolumesWindow.allows``):
    #: on *Go* and *Close*'s row, a button's width apart, where 82 columns
    #: leave room beside the boxes; right-aligned over them where they do not.
    Button:
        id: mount_button
        text: "~M~ount"
        width: 10
        height: 2
        anchors:
            right: 47
            bottom: 1
        when parent.width < 82:
            anchors:
                right: 25
                bottom: 3
        disabled: not root.allows("mount")
        command: MountVolume

    Button:
        id: unmount_button
        text: "~U~nmount"
        width: 11
        height: 2
        anchors:
            right: 35
            bottom: 1
        when parent.width < 82:
            anchors:
                right: 13
                bottom: 3
        disabled: not root.allows("unmount")
        command: UnmountVolume

    Button:
        id: eject_button
        text: "~E~ject"
        width: 10
        height: 2
        anchors:
            right: 24
            bottom: 1
        when parent.width < 82:
            anchors:
                right: 2
                bottom: 3
        disabled: not root.allows("eject")
        command: EjectVolume

    Button:
        id: go_button
        text: "~G~o"
        default: True
        width: 10
        height: 2
        anchors:
            right: 13
            bottom: 1
        on_click: await root.go()

    Button:
        id: close_button
        text: "Close"
        width: 10
        height: 2
        anchors:
            right: 2
            bottom: 1
        on_click: root.request_close()

    #: The window's own menu on the bar after *File* while it is active, as
    #: the Directory Tree window's -- a departure, asked for, so Ctrl+R and
    #: Ctrl+H show somewhere.  *Show all mounts* is ticked while on.  Also its
    #: right-click menu.
    SubMenu: text='~V~olumes', after='File'
        id: volumes_menu
        tooltip: "Mount, unmount and eject volumes"
        MenuItem: text='~R~e-read', command=Rescan
        MenuItem: text='~S~how all mounts', command=ToggleHidden
            tooltip: "Show the kernel's own file systems too"
        MenuLine:
        MenuItem: text='~M~ount', command=MountVolume, key='F5'
        MenuItem: text='~U~nmount', command=UnmountVolume, key='F6'
        MenuItem: text='~E~ject', command=EjectVolume, key='F7'
        MenuLine:
        MenuItem: text='Mount ~i~mage...', command=MountImage
            tooltip: "A disk image file (.iso, .img): attached read-only and mounted"
        MenuItem: text='Unmount ima~g~e', command=UnmountImage
            tooltip: "The disk image this volume is on: every file system of it unmounted, and detached"
        MenuLine:
        MenuItem: text='~C~lose', command=CloseWindow
