from navml.widgets.dialog.button import Button
from navml.widgets.dialog.dialog import Dialog
from navml.widgets.dialog.static_text import StaticText
from navml.widgets.dialog.tree_view import TreeView

#: Panel > Change directory (Alt+T): DOS Navigator's ``TTreeDialog``, which
#: ``ChangeDir`` opens as *Choose Directory*.
#:
#: The layout is ``TTreeDialog.Init``'s: the tree fills the left of it with no
#: frame of its own -- the dialog's is its frame, and its scroll bar is its last
#: column -- the path under the cursor is the one row beneath it, and the
#: buttons stand in a column on the right, eleven wide.  ``Dialog``'s own row of
#: buttons along the bottom is not this dialog's, and the hand-written half
#: hides it.
#:
#: **The size is the screen's, not the original's.**  DOS Navigator's was a
#: fixed 49 by 17, which on a modern terminal shows a sliver of a deep tree;
#: this one takes three quarters of the width and four fifths of the height,
#: never less than the original's, and every control inside is placed against
#: the dialog's edges, so they grow with it.  The buttons spread down the
#: column, three rows apart at the original size and wider apart as it grows.
ChangeDirDialog(Dialog):
    modal_width: max(49, min(parent.width - 4, parent.width * 3 // 4)) if parent is not None else 49
    modal_height: max(17, min(parent.height - 2, parent.height * 4 // 5)) if parent is not None else 17
    title: "Choose Directory"
    #: Also opened from another dialog (Alt+T's MkDir, Copy's Tree), and holds
    #: nothing a click could lose.
    close_on_outside_click: True

    TreeView:
        id: tree
        framed: False
        x: 1
        y: 1
        width: max(0, parent.width - 15)
        height: max(0, parent.height - 3)

    #: ``TDTreeInfoView``: one row of it, which shows its first line -- the
    #: path.  Named, so a sheet can give it the information pane's colours.
    StaticText:
        id: where
        name: "info"
        x: 1
        y: max(0, parent.height - 2)
        width: max(0, parent.width - 16)
        height: 1
        text: " " + str(tree.selected_node.data) if tree.selected_node is not None else ""

    Button:
        id: pick
        text: "O~K~"
        default: True
        x: max(0, parent.width - 13)
        y: 2
        width: 11
        height: 2

    #: DOS Navigator chose a drive letter here.  A POSIX filesystem has one
    #: root, so the button is shown, as the original's was, and disabled.
    Button:
        id: drive
        text: "~D~rive..."
        disabled: True
        x: max(0, parent.width - 13)
        y: 2 + max(3, (parent.height - 2) // 5)
        width: 11
        height: 2

    Button:
        id: reread
        text: "~R~e-read"
        x: max(0, parent.width - 13)
        y: 2 + 2 * max(3, (parent.height - 2) // 5)
        width: 11
        height: 2

    Button:
        id: mkdir
        text: "~M~kDir"
        x: max(0, parent.width - 13)
        y: 2 + 3 * max(3, (parent.height - 2) // 5)
        width: 11
        height: 2

    Button:
        id: abandon
        text: "Cancel"
        x: max(0, parent.width - 13)
        y: 2 + 4 * max(3, (parent.height - 2) // 5)
        width: 11
        height: 2
