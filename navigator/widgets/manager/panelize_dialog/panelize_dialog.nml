from navml.widgets.dialog.dialog import Dialog
from navml.widgets.dialog.field import Field
from navml.widgets.dialog.label import Label

#: Panel > Panelize command (Alt+O): the command whose output becomes the
#: panel's listing.  A departure -- Midnight Commander's *External panelize*,
#: which DOS Navigator never had (:mod:`navigator.lib.file_ops.panelize`).
PanelizeDialog(Dialog):
    modal_width: 64
    modal_height: 9
    title: "Panelize command"
    close_on_outside_click: True

    Label:
        id: caption_label
        y: 1
        anchors:
            left: 2
            right: 2
        text: "~C~ommand (one file name a line)"
        link: line.entry

    Field:
        id: line
        y: 2
        anchors:
            left: 2
            right: 2
        label_text: ""
        label_width: 0
        history_id: "panelize"
