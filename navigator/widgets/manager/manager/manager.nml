from navigator.widgets.manager.commands import AdvancedFilter, AlternateEdit, AlternateView, ArcTest, ArchiveFiles
from navigator.widgets.manager.commands import CalculateChecksums, Calculator, ChangeAttributes, ChangeDirectory
from navigator.widgets.manager.commands import ChangeDrive, ChangeInactive, ChangeLeft, ChangeRight, ClearClipboard
from navigator.widgets.manager.commands import CompareDir, ConvertText, Copy, CountLength, CutToClipboard, DecryptFiles
from navigator.widgets.manager.commands import Delete, DeleteSingle, DiffFiles, DirBranch, DirHistory, DiskInfo, Edit
from navigator.widgets.manager.commands import EditLinkTarget, EditNamed, EncryptFiles, EnterWithoutArchive
from navigator.widgets.manager.commands import EqualizePanels, ExtractArchive, ExtractTo, FastRename, FindDuplicates
from navigator.widgets.manager.commands import FindFile, GoInto, GoRoot, GoToFile, GoToTreeDirectory, HideInactive
from navigator.widgets.manager.commands import HideRight, InvertSelection, JumpToDirectory, LinkAbsolute, LinkRelative
from navigator.widgets.manager.commands import ListOfDirs, MakeDirectory, MakeLink, MakeList, MoveSeparator, MultiRename
from navigator.widgets.manager.commands import OpenArchive, PanelSetup, Panelize, PasteFromClipboard, PrintFile
from navigator.widgets.manager.commands import PutInClipboard, QuickRename, QuickView, ReadFileList, RememberDirectory
from navigator.widgets.manager.commands import RememberedDirectories, RenameMove, ReplaceInFiles, Rescan, RestoreTrash
from navigator.widgets.manager.commands import ScrollNames, SelectAll, SelectBadNames, SelectBrokenLinks, SelectGroup
from navigator.widgets.manager.commands import SelectSimilar, SetupColumns, ShowHardLinks, SortBy, SplitCombine
from navigator.widgets.manager.commands import StoreQuickDir, SwapPanels, SwitchPanel, ToggleHidden, ToggleInfoLines
from navigator.widgets.manager.commands import ToggleMark, ToggleMiller, ToggleShowMode, ToggleTree, Undo, UnmountImage
from navigator.widgets.manager.commands import UnselectGroup, UnselectSimilar, UserMenu, UuDecode, UuEncode
from navigator.widgets.manager.commands import VerifyChecksums, View, ViewAsDataBase, ViewAsHex, ViewAsSpreadsheet
from navigator.widgets.manager.commands import ViewAsText
from navigator.widgets.shell.commands import InsertName, InsertPath, ToggleMarkBySpace
from navml.widgets.dialog.commands import QuickSearch
from navigator.widgets.tree.directory_tree import DirectoryTree
from navigator.widgets.manager.info_panel import InfoPanel
from navigator.widgets.manager.miller import MillerView
from navigator.widgets.manager.panel import Panel
from navml.widgets.layout.horizontal_layout import HorizontalLayout
from navml.widgets.menu.menu_item import MenuItem
from navml.widgets.menu.menu_line import MenuLine
from navml.widgets.menu.sub_menu import SubMenu
from navml.widgets.window import Window
from navigator.lib.file_ops.clip import CLIP

#: The file manager: two panels, in a window on the desktop.
#:
#: DOS Navigator's ``TDoubleWindow``, and **frameless**: the two panels'
#: frames are the window's frame, so there is nothing to draw around them.
#: The close and zoom icons go on the panels' top edges and the resize grip on
#: the right panel's corner, which ``Window.render_after`` paints over them.
#:
#: The panels share a row that is bound to the window's size, and the
#: window's is not bound to anything: a drag assigns it, and the row
#: re-arranges the panels because the size it reads is reactive.  Two panels
#: that say nothing split it evenly, the odd column going to the right one.  The window opens zoomed, filling the desktop, which
#: is what the desktop looked like before there was one.
#:
#: Where the two panels open is not here: a panel *navigates* its ``path``, and
#: markup can only bind, so binding it would make ``enter()`` an error rather
#: than a move.  The hand-written half seeds both instead -- see
#: ``manager.py``.
Manager(Window):
    zoomed: True
    min_width: 24
    min_height: 5

    #: The panel keys.  Up, down, the pages and Enter are not here: they move
    #: *within* a panel and are ``ListViewer``'s, reached first along the
    #: focus path.  What is here needs the window -- which panel, and what to
    #: do in it.  F2 to F8 are the key bar's panel half; every one without a
    #: handler in ``manager.py`` is disabled, and greyed on the bar.  The
    #: modified keys below them are the bar's Alt, Ctrl and Shift rows, in
    #: ``StatusDef hcFilePanel``'s order, which is the order the bar shows the
    #: letters in.  Three of DN's commands are not here, a departure: Ctrl+K's
    #: ``descript.ion`` descriptions, Shift+F3's modem phone book and Shift+F6's
    #: FAT undelete (*Reanimator*) can never mean anything on POSIX.  Some of
    #: DN's keys are others' here: Ctrl+K is Alternate edit, Shift+F6 Quick
    #: rename, Shift+F5 Make link (DN's *Split/Combine*, ``cmPanelLongCopy``, is
    #: File > Split/combine's alone), and Alt+I, DN's second (uncaptioned)
    #: ``cmDiskInfo``, the footer toggle (below).
    keys:
        tab: SwitchPanel
        space: ToggleMarkBySpace
        ctrl+enter: InsertName
        alt+enter: InsertName
        ctrl+shift+enter: InsertPath
        alt+shift+enter: InsertPath
        f2: UserMenu
        f3: View
        f4: Edit
        alt+f3: AlternateView
        #: Not DN's: Alt+F4 closes the terminal's own window under many window
        #: managers, so Alternate edit has Ctrl+K too -- first, so the menu shows it.
        ctrl+k: AlternateEdit
        alt+f4: AlternateEdit
        f5: Copy
        f6: RenameMove
        f7: MakeDirectory
        f8: Delete
        alt+b: SortBy
        alt+c: ChangeDrive
        #: The keyboard stays where it was; with Shift it goes to the side
        #: changed (``ChangeDrvLeft``'s ``ShiftState and 3``).
        alt+f1: ChangeLeft
        alt+f2: ChangeRight
        alt+shift+f1: ChangeLeft(focus=True)
        alt+shift+f2: ChangeRight(focus=True)
        alt+s: PanelSetup
        alt+l: MakeList
        alt+f6: FastRename
        shift+f6: QuickRename
        alt+f7: FindFile
        alt+shift+f7: ReplaceInFiles
        alt+r: Rescan
        alt+t: ChangeDirectory
        alt+e: ChangeAttributes
        ctrl+f6: Calculator
        ctrl+f9: PrintFile
        ctrl+f7: UuEncode
        ctrl+f8: UuDecode
        ctrl+l: DiskInfo
        ctrl+p: HideInactive
        ctrl+u: SwapPanels
        alt+f12: ToggleMiller
        alt+=: EqualizePanels
        alt+g: CountLength
        #: Enter without the archive test (DN's Shift); in a *Find:* listing,
        #: ``cmChangeInactive``, which Ctrl+Shift+PgDn is too.
        shift+enter: EnterWithoutArchive
        alt+v: ReadFileList
        alt+y: Panelize
        alt+a: MultiRename
        alt+k: SetupColumns
        alt+delete: AdvancedFilter
        alt+backspace: DirHistory
        alt+j: JumpToDirectory
        ctrl+t: ToggleTree
        ctrl+q: QuickView
        ctrl+y: ToggleShowMode
        ctrl+h: ToggleHidden
        #: The footer toggle, a departure: DN's ``StatusDef hcFilePanel`` had
        #: Alt+I as a second, uncaptioned ``cmDiskInfo`` -- the information
        #: panel's key, which Ctrl+L still is.  The toggle needs a key of its
        #: own, and the option strip's ``[Info]`` names this one.
        alt+i: ToggleInfoLines
        ctrl+r: Rescan
        ctrl+s: QuickSearch
        shift+f1: ArchiveFiles
        shift+f2: ExtractArchive
        shift+f4: EditNamed
        shift+f5: MakeLink
        shift+f8: DeleteSingle

    #: The commands this component handles itself.
    commands:
        ToggleMiller: root.toggle_miller()
        HideRight: await root.toggle_side('right')
        CountLength: root.spawn(root.count_length(root.active_panel))
        UuEncode: root.spawn(root.uu_encode(root.active_panel))
        UuDecode: root.spawn(root.uu_decode(root.active_panel))
        SplitCombine: root.spawn(root.split_combine(root.active_panel))
        CalculateChecksums: root.spawn(root.calculate_checksums(root.active_panel))
        VerifyChecksums: root.spawn(root.verify_checksums(root.active_panel))
        EncryptFiles: root.spawn(root.encrypt_files(root.active_panel))
        DecryptFiles: root.spawn(root.decrypt_files(root.active_panel))
        ConvertText: root.spawn(root.convert_text(root.active_panel))
        ExtractTo: root.spawn(root.extract_files(root.active_panel))
        ArcTest: root.spawn(root.test_archive(root.active_panel))
        GoInto: root.active_panel.go_into()
        OpenArchive: root.active_panel.open_as_archive()
        UnmountImage: root.spawn(root.unmount_image(root.active_panel))
        #: Shift+F1, File > Archive > *Create archive...*: ``cmPanelArcFiles``, DN's
        #: *Archive files* box (``ArchiveDialog``) naming the new archive and
        #: how it is packed, then a copy into it -- which makes it and packs it
        #: (``filecopy._open_target_archive``).  DN's caption was *Copy to
        #: archive*: renamed, a departure asked for, since it makes one.
        ArchiveFiles: root.spawn(root.archive_files(root.active_panel))
        #: The right-click menu's *Go to file*: Enter in a *Find:* listing.
        GoToFile: root.active_panel.go_to_entry()
        ReadFileList: root.spawn(root.read_file_list(root.active_panel))
        Panelize: root.spawn(root.panelize(root.active_panel))
        FindFile: root.spawn(root.find_file(root.active_panel))
        ReplaceInFiles: root.spawn(root.replace_in_files(root.active_panel))
        DirHistory: root.spawn(root.dir_history(root.active_panel))
        StoreQuickDir: root.spawn(root.store_quick_dir(root.active_panel, event.slot))
        #: Alt+Shift+0: ``DoQuickChange``'s list, which is the bookmarks box.
        ListOfDirs: root.spawn(root.choose_bookmark(root.active_panel))
        AdvancedFilter: root.spawn(root.advanced_filter(root.active_panel))
        SetupColumns: root.spawn(root.setup_columns(root.active_panel))
        DirBranch: root.spawn(root.directory_branch(root.active_panel))
        FindDuplicates: root.spawn(root.find_duplicates(root.active_panel))
        FastRename: root.spawn(root.fast_rename(root.active_panel))
        QuickRename: root.spawn(root.quick_rename(root.active_panel))
        MultiRename: root.spawn(root.multi_rename(root.active_panel))
        Undo: root.spawn(root.undo(root.active_panel))
        RestoreTrash: root.spawn(root.restore_trash(root.active_panel))
        MakeList: root.spawn(root.make_list(root.active_panel))
        RememberDirectory: root.spawn(root.remember_directory(root.active_panel))
        RememberedDirectories: root.spawn(root.remembered_directories(root.active_panel))
        PanelSetup: root.spawn(root.panel_setup(root.active_panel))
        CompareDir: root.spawn(root.compare_directories())
        DiffFiles: root.spawn(root.diff_files())
        EqualizePanels: root.equalize_panels()
        SwapPanels: root.swap_panels()
        HideInactive: root.toggle_inactive_side()
        GoToTreeDirectory: await root.tree.choose()
        ChangeLeft: root.spawn(root._change_side('left', event.focus))
        ChangeRight: root.spawn(root._change_side('right', event.focus))
        ChangeDrive: root.spawn(root.choose_bookmark(root.active_panel))
        ScrollNames: root.active_panel.scroll_names(event.step)
        SelectSimilar: root.active_panel.select_similar(event.by, invert=event.invert)
        UnselectSimilar: root.active_panel.select_similar(event.by, select=False, invert=event.invert)
        GoRoot: root.active_panel.go_root()
        #: Insert: tag the active panel's entry and step down.
        ToggleMark: root.active_panel.toggle_mark()
        InvertSelection: root.active_panel.invert_marks(directories=event.directories)
        SelectAll: root.active_panel.select_all()
        UnselectGroup: root.spawn(root.select_group(select=False, invert=event.invert))
        #: Ctrl+Y: the active panel's next show mode -- simple, detailed, list.
        ToggleShowMode: root.active_panel.cycle_view_mode()
        #: Alt+B: the active panel's order, chosen from a box (``CM_SortBy``).
        SortBy: root.spawn(root.choose_sort(root.active_panel))
        #: Ctrl+H: the active panel's dot-files, hidden or shown.
        ToggleHidden: root.active_panel.toggle_hidden()
        #: Alt+I: the active panel's footer, hidden or shown.
        ToggleInfoLines: root.active_panel.toggle_info()
        #: Ctrl+S: the active panel starts its quick search.
        QuickSearch: root.active_panel.start_quick_search()
        ToggleTree: root.toggle_tree()
        QuickView: root.toggle_quick_view()
        #: Ctrl+L: ``cmDiskInfo``, ``SwitchView(dtInfo)``.
        DiskInfo: root.switch_view(root.info)
        #: Ctrl+F9: ``cmPrintFile``, DN's ``CM_Print`` -> ``PrintFiles`` (``GAUGES.PAS``).
        PrintFile: root.spawn(root.print_files())
        #: F5: ``cmCopyFiles``.
        Copy: root.spawn(root.tree_copy(move=False) if root.tree.focused else root.copy_files(move=False))
        #: F6: ``cmMoveFiles``, the same dialog with *Remove source* ticked.
        RenameMove: root.spawn(root.tree_copy(move=True) if root.tree.focused else root.copy_files(move=True))
        #: Ctrl+C, Ctrl+Ins: DN's ``_CtrlIns``, and the entries kept to copy.
        PutInClipboard: root.clip_files(move=False)
        #: Ctrl+X, Ctrl+Del: the same, kept to move.
        CutToClipboard: root.clip_files(move=True)
        #: Ctrl+V, Shift+Ins: what was clipped, into the active panel's directory.
        PasteFromClipboard: root.spawn(root.paste_files())
        ClearClipboard: CLIP.clear()
        #: F8 and Del: ``cmPanelErase`` -- in the Ctrl+T tree, ``EraseDir``.
        Delete: root.spawn(root.tree_erase() if root.tree.focused else root.delete_files(single=False))
        #: Shift+F8 and Shift+Del: ``cmSingleDel``, the cursor's entry whatever is tagged.
        DeleteSingle: root.spawn(root.delete_files(single=True))
        #: Shift+F5: a link -- symbolic or hard -- to each selected entry.
        MakeLink: root.spawn(root.make_links())
        EditLinkTarget: root.spawn(root.edit_link_targets())
        LinkRelative: root.spawn(root.switch_links(relative=True))
        LinkAbsolute: root.spawn(root.switch_links(relative=False))
        SelectBrokenLinks: root.select_broken_links(root.active_panel)
        SelectBadNames: root.select_bad_names(root.active_panel)
        ShowHardLinks: root.spawn(root.show_hard_links(root.active_panel))
        #: Alt+E: ``cmSetFAttr``, the File Attributes dialog over the selection.
        ChangeAttributes: root.spawn(root.change_attributes())
        #: F3: ``cmFileView``, the selected file in a viewer window.
        #:
        #: Or, with *Internal viewer* off in System Setup, what ``viewers.ini``
        #: says for it, else ``$PAGER`` on the console (:meth:`view_file`); and
        #: in hex from the start with the viewer's *Hex mode* on.
        View: root.spawn(root.view_file(True))
        #: Alt+F3, File > Alternate view: ``cmIntFileView``, F3 the other way round.
        AlternateView: root.spawn(root.view_file(False))
        ViewAsText: root.spawn(root.view('text'))
        ViewAsHex: root.spawn(root.view('hex'))
        ViewAsDataBase: root.spawn(root.view('database'))
        ViewAsSpreadsheet: root.spawn(root.view('sheet'))
        #: Alt+F4, File > Alternate edit: ``cmIntFileEdit``, F4 the other way round
        #: -- with *Internal editor* on and nothing in ``editors.ini``, a console
        #: editor in a window (:meth:`console_editor`).
        AlternateEdit: root.spawn(root.edit_file(False))
        #: Shift+F4: ``cmXEditFile``, a file named in a dialog, new or not.
        EditNamed: root.spawn(root.edit_named())

    HorizontalLayout:
        id: panels
        anchors:
            left: 0
            right: 0
            top: 0
            bottom: 0

        Panel:
            id: left
            title_margin: 5

        Panel:
            id: right
            title_margin: 5

        #: The directory tree Ctrl+T puts in the passive panel's place.  Last
        #: here, and hidden; ``manager.py`` moves it beside the panel it
        #: replaces, since a row lays its children out in order.
        #: Typing goes to the command line, as it does from a panel; Ctrl+S
        #: searches it.
        DirectoryTree:
            id: tree
            type_to_search: False

        #: The quick view Ctrl+Q puts there instead is not here: made the
        #: first time it is wanted and added last, hidden (``Manager.quick``).

        #: The information panel Ctrl+L puts there instead (DN's ``TDiskInfo``).
        InfoPanel:
            id: info

        #: Miller columns (Alt+F12), in both panels' place: a departure, asked
        #: for.  Hidden, and empty, until then (``miller_view.py``).
        MillerView:
            id: miller

    #: DOS Navigator's *Panel* menu (``dlgMainMenu``), the file manager's own:
    #: on the main bar after *Utilities*, where DN had it, but only while this
    #: window is the active one -- every entry acts on its panels, and from a
    #: viewer or an editor every one was greyed.
    #:
    #: **Grouped to fit an 80x25 screen**, a departure: the additions had
    #: grown it past twice DN's 21 rows.  DN's own entries stay at the top in
    #: DN's order; what was added goes in *Display*, *Selection* and *Other
    #: panel*, and DN's four selection entries with them, their Gray +/-/*
    #: keys being how they are used.  *Multi-rename* and the archive's
    #: *Extract to*/*Test archive* are File's (``main_menu.nml``).
    #: *Directory tree*, *Info* and *Quick view* are here rather than in
    #: *Manager*, a departure: each puts something in the passive panel's
    #: place, so they are *Other panel*'s.
    SubMenu: text='~P~anel', after='Utilities'
        id: panel_menu
        tooltip: "List files, compare, sort, filter, select and change directory"
        MenuItem: text='~M~ake list file...', command=MakeList, key='Alt-L'
            tooltip: "Write the tagged files' names to a list file"
        MenuItem: text='Read file ~l~ist', command=ReadFileList, key='Alt-V'
            tooltip: "Show the files a list file names as a listing"
        #: A departure: MC's *External panelize* (Panelize's docstring).
        MenuItem: text='Paneli~z~e command...', command=Panelize, key='Alt-Y'
            tooltip: "Run a command and list the files it prints in the panel"
        MenuItem: text='~C~ompare directories', command=CompareDir
            tooltip: "Tag what each panel has that the other lacks or has older"
        MenuItem: text='Count directory len~g~th', command=CountLength, key='Alt-G'
            tooltip: "Add up the bytes under the selected directories"
        MenuItem: text='Directory Branc~h~', command=DirBranch
            tooltip: "Every file below this directory in one listing"
        #: A departure, asked for (FindDuplicates' docstring).
        MenuItem: text='Find duplicates...', command=FindDuplicates
            tooltip: "List the files below this directory whose contents are the same"
        MenuLine:
        MenuItem: text='Setup c~o~lumns', command=SetupColumns, key='Alt-K'
        MenuItem: text='~S~etup Panel', command=PanelSetup, key='Alt-S'
        MenuItem: text='Sort ~b~y...', command=SortBy, key='Alt-B'
        SubMenu: text='D~i~splay'
            id: panel_display
            tooltip: "View mode, hidden files, the footer, directory settings and the divider"
            MenuItem: text='Vie~w~ mode', command=ToggleShowMode, key='Ctrl-Y'
            MenuItem: text='Show/hide h~i~dden files', command=ToggleHidden, key='Ctrl-H'
            MenuItem: text='Show/hide ~f~ooter', command=ToggleInfoLines, key='Alt-I'
            #: Not DN's, which remembered nothing per directory
            #: (``navigator/lib/config/directory_settings.py``).
            SubMenu: text='Director~y~ settings'
                id: panel_remember
                tooltip: "Remember the sort order, view and file mask for a directory, and the list of those remembered"
                MenuItem: text='Remember ~f~or this directory', command=RememberDirectory
                    tooltip: "Keep the sort order, view, columns and file mask shown for this directory"
                MenuItem: text='Remembered director~y~ list...', command=RememberedDirectories
                    tooltip: "The directories with settings of their own: go to one, or forget it"
            MenuLine:
            #: Not on DN's menu, where Alt+Left/Right moved the ``TSeparator``
            #: with no ``cm*`` -- a departure, asked for.
            MenuItem: text='Move divider left', command=MoveSeparator(step=-1), key='Alt-Left'
            MenuItem: text='Move divider right', command=MoveSeparator(step=1), key='Alt-Right'
        SubMenu: text='Selectio~n~'
            id: panel_select
            tooltip: "Select or unselect files by a mask, or filter them"
            MenuItem: text='Select grou~p~...', command=SelectGroup, key='Gray "+"'
            MenuItem: text='~U~nselect group...', command=UnselectGroup, key='Gray "-"'
            MenuItem: text='In~v~ert selection', command=InvertSelection, key='Gray "*"'
            MenuItem: text='Select all files', command=SelectAll, key='Ctrl-A'
                tooltip: "Select every file and directory in this panel"
            MenuLine:
            MenuItem: text='Advanced filter...', command=AdvancedFilter, key='Alt-Del'
                tooltip: "Show or hide files by extension"
        SubMenu: text='Other ~p~anel'
            id: panel_other
            tooltip: "Put a tree, information or a preview in the other panel"
            MenuItem: text='Director~y~ tree', command=ToggleTree, key='Ctrl-T'
            MenuItem: text='I~n~fo', command=DiskInfo, key='Ctrl-L'
                tooltip: "Disk and directory information in the other panel"
            MenuItem: text='Quic~k~ view', command=QuickView, key='Ctrl-Q'
                tooltip: "Preview the file at the cursor in the other panel"
            MenuLine:
            MenuItem: text='S~a~me directory in other panel', command=EqualizePanels, key='Alt-='
                tooltip: "Send the other panel to this directory"
            #: A *Find:* listing's Shift+Enter, which DN had on no menu -- a
            #: departure, asked for.
            MenuItem: text='Show in other panel', command=ChangeInactive, key='Shift-Enter'
                tooltip: "Show the found file in the other panel"
        MenuLine:
        MenuItem: text='Change ~d~rive', command=ChangeDrive, key='Alt-C'
            tooltip: "Send this panel to a bookmarked directory"
        MenuItem: text='Change direc~t~ory', command=ChangeDirectory, key='Alt-T'
            tooltip: "Choose a directory from a tree"
        #: Not DN's: fzf over zoxide's directories and the panels' history.
        MenuItem: text='~J~ump to directory...', command=JumpToDirectory, key='Alt-J'
            tooltip: "zoxide's directories and the panels' history, searched by fzf"
        MenuItem: text='Quick s~e~arch', command=QuickSearch, key='Ctrl-S'
        MenuItem: text='~R~e-read', command=Rescan, key='Alt-R'
        MenuItem: text='~Q~uick dirs...', command=ListOfDirs, key='Alt-Shift-0'
            tooltip: "The bookmarks, for this panel"
        MenuItem: text='History of directories...', command=DirHistory, key='Alt-BkSp'
