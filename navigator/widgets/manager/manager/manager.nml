from navigator.widgets.manager.commands import AlternateEdit, AlternateView, AdvancedFilter, ArchiveFiles, DirHistory, JumpToDirectory, ListOfDirs, Calculator, ChangeAttributes, ChangeDirectory, ChangeInactive, GoToFile
from navigator.widgets.manager.commands import ChangeDrive, ChangeLeft, ChangeRight, CompareDir, Copy, CountLength, Delete, DeleteSingle, DirBranch, DiskInfo, Edit, FindDuplicates
from navigator.widgets.manager.commands import ArcTest, EditNamed, ExtractArchive, ExtractTo, FastRename, FindFile, ReplaceInFiles, HideInactive, MoveSeparator
from navigator.widgets.manager.commands import InvertSelection, MakeDirectory, MakeLink, MakeList, PanelSetup
from navigator.widgets.manager.commands import RememberDirectory, RememberedDirectories
from navigator.widgets.manager.commands import PrintFile, QuickRename, QuickView, ReadFileList, RenameMove, Rescan, Panelize, MultiRename
from navigator.widgets.manager.commands import SelectAll, SelectGroup, SetupColumns, SortBy, SwapPanels, SwitchPanel, EqualizePanels, ToggleMiller
from navigator.widgets.manager.commands import ToggleHidden, ToggleInfoLines, ToggleMark, ToggleShowMode, ToggleTree
from navigator.widgets.manager.commands import UnselectGroup, UserMenu, UuDecode, UuEncode, View
from navigator.widgets.shell.commands import InsertName, InsertPath, ToggleMarkBySpace
from navml.widgets.dialog.commands import QuickSearch
from navigator.widgets.tree.directory_tree import DirectoryTree
from navigator.widgets.viewer.quick_viewer import QuickViewer
from navigator.widgets.manager.info_panel import InfoPanel
from navigator.widgets.manager.miller import MillerView
from navigator.widgets.manager.panel import Panel
from navml.widgets.layout.horizontal_layout import HorizontalLayout
from navml.widgets.menu.menu_item import MenuItem
from navml.widgets.menu.menu_line import MenuLine
from navml.widgets.menu.sub_menu import SubMenu
from navml.widgets.window import Window

#: The file manager: two panels, in a window on the desktop.
#:
#: DOS Navigator's ``TDoubleWindow``, and **frameless**: the two panels'
#: frames are the window's frame, so there is nothing to draw around them.
#: The close and zoom icons go on the panels' top edges and the resize grip on
#: the right panel's corner, which ``Window.render_after`` paints over them.
#:
#: The panels share a row that is bound to the window's size, and the
#: window's is not bound to anything: a drag assigns it, and the row
#: re-arranges the panels because the size it reads is reactive.  Two panels
#: that say nothing split it evenly, the odd column going to the right one.  The window opens zoomed, filling the desktop, which
#: is what the desktop looked like before there was one.
#:
#: Where the two panels open is not here: a panel *navigates* its ``path``, and
#: markup can only bind, so binding it would make ``enter()`` an error rather
#: than a move.  The hand-written half seeds both instead -- see
#: ``manager.py``.
Manager(Window):
    zoomed: True
    min_width: 24
    min_height: 5

    #: The panel keys.  Up, down, the pages and Enter are not here: they move
    #: *within* a panel and are ``ListViewer``'s, reached first along the
    #: focus path.  What is here needs the window -- which panel, and what to
    #: do in it.  F2 to F8 are the key bar's panel half; every one without a
    #: handler in ``manager.py`` is disabled, and greyed on the bar.  The
    #: modified keys below them are the bar's Alt, Ctrl and Shift rows, in
    #: ``StatusDef hcFilePanel``'s order, which is the order the bar shows the
    #: letters in.  Three of DN's are not here, a departure: Ctrl+K's ``descript.ion``
    #: descriptions, Shift+F3's modem phone book and Shift+F6's FAT undelete
    #: (*Reanimator*) can never mean anything on POSIX.
    keys:
        tab: SwitchPanel
        insert: ToggleMark
        space: ToggleMarkBySpace
        ctrl+enter: InsertName
        alt+enter: InsertName
        ctrl+shift+enter: InsertPath
        alt+shift+enter: InsertPath
        f2: UserMenu
        f3: View
        f4: Edit
        alt+f3: AlternateView
        #: Not DN's: Alt+F4 closes the terminal's own window under many window
        #: managers, so Alternate edit has Ctrl+K too -- first, so the menu shows it.
        ctrl+k: AlternateEdit
        alt+f4: AlternateEdit
        f5: Copy
        f6: RenameMove
        f7: MakeDirectory
        f8: Delete
        alt+b: SortBy
        alt+c: ChangeDrive
        #: The keyboard stays where it was; with Shift it goes to the side
        #: changed (``ChangeDrvLeft``'s ``ShiftState and 3``).
        alt+f1: ChangeLeft
        alt+f2: ChangeRight
        alt+shift+f1: ChangeLeft(focus=True)
        alt+shift+f2: ChangeRight(focus=True)
        alt+s: PanelSetup
        alt+l: MakeList
        alt+f6: FastRename
        shift+f6: QuickRename
        alt+f7: FindFile
        alt+shift+f7: ReplaceInFiles
        alt+r: Rescan
        alt+t: ChangeDirectory
        alt+e: ChangeAttributes
        ctrl+f6: Calculator
        ctrl+f9: PrintFile
        ctrl+f7: UuEncode
        ctrl+f8: UuDecode
        ctrl+l: DiskInfo
        ctrl+p: HideInactive
        ctrl+u: SwapPanels
        alt+f12: ToggleMiller
        alt+=: EqualizePanels
        alt+g: CountLength
        shift+enter: ChangeInactive
        alt+v: ReadFileList
        alt+y: Panelize
        alt+a: MultiRename
        alt+k: SetupColumns
        alt+delete: AdvancedFilter
        alt+backspace: DirHistory
        alt+j: JumpToDirectory
        ctrl+t: ToggleTree
        ctrl+q: QuickView
        ctrl+y: ToggleShowMode
        ctrl+h: ToggleHidden
        alt+i: ToggleInfoLines
        ctrl+r: Rescan
        ctrl+s: QuickSearch
        shift+f1: ArchiveFiles
        shift+f2: ExtractArchive
        shift+f4: EditNamed
        shift+f5: MakeLink
        shift+f8: DeleteSingle

    HorizontalLayout:
        id: panels
        x: 0
        y: 0
        width: parent.width
        height: parent.height

        Panel:
            id: left
            title_margin: 5

        Panel:
            id: right
            title_margin: 5

        #: The directory tree Ctrl+T puts in the passive panel's place.  Last
        #: here, and hidden; ``manager.py`` moves it beside the panel it
        #: replaces, since a row lays its children out in order.
        #: Typing goes to the command line, as it does from a panel; Ctrl+S
        #: searches it.
        DirectoryTree:
            id: tree
            type_to_search: False

        #: The quick view Ctrl+Q puts there instead, placed the same way.
        #: Its title keeps clear of the window icons, as a panel's does.
        QuickViewer:
            id: quick
            title_margin: 5

        #: The information panel Ctrl+L puts there instead (DN's ``TDiskInfo``).
        InfoPanel:
            id: info

        #: Miller columns (Alt+F12), in both panels' place: a departure, asked
        #: for.  Hidden, and empty, until then (``miller_view.py``).
        MillerView:
            id: miller

    #: DOS Navigator's *Panel* menu (``dlgMainMenu``), the file manager's own:
    #: on the main bar after *Utilities*, where DN had it, but only while this
    #: window is the active one -- every entry acts on its panels, and from a
    #: viewer or an editor every one was greyed.
    #:
    #: **Grouped to fit an 80x25 screen**, a departure: the additions had
    #: grown it past twice DN's 21 rows.  DN's own entries stay at the top in
    #: DN's order; what was added goes in *Display*, *Selection* and *Other
    #: panel*, and DN's four selection entries with them, their Gray +/-/*
    #: keys being how they are used.  *Multi-rename* and the archive's
    #: *Extract to*/*Test archive* are File's (``main_menu.nml``).
    #: *Directory tree*, *Info* and *Quick view* are here rather than in
    #: *Manager*, a departure: each puts something in the passive panel's
    #: place, so they are *Other panel*'s.
    SubMenu:
        id: panel_menu
        text: '~P~anel'
        tooltip: "List files, compare, sort, filter, select and change directory"
        after: 'Utilities'
        MenuItem:
            text: '~M~ake list file...'
            tooltip: "Write the tagged files' names to a list file"
            command: MakeList
            key: 'Alt-L'
        MenuItem:
            text: 'Read file ~l~ist'
            tooltip: "Show the files a list file names as a listing"
            command: ReadFileList
            key: 'Alt-V'
        #: A departure: MC's *External panelize* (Panelize's docstring).
        MenuItem:
            text: 'Paneli~z~e command...'
            tooltip: "Run a command and list the files it prints in the panel"
            command: Panelize
            key: 'Alt-Y'
        MenuItem:
            text: '~C~ompare directories'
            tooltip: "Tag what each panel has that the other lacks or has older"
            command: CompareDir
        MenuItem:
            text: 'Count directory len~g~th'
            tooltip: "Add up the bytes under the selected directories"
            command: CountLength
            key: 'Alt-G'
        MenuItem:
            text: 'Directory Branc~h~'
            tooltip: "Every file below this directory in one listing"
            command: DirBranch
        #: A departure, asked for (FindDuplicates' docstring).
        MenuItem:
            text: 'Find duplicates...'
            tooltip: "List the files below this directory whose contents are the same"
            command: FindDuplicates
        MenuLine:
        MenuItem:
            text: 'Setup c~o~lumns'
            command: SetupColumns
            key: 'Alt-K'
        MenuItem:
            text: '~S~etup Panel'
            command: PanelSetup
            key: 'Alt-S'
        MenuItem:
            text: 'Sort ~b~y...'
            command: SortBy
            key: 'Alt-B'
        SubMenu:
            id: panel_display
            text: 'D~i~splay'
            tooltip: "View mode, hidden files, the footer, directory settings and the divider"
            MenuItem:
                text: 'Vie~w~ mode'
                command: ToggleShowMode
                key: 'Ctrl-Y'
            MenuItem:
                text: 'Show/hide h~i~dden files'
                command: ToggleHidden
                key: 'Ctrl-H'
            MenuItem:
                text: 'Show/hide ~f~ooter'
                command: ToggleInfoLines
                key: 'Alt-I'
            #: Not DN's, which remembered nothing per directory
            #: (``navigator/lib/config/directory_settings.py``).
            SubMenu:
                id: panel_remember
                text: 'Director~y~ settings'
                tooltip: "Remember the sort order, view and file mask for a directory, and the list of those remembered"
                MenuItem:
                    text: 'Remember ~f~or this directory'
                    tooltip: "Keep the sort order, view, columns and file mask shown for this directory"
                    command: RememberDirectory
                MenuItem:
                    text: 'Remembered director~y~ list...'
                    tooltip: "The directories with settings of their own: go to one, or forget it"
                    command: RememberedDirectories
            MenuLine:
            #: Not on DN's menu, where Alt+Left/Right moved the ``TSeparator``
            #: with no ``cm*`` -- a departure, asked for.
            MenuItem:
                text: 'Move divider left'
                command: MoveSeparator(step=-1)
                key: 'Alt-Left'
            MenuItem:
                text: 'Move divider right'
                command: MoveSeparator(step=1)
                key: 'Alt-Right'
        SubMenu:
            id: panel_select
            text: 'Selectio~n~'
            tooltip: "Select or unselect files by a mask, or filter them"
            MenuItem:
                text: 'Select grou~p~...'
                command: SelectGroup
                key: 'Gray "+"'
            MenuItem:
                text: '~U~nselect group...'
                command: UnselectGroup
                key: 'Gray "-"'
            MenuItem:
                text: 'In~v~ert selection'
                command: InvertSelection
                key: 'Gray "*"'
            MenuItem:
                text: 'Select all files'
                tooltip: "Select every file and directory in this panel"
                command: SelectAll
                key: 'Ctrl-A'
            MenuLine:
            MenuItem:
                text: 'Advanced filter...'
                tooltip: "Show or hide files by extension"
                command: AdvancedFilter
                key: 'Alt-Del'
        SubMenu:
            id: panel_other
            text: 'Other ~p~anel'
            tooltip: "Put a tree, information or a preview in the other panel"
            MenuItem:
                text: 'Director~y~ tree'
                command: ToggleTree
                key: 'Ctrl-T'
            MenuItem:
                text: 'I~n~fo'
                tooltip: "Disk and directory information in the other panel"
                command: DiskInfo
                key: 'Ctrl-L'
            MenuItem:
                text: 'Quic~k~ view'
                tooltip: "Preview the file at the cursor in the other panel"
                command: QuickView
                key: 'Ctrl-Q'
            MenuLine:
            MenuItem:
                text: 'S~a~me directory in other panel'
                tooltip: "Send the other panel to this directory"
                command: EqualizePanels
                key: 'Alt-='
            #: A *Find:* listing's Shift+Enter, which DN had on no menu -- a
            #: departure, asked for.
            MenuItem:
                text: 'Show in other panel'
                tooltip: "Show the found file in the other panel"
                command: ChangeInactive
                key: 'Shift-Enter'
        MenuLine:
        MenuItem:
            text: 'Change ~d~rive'
            tooltip: "Send this panel to a bookmarked directory"
            command: ChangeDrive
            key: 'Alt-C'
        MenuItem:
            text: 'Change direc~t~ory'
            tooltip: "Choose a directory from a tree"
            command: ChangeDirectory
            key: 'Alt-T'
        #: Not DN's: fzf over zoxide's directories and the panels' history.
        MenuItem:
            text: '~J~ump to directory...'
            tooltip: "zoxide's directories and the panels' history, searched by fzf"
            command: JumpToDirectory
            key: 'Alt-J'
        MenuItem:
            text: 'Quick s~e~arch'
            command: QuickSearch
            key: 'Ctrl-S'
        MenuItem:
            text: '~R~e-read'
            command: Rescan
            key: 'Alt-R'
        MenuItem:
            text: '~Q~uick dirs...'
            tooltip: "The bookmarks, for this panel"
            command: ListOfDirs
            key: 'Alt-Shift-0'
        MenuItem:
            text: 'History of directories...'
            command: DirHistory
            key: 'Alt-BkSp'
