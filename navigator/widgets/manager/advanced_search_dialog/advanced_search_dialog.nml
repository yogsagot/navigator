from navml.widgets.dialog.button import Button
from navml.widgets.dialog.check_boxes import CheckBoxes
from navml.widgets.dialog.dialog import Dialog
from navml.widgets.dialog.field import Field
from navml.widgets.dialog.label import Label

#: *Find File*'s *Advanced...*: DOS Navigator's ``dlgAdvanceSearch``.
#:
#: Its four lines and its kinds, and OK, *Clear all* and Cancel -- along the
#: bottom, where this library puts a dialog's buttons, rather than down the
#: right.  Dates are ``YYYY-MM-DD`` with an optional ``HH:MM``; the kinds are
#: POSIX's, where DN's were the four DOS attributes, and a fifth, *Broken
#: link*, is Navigator's own (:mod:`navigator.lib.file_ops.filefind`).
AdvancedSearchDialog(Dialog):
    modal_width: 52
    modal_height: 17
    title: "Advanced search"
    help_topic: "panels.md#advanced-search"
    buttons: "none"

    buttons_row: (pick, clear, abandon)

    #: DN's ``hsFindAfter``.
    Field:
        id: after
        x: 2
        y: 2
        width: 38
        label_text: "Date is ~a~fter"
        label_width: 22
        history_id: "find_after"

    #: DN's ``hsFindBefore``.
    Field:
        id: before
        x: 2
        y: 3
        width: 38
        label_text: "Date is ~b~efore"
        label_width: 22
        history_id: "find_before"

    Field:
        id: greater
        x: 2
        y: 5
        width: 36
        label_text: "Size is ~g~reater than"
        label_width: 22

    Field:
        id: less
        x: 2
        y: 6
        width: 36
        label_text: "Size is ~l~ess than"
        label_width: 22

    Label:
        id: kinds_caption
        x: 3
        y: 8
        width: 12
        text: "Kind"
        link: kinds

    CheckBoxes:
        id: kinds
        y: 9
        height: 3
        anchors:
            left: 3
            right: 3
        items: ["E~x~ecutable", "S~y~mbolic link", "H~i~dden", "R~e~ad-only", "Broke~n~ link"]

    Button:
        id: pick
        text: "O~K~"
        default: True
        x: 3
        width: 11
        height: 2
        anchors:
            bottom: 2

    #: DN's command 3222.
    Button:
        id: clear
        text: "~C~lear all"
        x: 16
        width: 14
        height: 2
        anchors:
            bottom: 2

    Button:
        id: abandon
        text: "Cancel"
        x: 32
        width: 11
        height: 2
        anchors:
            bottom: 2
