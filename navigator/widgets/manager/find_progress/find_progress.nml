from navml.widgets.dialog.dialog import Dialog
from navml.widgets.dialog.static_text import StaticText

#: A search under way: the ``TWhileView`` ``FindFile`` put on the desktop,
#: titled ``dlDBViewSearch`` -- the directory being looked in, and how many
#: have been found (``dlFilesFound``).  Its *Stop* (DN's ``dlStop``) asks
#: *Cancel search?* before anything stops, as ``dlQueryCancelSearch`` did.
FindProgress(Dialog):
    modal_width: 56
    modal_height: 8
    title: "Search"
    buttons: "ok"
    closable: False

    property directory: ""
    property count: 0

    StaticText:
        id: directory_row
        y: 1
        anchors:
            left: 2
            right: 2
        align: "center"
        text: root.fit(root.directory)

    StaticText:
        id: count_row
        y: 2
        anchors:
            left: 2
            right: 2
        align: "center"
        text: (str(root.count) + " files found") if root.count else "No files found"
