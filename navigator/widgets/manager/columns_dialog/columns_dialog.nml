from navml.widgets.dialog.button import Button
from navml.widgets.dialog.button_row import ButtonRow
from navml.widgets.dialog.check_boxes import CheckBoxes
from navml.widgets.dialog.dialog import Dialog
from navml.widgets.dialog.label import Label

#: Alt+K, Panel > Setup columns: DOS Navigator's ``dlgDiskParms`` (and, for a
#: *Find:* listing, ``dlgFindParms``, less its last box, the path: a
#: departure, the directory being a footer line of its own here).
#:
#: *Show* and its boxes, OK, *Brief*, *Full* and Cancel, where DN had them
#: down the right and along the bottom; the boxes are the detailed mode's
#: columns -- POSIX's size, attributes, link count, owner and date, where DN's were size,
#: date, time and descriptions, which ``descript.ion`` went with.
ColumnsDialog(Dialog):
    modal_width: 40
    modal_height: 13
    title: "Columns Setup"
    buttons: "none"

    buttons_row: (pick, abandon, brief, full)

    Label:
        id: show_caption
        x: 3
        y: 1
        width: 6
        text: "Show"
        link: show

    CheckBoxes:
        id: show
        x: 3
        y: 2
        width: 20
        height: 5
        items: ["~S~ize", "~A~ttributes", "L~i~nks", "~O~wner", "~D~ate"]

    #: DN's ``cmYes``: names alone.
    Button:
        id: brief
        text: "~B~rief"
        x: 26
        y: 2
        width: 11
        height: 2
        on_click: root.close(('brief',))

    #: DN's ``cmNo``: every column (``GetFullFlags``).
    Button:
        id: full
        text: "~F~ull"
        x: 26
        y: 5
        width: 11
        height: 2
        on_click: root.close(('full',))

    ButtonRow:
        justify: "start"
        anchors:
            left: 7
            right: 0
            bottom: 2

        Button:
            id: pick
            text: "O~K~"
            default: True
            on_click: root.close(root.accept())

        Button:
            id: abandon
            text: "Cancel"
