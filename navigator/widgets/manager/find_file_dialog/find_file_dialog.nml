from navml.widgets.dialog.button import Button
from navml.widgets.dialog.check_boxes import CheckBoxes
from navml.widgets.dialog.commands import Help
from navml.widgets.dialog.dialog import Dialog
from navml.widgets.dialog.field import Field
from navml.widgets.dialog.label import Label
from navml.widgets.dialog.radio_buttons import RadioButtons

#: Alt+F7, File > Find...: DOS Navigator's ``dlgFileFind``.
#:
#: Its rows as ``DN.DNR`` lays them, two columns wider and a row taller for
#: this library's buttons; DN's own row of OK, *Advanced...*, Cancel and
#: Help, ten wide and touching from column 3 as the resource has them.
#: Cancel carries no letter, as the resource's did: ``~C~`` is *Case
#: sensitive*'s.
#:
#: Not DN's: *Regular expression* among the options, a row lower for it, and,
#: with *replacing*, File > Replace in files' *Replace with* line under the
#: text, the rest two rows lower (``navigator.lib.file_ops.filereplace``).
FindFileDialog(Dialog):
    #: File > Replace in files rather than Find file.
    property replacing: False

    modal_width: 52
    modal_height: 21 if root.replacing else 19
    title: "Replace in Files" if root.replacing else "Find File"
    help_topic: "panels.md#replace-in-files" if root.replacing else "panels.md#find-file"
    buttons: "none"

    buttons_row: (pick, advanced, abandon, helper)

    #: DN's ``hsFindMask``.
    Field:
        id: mask
        y: 2
        anchors:
            left: 2
            right: 2
        label_text: "~F~ile mask"
        label_width: 14
        history_id: "find_mask"

    #: DN's ``hsFindText``.
    Field:
        id: text
        y: 4
        anchors:
            left: 2
            right: 2
        label_text: "~T~ext to find"
        label_width: 14
        history_id: "find_text"

    #: Not DN's: what replaces the text, ``\1`` a group's with *Regular expression*.
    Field:
        id: replacement
        visible: root.replacing
        y: 6
        anchors:
            left: 2
            right: 2
        label_text: "Rep~l~ace with"
        label_width: 14
        history_id: "replace_text"

    Label:
        id: options_caption
        x: 3
        width: 12
        anchors:
            below: replacement, text + 1
        text: "Options"
        link: options

    CheckBoxes:
        id: options
        height: 3
        anchors:
            left: 3
            right: 3
            below: options_caption
        items: ["Adva~n~ced search", "~C~ase sensitive", "~R~ecursive search", "~W~hole words", "Regular e~x~pression"]
        tooltips: ["Also match the size, date and kind set by Advanced...", "", "Search the subdirectories too", "", "The text is a Python regular expression, matched across lines"]

    Label:
        id: scope_caption
        x: 3
        width: 10
        anchors:
            below: options + 1
        text: "Scope"
        link: scope

    RadioButtons:
        id: scope
        height: 2
        anchors:
            left: 3
            right: 3
            below: scope_caption
        items: ["~E~ntire disk", "Current ~d~irectory", "~A~ll drives"]

    Button:
        id: pick
        text: "O~K~"
        default: True
        x: 3
        width: 10
        height: 2
        anchors:
            bottom: 2

    #: DN's command 3223: *Advanced search*'s own dialog.
    Button:
        id: advanced
        text: "Ad~v~anced..."
        x: 13
        width: 15
        height: 2
        anchors:
            bottom: 2
        on_click: root.spawn(root.ask_advanced())

    Button:
        id: abandon
        text: "Cancel"
        x: 28
        width: 10
        height: 2
        anchors:
            bottom: 2

    #: ``cmHelp``: asks as F1 does, for ``help_topic`` above.
    Button:
        id: helper
        text: "Help"
        command: Help
        x: 38
        width: 10
        height: 2
        anchors:
            bottom: 2
