from navml.widgets.dialog.button import Button
from navml.widgets.dialog.button_row import ButtonRow
from navml.widgets.dialog.check_boxes import CheckBoxes
from navml.widgets.dialog.commands import Help
from navml.widgets.dialog.dialog import Dialog
from navml.widgets.dialog.label import Label
from navml.widgets.dialog.radio_buttons import RadioButtons

#: Panel > Compare directories: DOS Navigator's ``dlgCompareDirs``.
#:
#: *Options* over *Selection mode*, as ``DN.DNR`` stacks them; the buttons go
#: under them rather than down the right, where this library puts every
#: dialog's: OK, Cancel and Help.
#:
#: **A departure**: a third mode, *Window, recursive* -- what differs down
#: both trees, listed in the *Synchronize* window (``SyncWindow``) rather
#: than tagged.  Select stays first and is chosen every time, so the dialog
#: opens as DN's did.
CompareDialog(Dialog):
    help_topic: "compare.md#compare-directories"
    modal_width: 34
    modal_height: 16
    title: "Compare directories"
    buttons: "none"

    buttons_row: (pick, abandon, helper)

    Label:
        id: options_caption
        x: 2
        y: 1
        width: 12
        text: "Options"
        link: options

    #: Size and time ticked, as ``DT.O := 3`` opened it every time.
    CheckBoxes:
        id: options
        x: 2
        y: 2
        width: 26
        height: 4
        items: ["Compare ~s~ize", "Compare ~t~ime", "Compare ~a~ttributes", "Compare ~c~ontents"]
        tooltips: ["Files of different sizes are different", "A newer file is different from an older one", "Files with different permissions are different", "Read files of the same size through and compare them: slow, but certain"]
        value: 3

    Label:
        id: mode_caption
        x: 2
        y: 7
        width: 16
        text: "Selection mode"
        link: mode

    RadioButtons:
        id: mode
        x: 2
        y: 8
        width: 26
        height: 3
        items: ["S~e~lect", "~U~nselect", "~W~indow, recursive"]

    #: ``dlgCompareDirs``'s OK, Cancel and Help: DN's ten-wide buttons with nothing between them, which is what three need in this width -- along the bottom, not down the right.
    ButtonRow:
        justify: "start"
        button_width: 10
        spacing: 0
        anchors:
            left: 2
            right: 0
            bottom: 2

        Button:
            id: pick
            text: "O~K~"
            default: True

        Button:
            id: abandon
            text: "Cancel"

        #: ``cmHelp``: asks as F1 does, for ``help_topic`` above.
        Button:
            id: helper
            text: "Help"
            command: Help
