from navkit.bidi import display_width
from navigator.widgets.manager.commands import DiffFiles, Rescan, SetAllSyncActions, SetSyncAction, Synchronize, SyncSetup, ToggleHidden, ToggleSyncShow, ToggleTree
from navigator.widgets.manager.sync_list import SyncList
from navml.commands import CloseWindow
from navml.widgets.dialog.button import Button
from navml.widgets.dialog.check_boxes import CheckBoxes
from navml.widgets.dialog.commands import SelectNext, SelectPrevious
from navml.widgets.dialog.static_text import StaticText
from navml.widgets.menu.menu_item import MenuItem
from navml.widgets.menu.menu_line import MenuLine
from navml.widgets.menu.sub_menu import SubMenu
from navml.widgets.window import Window

#: *Compare directories*' *Window, recursive*: every path below the two
#: panels' directories that is on one side alone, or differs from its
#: namesake, a row each with what is to be done with it.
#:
#: **Not DOS Navigator's**: a departure, asked for.  DN compared one level and
#: tagged (``CM_CompareDirs``); this is Total Commander's *Synchronize
#: directories*, whose keys it takes -- Right and Left copy a row that way,
#: Space leaves it, Del deletes it from the one side it is on, Backspace gives
#: it back what its status suggests; Ctrl+Right and Ctrl+Left set every row.
#: Enter or F3 on a pair that differs compares the two files side by side
#: (``DiffWindow``).  F5, or *Synchronize*, does it all: the copies as one
#: F5 copy, files kept with their times so the next compare finds them the
#: same, then the deletes as one F8.
#:
#: *Tree view* -- or Ctrl+T -- shows the rows under their directories, a tree (``SyncList.tree``):
#: an action on a directory acts on every row beneath it that allows it;
#: Gray + and - and Enter open and close one, * opens them all.
#:
#: Laid out as Disk > Volumes is: the list without a frame of its own, a
#: dialog's rows under it.  The *Show* boxes say which rows are listed --
#: on the left alone, on the right alone, different, identical (Ctrl+H, as
#: it shows a panel's dot-files) -- and only what is listed is synchronized,
#: as in Total Commander.  *Options* (``SyncOptionsDialog``) has the file
#: mask, how near two times are the same, and *Asymmetric*; Ctrl+R and Alt+R
#: compare again.
SyncWindow(Window):
    title: "Synchronize"
    #: Zoomed, as the viewer's window: a path wants every column it can get.
    zoomed: True

    keys:
        escape: CloseWindow
        enter: DiffFiles
        f3: DiffFiles
        f5: Synchronize
        ctrl+r: Rescan
        alt+r: Rescan
        ctrl+h: ToggleHidden
        ctrl+t: ToggleTree
        tab: SelectNext
        shift+tab: SelectPrevious

    SyncList:
        id: rows
        framed: False
        anchors:
            left: 1
            right: 0
            top: 1
            bottom: 5

    #: Over the bottom frame, a column in, as the viewer's info line: the row
    #: under the cursor's two times, or why it is a conflict.
    StaticText:
        id: info
        name: "info"
        x: 1
        width: min(display_width(self.text), max(0, parent.width - 3))
        height: 1
        anchors:
            bottom: 0

    #: Which rows are listed, a box a kind (``dirsync.SHOW_GROUPS``), one row.
    CheckBoxes:
        id: show
        height: 1
        anchors:
            left: 2
            right: 2
            bottom: 4
        items: ["Le~f~t only", "Ri~g~ht only", "~D~ifferent", "~I~dentical"]
        tooltips: ["List what only the left side has", "List what only the right side has", "List the files that differ, and the conflicts", "List the files that are the same on both sides too"]

    #: The tree view, as Ctrl+T and the menu switch it: in sight, so it is found.
    CheckBoxes:
        id: tree_box
        x: 2
        width: 18
        height: 1
        anchors:
            bottom: 3
        items: ["~T~ree view"]
        tooltips: ["Show the rows under their directories, as a tree"]

    StaticText:
        id: summary
        height: 1
        anchors:
            left: 2
            right: 2
            bottom: 1

    Button:
        id: options_button
        text: "O~p~tions"
        tooltip: "The file mask, how near two times are the same, and Asymmetric"
        width: 12
        height: 2
        anchors:
            right: 33
            bottom: 2

    Button:
        id: sync_button
        text: "~S~ynchronize"
        width: 16
        height: 2
        anchors:
            right: 15
            bottom: 2

    Button:
        id: close_button
        text: "Close"
        width: 10
        height: 2
        anchors:
            right: 3
            bottom: 2

    #: The window's own menu on the bar after *File* while it is active, and
    #: its right-click menu.
    SubMenu:
        id: sync_menu
        text: '~S~ynchronize'
        tooltip: "Choose what happens to each file, then synchronize"
        after: 'File'
        MenuItem:
            text: '~S~ynchronize'
            command: Synchronize
        MenuItem:
            text: '~C~ompare files'
            command: DiffFiles
        MenuLine:
        MenuItem:
            text: 'Copy ~r~ight'
            command: SetSyncAction('right')
        MenuItem:
            text: 'Copy ~l~eft'
            command: SetSyncAction('left')
        MenuItem:
            text: '~D~elete'
            command: SetSyncAction('delete')
        MenuItem:
            text: 'S~k~ip'
            command: SetSyncAction('skip')
        MenuItem:
            text: 'D~e~fault action'
            tooltip: "Give the row back the action the comparison chose"
            command: SetSyncAction('default')
        MenuLine:
        MenuItem:
            text: '~A~ll right'
            command: SetAllSyncActions('right')
        MenuItem:
            text: 'All le~f~t'
            command: SetAllSyncActions('left')
        MenuItem:
            text: 'All defa~u~lt'
            tooltip: "Give every row back the action the comparison chose"
            command: SetAllSyncActions('default')
        MenuLine:
        MenuItem:
            text: 'Compare a~g~ain'
            command: Rescan
        #: The four list filters nested, so the box keeps clear of an 80x25
        #: screen's last row; the window's Show check boxes do the same.
        SubMenu:
            id: sync_menu_show
            text: 'Sho~w~'
            tooltip: "Which rows the list shows"
            MenuItem:
                text: 'Show left o~n~ly'
                tooltip: "List what only the left side has"
                command: ToggleSyncShow(0)
            MenuItem:
                text: 'Show right onl~y~'
                tooltip: "List what only the right side has"
                command: ToggleSyncShow(1)
            MenuItem:
                text: 'Sho~w~ different'
                tooltip: "List the files that differ, and the conflicts"
                command: ToggleSyncShow(2)
            MenuItem:
                text: 'Show ~i~dentical'
                tooltip: "List the files that are the same on both sides too"
                command: ToggleHidden
        MenuItem:
            text: '~T~ree view'
            tooltip: "Show the rows under their directories, as a tree"
            command: ToggleTree
        MenuItem:
            text: 'O~p~tions...'
            tooltip: "The file mask, how near two times are the same, and Asymmetric"
            command: SyncSetup
        MenuLine:
        MenuItem:
            text: 'Cl~o~se'
            command: CloseWindow
