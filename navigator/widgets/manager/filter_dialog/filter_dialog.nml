from navigator.widgets.manager.filter_dialog.filter_list import FilterList
from navml.widgets.dialog.button import Button
from navml.widgets.dialog.button_row import ButtonRow
from navml.widgets.dialog.dialog import Dialog

#: Alt+Del, Panel > Selection > Advanced filter: DOS Navigator's ``dlgAdvancedFilter``.
#:
#: The list of masks over *Show*, *Hide* and *Close*, as ``DN.DNR`` and
#: ``MakeDialog`` laid them out, a column wider.  No Help button: the resource has none.
FilterDialog(Dialog):
    modal_width: 38
    modal_height: 16
    title: "Filter"
    help_topic: "panels.md#filter"
    buttons: "none"

    buttons_row: (show, hide, abandon)

    FilterList:
        id: masks
        anchors:
            left: 3
            right: 3
            top: 2
            bottom: 5

    #: DN's ``cmOK``: what is marked, shown.
    ButtonRow:
        justify: "start"
        button_width: 10
        spacing: 1
        anchors:
            left: 2
            right: 0
            bottom: 2

        Button:
            id: show
            text: "~S~how"
            default: True
            on_click: root._answer(True)

        #: DN's ``cmNo``: what is marked, hidden.
        Button:
            id: hide
            text: "~H~ide"
            on_click: root._answer(False)

    Button:
        id: abandon
        text: "Close"
        x: 24
        width: 11
        height: 2
        anchors:
            bottom: 2
