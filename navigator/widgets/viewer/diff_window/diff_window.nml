from navkit.bidi import display_width
from navigator.widgets.manager.commands import Rescan
from navigator.widgets.viewer.commands import CloseViewer, NextDifference, PreviousDifference
from navigator.widgets.viewer.diff_view import DiffView
from navml.commands import CloseWindow
from navml.widgets.dialog.scroll_bar import ScrollBar
from navml.widgets.dialog.static_text import StaticText
from navml.widgets.menu.menu_item import MenuItem
from navml.widgets.menu.menu_line import MenuLine
from navml.widgets.menu.sub_menu import SubMenu
from navml.widgets.window import Window

#: File > Compare files: two files side by side, line against line.
#:
#: **A departure**: DOS Navigator had no such window -- its only comparison
#: of files said whether they were the same (``CompareFiles``, behind
#: *Compare directories*).  This is Midnight Commander's ``mcdiff`` and meld's:
#: the two files in two columns under their paths, what one lacks faced by a
#: filler row, the differences coloured and marked.  Laid out as the viewer's
#: window is (``FileWindow``): opened zoomed, the view inside the frame, the
#: scroll bar on its right column and the info line over its bottom one.
#:
#: The keys are ``mcdiff``'s N and P and meld's Alt+Down and Alt+Up for the
#: next and previous difference; F3 and Esc close it, as the viewer's; Ctrl+R
#: and Alt+R compare the two files again, as they re-read a panel.
DiffWindow(Window):
    zoomed: True

    keys:
        escape: CloseWindow
        f3: CloseViewer
        n: NextDifference
        alt+down: NextDifference
        p: PreviousDifference
        alt+up: PreviousDifference
        ctrl+r: Rescan
        alt+r: Rescan

    DiffView:
        id: view
        x: 1
        y: 1
        width: max(0, parent.width - 2)
        height: max(0, parent.height - 2)

    #: On the frame's right column, as the viewer's; its value is the row on top.
    ScrollBar:
        id: bar
        x: parent.width - 1
        y: 2
        width: 1
        height: max(0, parent.height - 3)
        value: view.top
        maximum: view.last_top
        page: view.page

    #: Over the bottom frame, a column in, as the viewer's ``TViewInfo``.
    StaticText:
        id: info
        name: "info"
        x: 1
        y: max(0, parent.height - 1)
        width: min(display_width(view.info_text), max(0, parent.width - 3))
        height: 1
        text: view.info_text

    #: The window's own menu on the bar after *File* while it is active, and
    #: its right-click menu.
    SubMenu:
        id: compare_menu
        text: '~C~ompare'
        tooltip: "Step through the differences"
        after: 'File'
        MenuItem:
            text: '~N~ext difference'
            command: NextDifference
        MenuItem:
            text: '~P~revious difference'
            command: PreviousDifference
        MenuLine:
        MenuItem:
            text: '~C~ompare again'
            command: Rescan
        MenuLine:
        MenuItem:
            text: 'C~l~ose'
            command: CloseWindow
