from navml.widgets.dialog.button import Button
from navml.widgets.dialog.button_row import ButtonRow
from navml.widgets.dialog.commands import Help
from navml.widgets.dialog.check_boxes import CheckBoxes
from navml.widgets.dialog.dialog import Dialog
from navml.widgets.dialog.field import Field
from navml.widgets.dialog.label import Label
from navml.widgets.dialog.radio_buttons import RadioButtons

#: F7 in the dBase viewer: DOS Navigator's ``dlgDbFind`` -- the text, *Case
#: sensitive*, the scope and the direction, in the resource's places.  A row
#: taller than its 55 by 12 for this library's buttons.
DBSearchDialog(Dialog):
    modal_width: 55
    modal_height: 13
    title: "Search"
    help_topic: "viewer.md#searching-a-table"
    buttons: "none"

    buttons_row: (pick, abandon, helper)

    #: DN's ``hsdbSearch``.
    Field:
        id: text
        y: 2
        anchors:
            left: 2
            right: 2
        label_text: "~T~ext to search"
        label_width: 16
        history_id: "dbsearch"

    #: Two columns further left than DN's, so a longer caption than
    #: "Options" (Latvian "Iestatījumi") still ends before the box.
    Label:
        id: options_caption
        x: 1
        y: 4
        width: 11
        text: "Options"
        link: options

    CheckBoxes:
        id: options
        x: 12
        y: 4
        width: 20
        height: 1
        items: ["~C~ase sensitive"]

    Label:
        id: scope_caption
        x: 5
        y: 6
        width: 6
        text: "Scope"
        link: scope

    RadioButtons:
        id: scope
        x: 12
        y: 6
        width: 21
        height: 2
        items: ["~I~n cursor field", "~A~ll fields"]

    Label:
        id: direction_caption
        x: 35
        y: 4
        width: 10
        text: "Direction"
        link: direction

    RadioButtons:
        id: direction
        x: 35
        y: 5
        width: 18
        height: 3
        items: ["~F~orward", "~B~ackward", "~E~ntire scope"]

    #: ``dlgDbFind``'s own row: OK, Cancel and Help ten wide from column 14.
    ButtonRow:
        justify: "start"
        button_width: 10
        spacing: 2
        anchors:
            left: 14
            right: 0
            bottom: 2

        Button:
            id: pick
            text: "O~K~"
            default: True

        Button:
            id: abandon
            text: "Cancel"

        #: ``cmHelp``: asks as F1 does, for ``help_topic`` above.
        Button:
            id: helper
            text: "Help"
            command: Help
