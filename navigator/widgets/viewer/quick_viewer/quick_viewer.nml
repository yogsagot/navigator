from navigator.widgets.viewer.commands import SwitchRendered
from navigator.widgets.viewer.file_viewer import FileViewer
from navml.widgets.dialog.scroll_bar import ScrollBar

#: Ctrl+Q: the file under the active panel's cursor, shown in the passive
#: panel's place -- DOS Navigator's ``THFileViewer``, which ``SwitchView(dtView)``
#: put where the other panel stood.
#:
#: The viewer is the F3 window's, framed the way a panel is framed because it
#: stands where one stood.  ``ViewInsert`` gave it a ``TViewScroll`` on the
#: frame's right column, shown only while the viewer is selected
#: (``TFileViewer.SetState``); the bar here does the same, and so does the
#: bottom frame's (a departure, as the F3 window's).
QuickViewer:
    #: Columns left clear at each end of the top frame for the window's icons,
    #: as a panel leaves them.
    property title_margin: 0

    #: View > *Markup view*'s key, as in the F3 window, while the keyboard is
    #: in here.  Shift+F4 is the panels' *Edit...* (``cmXEditFile``).
    keys:
        shift+f3: SwitchRendered

    FileViewer:
        id: viewer
        x: 1
        y: 1
        width: max(0, parent.width - 2)
        height: max(0, parent.height - 2)

    ScrollBar:
        id: bar
        x: parent.width - 1
        y: 1
        width: 1
        height: max(0, parent.height - 2)
        value: viewer.top
        maximum: viewer.size
        page: max(1, viewer.width * viewer.height)
        #: And only while there is more than the view holds (a departure, as
        #: the F3 window's).
        visible: viewer.focused and viewer.overflows

    #: A departure, asked for, as the F3 window's: DN's quick view had the
    #: right bar alone.  On the bottom frame, a cell in from each corner, while
    #: a row on screen is wider than the view (``FileViewer.row_span``) -- and,
    #: as the right one, while the keyboard is in here.
    ScrollBar:
        id: hbar
        orientation: "horizontal"
        x: 2
        y: max(0, parent.height - 1)
        width: max(0, parent.width - 4)
        height: 1
        value: viewer.x_delta
        maximum: max(0, viewer.row_span - viewer.width)
        page: max(1, viewer.width)
        visible: viewer.focused and viewer.row_span > viewer.width and self.width >= 4
