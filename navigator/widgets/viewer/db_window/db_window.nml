from navkit.bidi import display_width
from navigator.widgets.viewer.commands import ChangeWidth, ChooseTable, ContinueSearch, EditDbField, RunQuery, SearchAgain, SearchFor
from navigator.widgets.viewer.commands import ShowFields, ShowMemo, SortColumn, TableFormat, ViewSheetAsText
from navigator.widgets.viewer.db_window.db_viewer import DBViewer
from navigator.widgets.manager.commands import EditNamed
from navml.commands import CloseWindow
from navml.widgets.dialog.static_text import StaticText
from navml.widgets.menu.menu_item import MenuItem
from navml.widgets.menu.menu_line import MenuLine
from navml.widgets.menu.sub_menu import SubMenu
from navml.widgets.window import Window

#: File > View > As DataBase, and F3 on a ``.dbf``: DOS Navigator's
#: ``TDBWindow`` (DBVIEW.PAS), titled *dBase View* and the file.
#:
#: The records filling the inside of the frame, ``TDBIndicator``'s
#: ``record/records`` over the bottom frame ten columns in.  It opens
#: zoomed, as the file viewer does; DN filled the desktop with it too.  Its
#: keys are ``StatusDef hcDBView``'s.
#:
#: A SQLite file opens here too, a table at a time and read-only (a
#: departure): F5 *Tables* and F6 *Query* are for it alone, F4 is refused.
#: So does a CSV or TSV file, read-only, where DN's ``.WKZ`` had a
#: spreadsheet window of its own: Shift+F3 its text is for it alone.
#: Shift+F6 is how the table is read: a CSV's *Format*, a dBase table's code
#: page (*Encoding*, the text viewer's box) -- where ``hcDBView`` had
#: *Reanimate*, DOS undelete, dropped.  Refused for SQLite, whose engine
#: decodes its text.  F8 sorts any of them, and *Column width* -- the
#: spreadsheet's ``cmChangeWidth`` -- and Ctrl+Left/Right resize a field.
DBWindow(Window):
    help_topic: "viewer.md#searching-a-table"
    zoomed: True
    #: A dBase table: Shift+F6 chooses its code page.
    property code_page: False

    keys:
        escape: CloseWindow
        f2: ShowFields
        f3: ShowMemo
        f4: EditDbField
        f5: ChooseTable
        f6: RunQuery
        f8: SortColumn
        #: Back to the text: Shift+F3, the F3 window's view key (a departure:
        #: DN's *Phone Book*, dropped).  Shift+F4 is DN's ``cmXEditFile``, on
        #: ``hcDBView``'s status line.
        shift+f3: ViewSheetAsText
        shift+f4: EditNamed
        shift+f6: TableFormat
        f7: SearchFor
        shift+f7: ContinueSearch
        ctrl+l: SearchAgain

    #: The commands this component handles itself.
    commands:
        SortColumn: root.spawn(root.sort())
        TableFormat: root.spawn(root.choose_code_page() if root.csv is None else root.table_format())
        ViewSheetAsText: root.spawn(root.as_text())
        ChooseTable: root.spawn(root.choose_table())
        RunQuery: root.spawn(root.run_query())
        ShowMemo: root.spawn(root.show_memo())
        EditDbField: root.spawn(root.edit_field())
        SearchFor: root.spawn(root.search_for())
        ContinueSearch: root.spawn(root.search_again())
        SearchAgain: root.spawn(root.search_again())

    first_focus: viewer

    DBViewer:
        id: viewer
        anchors:
            left: 1
            right: 1
            top: 1
            bottom: 1

    StaticText:
        id: indicator
        #: Named, so the sheet can give it the frame's colours.
        name: "indicator"
        x: 10
        width: min(display_width(self.text), max(0, parent.width - 12))
        anchors:
            bottom: 0

    #: The window's own menu on the bar after *File* while it is active, as
    #: the file viewer's *View* is -- a departure, asked for: DN's dBase
    #: viewer had its keys on the key bar alone.  *Memo view* is greyed off a
    #: memo field, where F3 does nothing.
    SubMenu: text='~V~iew', after='File'
        id: view_menu
        tooltip: "Fields, memos, editing, tables and search"
        MenuItem: text='~F~ields...', command=ShowFields
            tooltip: "The file's structure: its fields and their types"
        MenuItem: text='~M~emo view', command=ShowMemo
            tooltip: "The memo text of the cell at the cursor"
        MenuItem: text='~E~dit field...', command=EditDbField
        #: SQLite's alone, greyed for a ``.dbf``.
        MenuItem: text='~T~ables...', command=ChooseTable
            tooltip: "Another table or view of the SQLite file"
        MenuItem: text='~Q~uery...', command=RunQuery
            tooltip: "Run a query that reads, and show its rows"
        MenuLine:
        MenuItem: text='S~o~rt by column', command=SortColumn
            tooltip: "Ascending, descending, then as in the file"
        MenuItem: text='Column ~w~idth...', command=ChangeWidth
            tooltip: "Left and Right narrow and widen the column; Enter ends"
        #: A CSV's format, a dBase table's code page; greyed for SQLite.
        MenuItem: text='E~n~coding...' if root.code_page else 'Fo~r~mat...', command=TableFormat
            tooltip: "The code page the table is read in" if root.code_page else "The delimiter, the header and the encoding"
        MenuItem: text='As te~x~t', command=ViewSheetAsText
            tooltip: "The same file in the text viewer"
        MenuLine:
        MenuItem: text='~S~earch...', command=SearchFor
        MenuItem: text='Search a~g~ain', command=ContinueSearch
        MenuLine:
        MenuItem: text='~C~lose', command=CloseWindow
