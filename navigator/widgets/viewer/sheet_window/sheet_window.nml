from navkit.bidi import display_width
from navigator.widgets.viewer.commands import ChangeWidth, CloseViewer, ContinueSearch, FindCell, GotoCell, SearchAgain
from navigator.widgets.viewer.commands import ShowCell, SortColumn, TableFormat, ViewSheetAsText
from navigator.widgets.viewer.sheet_window.sheet_view import SheetView
from navml.commands import CloseWindow
from navml.widgets.dialog.static_text import StaticText
from navml.widgets.menu.menu_item import MenuItem
from navml.widgets.menu.menu_line import MenuLine
from navml.widgets.menu.sub_menu import SubMenu
from navml.widgets.window import Window

#: F3 on a CSV or TSV file, and File > View > As Spreadsheet: DOS Navigator's
#: ``TCalcWindow`` (CALC.PAS), which F3 opened on a ``.WKZ`` -- here view-only,
#: on a delimited text file (``navigator.lib.viewer.table``).
#:
#: DN's window held a cell-name box, ``TCalcInfo``'s line and its own menu
#: bar over ``TCalcView``; ``SheetView`` paints the first two itself, and the
#: menu joins the main bar as *Table* while the window is active, as the
#: viewer's *View* does.  ``record/records`` over the bottom frame, as the
#: dBase viewer's ``TDBIndicator``, says how far the walk of a big file has
#: got.  It opens zoomed, as the viewers do.  Its colours are DN's: the
#: Editor/Spreadsheet group a ``TUniWindow`` takes.
SheetWindow(Window):
    zoomed: True

    #: ``StatusDef hcSpreadSheet``'s keys that a view-only window keeps --
    #: F6 *Goto*, F7 *Search* -- and the viewer's: Esc and F3 close, Shift+F7
    #: and Ctrl+L search again.  F5 (DN's *Recalc*) sorts, Shift+F4 is the
    #: text, Shift+F6 (the viewer's *XLat*) the format: departures.
    keys:
        escape: CloseWindow
        f3: CloseViewer
        enter: ShowCell
        f5: SortColumn
        f6: GotoCell
        f7: FindCell
        shift+f7: ContinueSearch
        ctrl+l: SearchAgain
        shift+f4: ViewSheetAsText
        shift+f6: TableFormat

    SheetView:
        id: sheet
        x: 1
        y: 1
        width: max(0, parent.width - 2)
        height: max(0, parent.height - 2)

    StaticText:
        id: indicator
        #: Named, so the sheet can give it the frame's colours.
        name: "indicator"
        x: 10
        y: max(0, parent.height - 1)
        width: min(display_width(self.text), max(0, parent.width - 12))
        height: 1

    #: DN's ``dlgWkzMenuBar``, what a view-only window keeps of it: *Search*'s
    #: and *Table*'s entries, in one menu.
    SubMenu:
        id: table_menu
        text: '~T~able'
        tooltip: "Cells, columns, sorting and search"
        after: 'File'
        MenuItem:
            text: '~V~iew cell...'
            tooltip: "The whole text of the cell at the cursor"
            command: ShowCell
        MenuItem:
            text: 'C~o~lumn width...'
            tooltip: "Left and Right narrow and widen the column; Enter ends"
            command: ChangeWidth
        MenuItem:
            text: '~S~ort by column'
            tooltip: "Ascending, descending, then as in the file"
            command: SortColumn
        MenuItem:
            text: 'Fo~r~mat...'
            tooltip: "The delimiter, the header and the encoding"
            command: TableFormat
        MenuLine:
        MenuItem:
            text: '~F~ind...'
            command: FindCell
        MenuItem:
            text: 'Search a~g~ain'
            command: ContinueSearch
        MenuItem:
            text: 'Go to cell ~n~umber...'
            command: GotoCell
        MenuLine:
        MenuItem:
            text: 'As ~t~ext'
            tooltip: "The same file in the text viewer"
            command: ViewSheetAsText
        MenuItem:
            text: '~C~lose'
            command: CloseWindow
