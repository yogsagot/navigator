from navml.widgets.dialog.check_boxes import CheckBoxes
from navml.widgets.dialog.dialog import Dialog
from navml.widgets.dialog.field import Field
from navml.widgets.dialog.label import Label
from navml.widgets.dialog.radio_buttons import RadioButtons

#: F7 in the spreadsheet: DOS Navigator's ``dlgFindCell``, *Find* -- the
#: pattern, *Search as* a string or a value, *Case sensitive* (DN's
#: ``sesitive`` mended) and *Whole words only*, in the resource's places.
#: DN's 49 by 13; Help is left out.
SheetFindDialog(Dialog):
    modal_width: 49
    modal_height: 13
    title: "Find"
    buttons: "ok-cancel"

    #: DN's ``hsFindCellPattern``.
    Field:
        id: pattern
        x: 2
        y: 2
        width: max(0, parent.width - 4)
        height: 1
        label_text: "~P~attern"
        label_width: 9
        history_id: "find_cell"

    Label:
        id: search_as_caption
        x: 3
        y: 4
        width: 15
        height: 1
        text: "Search as"
        link: search_as

    RadioButtons:
        id: search_as
        x: 3
        y: 5
        width: 15
        height: 2
        items: ["~S~tring", "~V~alue"]

    CheckBoxes:
        id: options
        x: 20
        y: 5
        width: 26
        height: 2
        items: ["~C~ase sensitive", "~W~hole words only"]
