from navigator.widgets.viewer.commands import AddFilter, ChooseEncoding, CloseViewer, ContinueSearch, GotoAddress, HexMode, SaveViewAs
from navigator.widgets.viewer.commands import ReverseSearch, SearchAgain, SearchFor, SetViewFilter, SetViewMode, Unwrap
from navigator.widgets.viewer.file_viewer import FileViewer
from navml.commands import CloseWindow
from navml.widgets.dialog.scroll_bar import ScrollBar
from navml.widgets.dialog.static_text import StaticText
from navml.widgets.menu.menu_item import MenuItem
from navml.widgets.menu.menu_line import MenuLine
from navml.widgets.menu.sub_menu import SubMenu
from navml.widgets.window import Window

#: F3: DOS Navigator's ``TFileWindow`` (``FVIEWER.PAS``).
#:
#: A standard window titled with the file's path, the viewer filling the
#: inside of its frame, ``TViewScroll`` on the right frame column and
#: ``TViewInfo`` over the bottom one -- the three views ``TFileWindow.Init``
#: inserts, in the places it puts them.
#:
#: **It opens zoomed**, where DN reused the last viewer's rectangle
#: (``LastViewerBounds``) and filled the desktop only the first time.  Taken
#: to match the file manager, which opens zoomed too; the zoom icon gives the
#: window its own rectangle back.
FileWindow(Window):
    zoomed: True

    #: ``StatusDef hcView``, in its order: the plain row, then Ctrl's and
    #: Shift's.  Shift+F2's *Store* is left out, there being no hex editing
    #: to store, so the bar closes up round it; Shift+F6's *XLat* chooses an
    #: encoding.  Ctrl+L continues a search with no caption, as it did.
    #: F3 closes the viewer, as Midnight Commander's does -- not DN's, which
    #: bound nothing there -- and has no caption either, so the line is DN's.
    keys:
        escape: CloseWindow
        f3: CloseViewer
        f2: Unwrap
        f4: HexMode
        f5: GotoAddress
        f6: AddFilter
        f7: SearchFor
        ctrl+f7: ReverseSearch
        shift+f5: SaveViewAs
        shift+f6: ChooseEncoding
        shift+f7: ContinueSearch
        ctrl+l: SearchAgain

    FileViewer:
        id: viewer
        x: 1
        y: 1
        width: max(0, parent.width - 2)
        height: max(0, parent.height - 2)

    #: On the frame's right column, a row in from each corner.  Its value is
    #: the byte offset on top -- ``TViewScroll`` counted bytes, not lines, which
    #: is what lets a gigabyte have a thumb without being counted first.
    ScrollBar:
        id: bar
        x: parent.width - 1
        y: 1
        width: 1
        height: max(0, parent.height - 2)
        value: viewer.top
        maximum: viewer.size
        page: max(1, viewer.width * viewer.height)

    #: ``TViewInfo``: over the bottom frame, a column in, as wide as it says.
    StaticText:
        id: info
        x: 1
        y: max(0, parent.height - 1)
        width: min(len(viewer.info_text), max(0, parent.width - 3))
        height: 1
        text: viewer.info_text

    #: The viewer's own menu, on the main menu bar after *File* while this
    #: window is the active one: a ``SubMenu`` among a window's children is
    #: one the shell's ``MenuBar.context`` binding puts there.  DOS Navigator's
    #: viewer had none -- everything here is on the viewer's keys, gathered in
    #: one place.  The three ``StatusDef hcView`` keys Navigator cannot do yet
    #: are shown greyed, as the main menu shows every feature still to come.
    #: Two captions depart from DN's: *32-255 filter* is *Printable filter*,
    #: since a UTF-8 text has no one-byte code page to count to 255 in, and
    #: *XLat*'s code-page tables are *Encoding...*, a choice of encoding.
    SubMenu:
        id: view_menu
        text: '~V~iew'
        after: 'File'
        MenuItem:
            text: '~T~ext'
            command: SetViewMode('text')
        MenuItem:
            text: '~H~ex'
            command: SetViewMode('hex')
        MenuItem:
            text: '~D~ump'
            command: SetViewMode('dump')
        MenuLine:
        MenuItem:
            text: '~W~rap lines'
            command: Unwrap
        MenuItem:
            text: '~N~o filter'
            command: SetViewFilter(0)
        MenuItem:
            text: '~A~SCII filter'
            command: SetViewFilter(1)
        MenuItem:
            text: '~P~rintable filter'
            command: SetViewFilter(2)
        MenuLine:
        MenuItem:
            text: '~S~earch...'
            command: SearchFor
        MenuItem:
            text: 'Search a~g~ain'
            command: ContinueSearch
        MenuItem:
            text: 'Re~v~erse search'
            command: ReverseSearch
        MenuItem:
            text: 'Go to add~r~ess...'
            command: GotoAddress
        MenuLine:
        MenuItem:
            text: 'St~o~re'
            key: 'Shift-F2'
        MenuItem:
            text: 'Sav~e~ as...'
            command: SaveViewAs
            key: 'Shift-F5'
        MenuItem:
            text: 'Encod~i~ng...'
            command: ChooseEncoding
            key: 'Shift-F6'
        MenuLine:
        MenuItem:
            text: '~C~lose'
            command: CloseWindow
