/* -- File Manager -------------------------------------------------------- */
$frame-fg: light_gray;                /*  [ 80] Frame passive -- CDoubleWindow[1] -> CFrame[1,2] */
$frame-bg: dark_gray;
$active-frame-fg: white;              /*  [ 81] Frame active -- CDoubleWindow[2] -> CFrame[3,4] */
$active-frame-bg: dark_gray;
$frame-icon-fg: light_cyan;           /*  [ 82] Frame icons -- CDoubleWindow[3] -> CFrame[5] */
$frame-icon-bg: dark_gray;
$scrollbar-page-fg: white;            /*  [ 83] Scroll bar page -- CDoubleWindow[4] -> CScrollBar[1] */
$scrollbar-page-bg: dark_gray;
$scrollbar-arrow-fg: black;           /*  [ 84] Scroll bar icons -- CDoubleWindow[5] -> CScrollBar[2,3] */
$scrollbar-arrow-bg: white;

/* -- File Panel ---------------------------------------------------------- */
