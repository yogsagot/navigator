/*
 * Default Color palette -- DOS Navigator's DEFAULT.PAL.
 *
 * Generated by tools/palconv.py; edit that, or the .PAL, not this.
 * Load it after navigator.nss, whose rules read the names below:
 *
 *     python -m navigator --theme default
 *
 * The palette leaves the sixteen VGA colour registers alone, so the
 * colours below are named rather than pinned and the terminal's own
 * theme still decides what, say, `cyan' looks like.
 */

/* All 144 entries DOS Navigator's Colors dialog exposes, in its groups and
   its order. `>' marks the eight navigator.nss reads today; the rest are one
   rule away from being live, and are carried rather than dropped. */

/* -- Timer --------------------------------------------------------------- */
$desktop-fg: blue;                    /*> [  1] Color -- CBackground[1] */
$desktop-bg: light_gray;

/* -- Menus --------------------------------------------------------------- */
$bar-fg: black;                       /*> [  2] Normal -- CMenuView, CStatusLine[1] */
$bar-bg: light_gray;
$bar-disabled-fg: dark_gray;          /*  [  3] Disabled -- CMenuView, CStatusLine[2] */
$bar-disabled-bg: light_gray;
$bar-key-fg: red;                     /*> [  4] Shortcut -- CMenuView, CStatusLine[3] */
$bar-key-bg: light_gray;
$bar-selected-fg: black;              /*  [  5] Selected -- CMenuView, CStatusLine[4] */
$bar-selected-bg: green;
$bar-selected-disabled-fg: dark_gray; /*  [  6] Selected disabled -- CMenuView, CStatusLine[5] */
$bar-selected-disabled-bg: green;
$bar-selected-key-fg: red;            /*  [  7] Shortcut selected -- CMenuView, CStatusLine[6] */
$bar-selected-key-bg: green;

/* -- Dialogs ------------------------------------------------------------- */
$dialog-frame-background-fg: white;   /*  [ 33] Frame/background */
$dialog-frame-background-bg: light_gray;
$dialog-frame-icons-fg: light_green;  /*  [ 34] Frame icons */
$dialog-frame-icons-bg: light_gray;
$dialog-scroll-bar-page-fg: cyan;     /*  [ 35] Scroll bar page */
$dialog-scroll-bar-page-bg: blue;
$dialog-scroll-bar-icons-fg: cyan;    /*  [ 36] Scroll bar icons */
$dialog-scroll-bar-icons-bg: blue;
$dialog-static-text-fg: black;        /*  [ 37] Static text */
$dialog-static-text-bg: light_gray;
$dialog-label-normal-fg: black;       /*  [ 38] Label normal */
$dialog-label-normal-bg: light_gray;
$dialog-label-selected-fg: white;     /*  [ 39] Label selected */
$dialog-label-selected-bg: light_gray;
$dialog-label-shortcut-fg: yellow;    /*  [ 40] Label shortcut */
$dialog-label-shortcut-bg: light_gray;
$dialog-button-normal-fg: white;      /*  [ 41] Button normal */
$dialog-button-normal-bg: dark_gray;
$dialog-button-default-fg: light_cyan;/*  [ 42] Button default */
$dialog-button-default-bg: dark_gray;
$dialog-button-selected-fg: white;    /*  [ 43] Button selected */
$dialog-button-selected-bg: light_blue;
$dialog-button-disabled-fg: dark_gray;/*  [ 44] Button disabled */
$dialog-button-disabled-bg: light_gray;
$dialog-button-shortcut-fg: yellow;   /*  [ 45] Button shortcut */
$dialog-button-shortcut-bg: dark_gray;
$dialog-shortcut-selected-fg: yellow; /*  [178] Shortcut selected */
$dialog-shortcut-selected-bg: light_blue;
$dialog-shortcut-default-fg: yellow;  /*  [179] Shortcut default */
$dialog-shortcut-default-bg: dark_gray;
$dialog-button-shadow-fg: black;      /*  [ 46] Button shadow */
$dialog-button-shadow-bg: light_gray;
$dialog-cluster-normal-fg: dark_gray; /*  [ 47] Cluster normal */
$dialog-cluster-normal-bg: light_gray;
