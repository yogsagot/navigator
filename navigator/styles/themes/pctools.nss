/* -- Tree ---------------------------------------------------------------- */
$tree-normal-tree-fg: $dn-white;      /*  [ 94] Normal tree */
$tree-normal-tree-bg: $dn-light_blue;
$tree-normal-nodes-fg: $dn-white;     /*  [ 95] Normal nodes */
$tree-normal-nodes-bg: $dn-light_blue;
$tree-selected-node-fg: $dn-white;    /*  [ 96] Selected node */
$tree-selected-node-bg: $dn-black;
$tree-default-node-fg: $dn-light_cyan;/*  [ 97] Default node */
$tree-default-node-bg: $dn-light_blue;
$tree-selected-default-fg: $dn-white; /*  [ 98] Selected default */
$tree-selected-default-bg: $dn-blue;
$tree-selected-passive-fg: $dn-white; /*  [ 99] Selected passive */
$tree-selected-passive-bg: $dn-black;
$tree-selected-def-passive-fg: $dn-yellow;/*  [100] Selected def. passive */
$tree-selected-def-passive-bg: $dn-black;
$tree-info-box-fg: $dn-yellow;        /*  [101] Info box */
$tree-info-box-bg: $dn-light_blue;

/* -- Quick View ---------------------------------------------------------- */
$quick-view-normal-text-fg: $dn-white;/*  [ 92] Normal text */
$quick-view-normal-text-bg: $dn-light_blue;
$quick-view-selected-text-fg: $dn-black;/*  [ 93] Selected text */
$quick-view-selected-text-bg: $dn-white;

/* -- Disk Info ----------------------------------------------------------- */
$disk-info-normal-text-fg: $dn-white; /*  [103] Normal text */
$disk-info-normal-text-bg: $dn-light_blue;
$disk-info-highlighted-text-fg: $dn-yellow;/*  [102] Highlighted text */
$disk-info-highlighted-text-bg: $dn-light_blue;

/* -- File Viewer --------------------------------------------------------- */
$viewer-frame-passive-fg: $dn-light_gray;/*  [112] Frame passive */
$viewer-frame-passive-bg: $dn-light_blue;
$viewer-frame-active-fg: $dn-white;   /*  [113] Frame active */
$viewer-frame-active-bg: $dn-light_blue;
$viewer-frame-icons-fg: $dn-yellow;   /*  [114] Frame icons */
$viewer-frame-icons-bg: $dn-light_blue;
$viewer-scroll-bar-page-fg: $dn-white;/*  [115] Scroll bar page */
$viewer-scroll-bar-page-bg: $dn-light_blue;
$viewer-scroll-bar-icons-fg: $dn-white;/*  [116] Scroll bar icons */
$viewer-scroll-bar-icons-bg: $dn-light_blue;
$viewer-normal-text-fg: $dn-white;    /*  [117] Normal text */
$viewer-normal-text-bg: $dn-light_blue;
$viewer-selected-text-fg: $dn-light_blue;/*  [118] Selected text */
$viewer-selected-text-bg: $dn-yellow;

/* -- Editor/Spreadsheet -------------------------------------------------- */
$editor-frame-passive-fg: $dn-light_gray;/*  [ 70] Frame passive */
$editor-frame-passive-bg: $dn-light_blue;
$editor-frame-active-fg: $dn-white;   /*  [ 71] Frame active */
$editor-frame-active-bg: $dn-light_blue;
$editor-frame-icons-fg: $dn-yellow;   /*  [ 73] Frame icons */
$editor-frame-icons-bg: $dn-light_blue;
$editor-frame-title-fg: $dn-black;    /*  [ 72] Frame title */
$editor-frame-title-bg: $dn-white;
$editor-scroll-bar-page-fg: $dn-white;/*  [ 74] Scroll bar page */
$editor-scroll-bar-page-bg: $dn-light_blue;
$editor-scroll-bar-icons-fg: $dn-white;/*  [ 75] Scroll bar icons */
$editor-scroll-bar-icons-bg: $dn-light_blue;
$editor-normal-text-fg: $dn-white;    /*  [ 76] Normal text */
$editor-normal-text-bg: $dn-light_blue;
$editor-selected-text-fg: $dn-white;  /*  [ 77] Selected text */
$editor-selected-text-bg: $dn-black;

/* -- Highlight ----------------------------------------------------------- */
$editor-highlight-comments-fg: $dn-light_gray;/*  [164] Comments */
$editor-highlight-comments-bg: $dn-light_blue;
$editor-highlight-symbols-fg: $dn-yellow;/*  [189] Symbols */
$editor-highlight-symbols-bg: $dn-light_blue;
$editor-highlight-strings-fg: $dn-light_red;/*  [190] Strings */
$editor-highlight-strings-bg: $dn-light_blue;
