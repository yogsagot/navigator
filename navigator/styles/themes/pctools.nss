/*
 * PCTools/Norton Utilities -- DOS Navigator's PCTOOLS.PAL.
 *
 * Generated by tools/palconv.py; edit that, or the .PAL, not this.
 * Load it after navigator.nss, whose rules read the names below:
 *
 *     python -m navigator --theme pctools
 *
 * This palette reprograms the sixteen VGA colour registers, so the
 * sixteen names are pinned to the values it asks for rather than
 * left to the terminal's own theme.  That is the whole difference
 * between it and a palette that only rearranges attributes.
 */

/* The adapter's colour registers, six bits per channel widened to eight. */
$dn-black: #000000;
$dn-blue: #0000aa;
$dn-green: #00aa00;
$dn-cyan: #00aaaa;
$dn-red: #fb0000;
$dn-magenta: #aa00aa;
$dn-brown: #aa5500;
$dn-light_gray: #aaaaaa;
$dn-dark_gray: #555555;
$dn-light_blue: #5555ca;
$dn-light_green: #55ff55;
$dn-light_cyan: #55ffff;
$dn-light_red: #ff5555;
$dn-light_magenta: #ff55ff;
$dn-yellow: #ffff00;
$dn-white: #ffffff;

/* All 144 entries DOS Navigator's Colors dialog exposes, in its groups and
   its order. `>' marks the eight navigator.nss reads today; the rest are one
   rule away from being live, and are carried rather than dropped. */

/* -- Timer --------------------------------------------------------------- */
$desktop-fg: $dn-black;               /*> [  1] Color -- CBackground[1] */
$desktop-bg: $dn-light_gray;

/* -- Menus --------------------------------------------------------------- */
$bar-fg: $dn-black;                   /*> [  2] Normal -- CMenuView, CStatusLine[1] */
$bar-bg: $dn-white;
$bar-disabled-fg: $dn-light_gray;     /*  [  3] Disabled -- CMenuView, CStatusLine[2] */
$bar-disabled-bg: $dn-white;
$bar-key-fg: $dn-red;                 /*> [  4] Shortcut -- CMenuView, CStatusLine[3] */
$bar-key-bg: $dn-white;
$bar-selected-fg: $dn-white;          /*  [  5] Selected -- CMenuView, CStatusLine[4] */
$bar-selected-bg: $dn-black;
$bar-selected-disabled-fg: $dn-light_gray;/*  [  6] Selected disabled -- CMenuView, CStatusLine[5] */
$bar-selected-disabled-bg: $dn-black;
$bar-selected-key-fg: $dn-red;        /*  [  7] Shortcut selected -- CMenuView, CStatusLine[6] */
$bar-selected-key-bg: $dn-black;

/* -- Dialogs ------------------------------------------------------------- */
$dialog-frame-background-fg: $dn-black;/*  [ 33] Frame/background */
$dialog-frame-background-bg: $dn-light_cyan;
$dialog-frame-icons-fg: $dn-black;    /*  [ 34] Frame icons */
$dialog-frame-icons-bg: $dn-light_cyan;
$dialog-scroll-bar-page-fg: $dn-light_blue;/*  [ 35] Scroll bar page */
$dialog-scroll-bar-page-bg: $dn-light_cyan;
$dialog-scroll-bar-icons-fg: $dn-cyan;/*  [ 36] Scroll bar icons */
$dialog-scroll-bar-icons-bg: $dn-blue;
$dialog-static-text-fg: $dn-black;    /*  [ 37] Static text */
$dialog-static-text-bg: $dn-light_cyan;
$dialog-label-normal-fg: $dn-black;   /*  [ 38] Label normal */
$dialog-label-normal-bg: $dn-light_cyan;
$dialog-label-selected-fg: $dn-light_red;/*  [ 39] Label selected */
$dialog-label-selected-bg: $dn-light_cyan;
$dialog-label-shortcut-fg: $dn-light_red;/*  [ 40] Label shortcut */
$dialog-label-shortcut-bg: $dn-light_cyan;
$dialog-button-normal-fg: $dn-black;  /*  [ 41] Button normal */
$dialog-button-normal-bg: $dn-light_gray;
$dialog-button-default-fg: $dn-white; /*  [ 42] Button default */
$dialog-button-default-bg: $dn-light_gray;
$dialog-button-selected-fg: $dn-blue; /*  [ 43] Button selected */
$dialog-button-selected-bg: $dn-white;
$dialog-button-disabled-fg: $dn-dark_gray;/*  [ 44] Button disabled */
$dialog-button-disabled-bg: $dn-light_gray;
$dialog-button-shortcut-fg: $dn-red;  /*  [ 45] Button shortcut */
$dialog-button-shortcut-bg: $dn-light_gray;
$dialog-shortcut-selected-fg: $dn-red;/*  [178] Shortcut selected */
$dialog-shortcut-selected-bg: $dn-white;
$dialog-shortcut-default-fg: $dn-yellow;/*  [179] Shortcut default */
$dialog-shortcut-default-bg: $dn-light_gray;
$dialog-button-shadow-fg: $dn-black;  /*  [ 46] Button shadow */
$dialog-button-shadow-bg: $dn-light_cyan;
$dialog-cluster-normal-fg: $dn-black; /*  [ 47] Cluster normal */
$dialog-cluster-normal-bg: $dn-light_cyan;
$dialog-cluster-selected-fg: $dn-light_blue;/*  [ 48] Cluster selected */
$dialog-cluster-selected-bg: $dn-light_cyan;
$dialog-cluster-shortcut-fg: $dn-light_red;/*  [ 49] Cluster shortcut */
$dialog-cluster-shortcut-bg: $dn-light_cyan;
$dialog-input-normal-fg: $dn-white;   /*  [ 50] Input normal */
$dialog-input-normal-bg: $dn-light_blue;
$dialog-input-selected-fg: $dn-black; /*  [ 51] Input selected */
$dialog-input-selected-bg: $dn-white;
$dialog-input-arrow-fg: $dn-yellow;   /*  [ 52] Input arrow */
$dialog-input-arrow-bg: $dn-light_blue;
$dialog-history-button-fg: $dn-black; /*  [ 53] History button */
$dialog-history-button-bg: $dn-light_gray;
$dialog-history-sides-fg: $dn-light_gray;/*  [ 54] History sides */
$dialog-history-sides-bg: $dn-light_cyan;
$dialog-history-bar-page-fg: $dn-blue;/*  [ 55] History bar page */
$dialog-history-bar-page-bg: $dn-cyan;
$dialog-history-bar-icons-fg: $dn-blue;/*  [ 56] History bar icons */
$dialog-history-bar-icons-bg: $dn-cyan;
$dialog-list-normal-fg: $dn-black;    /*  [ 57] List normal */
$dialog-list-normal-bg: $dn-cyan;
$dialog-list-focused-fg: $dn-black;   /*  [ 58] List focused */
$dialog-list-focused-bg: $dn-white;
$dialog-list-selected-fg: $dn-white;  /*  [ 59] List selected */
$dialog-list-selected-bg: $dn-cyan;
$dialog-list-divider-fg: $dn-blue;    /*  [ 60] List divider */
$dialog-list-divider-bg: $dn-cyan;
$dialog-information-pane-fg: $dn-black;/*  [ 61] Information pane */
$dialog-information-pane-bg: $dn-light_cyan;

/* -- Tree ---------------------------------------------------------------- */
$dialog-tree-normal-tree-fg: $dn-blue;/*  [104] Normal tree */
$dialog-tree-normal-tree-bg: $dn-light_cyan;
$dialog-tree-normal-nodes-fg: $dn-black;/*  [105] Normal nodes */
$dialog-tree-normal-nodes-bg: $dn-light_cyan;
$dialog-tree-selected-node-fg: $dn-white;/*  [106] Selected node */
$dialog-tree-selected-node-bg: $dn-black;
$dialog-tree-default-node-fg: $dn-light_red;/*  [107] Default node */
$dialog-tree-default-node-bg: $dn-light_cyan;
$dialog-tree-selected-default-fg: $dn-light_red;/*  [108] Selected default */
$dialog-tree-selected-default-bg: $dn-black;
$dialog-tree-selected-passive-fg: $dn-blue;/*  [109] Selected passive */
$dialog-tree-selected-passive-bg: $dn-light_cyan;
$dialog-tree-selected-def-passive-fg: $dn-red;/*  [110] Selected def. passive */
$dialog-tree-selected-def-passive-bg: $dn-light_cyan;

/* -- File Manager -------------------------------------------------------- */
$frame-fg: $dn-light_gray;            /*  [ 80] Frame passive -- CDoubleWindow[1] -> CFrame[1,2] */
$frame-bg: $dn-light_blue;
$active-frame-fg: $dn-white;          /*  [ 81] Frame active -- CDoubleWindow[2] -> CFrame[3,4] */
$active-frame-bg: $dn-light_blue;
$frame-icon-fg: $dn-yellow;           /*  [ 82] Frame icons -- CDoubleWindow[3] -> CFrame[5] */
$frame-icon-bg: $dn-light_blue;
$scrollbar-page-fg: $dn-white;        /*  [ 83] Scroll bar page -- CDoubleWindow[4] -> CScrollBar[1] */
$scrollbar-page-bg: $dn-light_blue;
$scrollbar-arrow-fg: $dn-white;       /*  [ 84] Scroll bar icons -- CDoubleWindow[5] -> CScrollBar[2,3] */
$scrollbar-arrow-bg: $dn-light_blue;

/* -- File Panel ---------------------------------------------------------- */
$panel-fg: $dn-light_cyan;            /*> [ 85] Normal text -- CDoubleWindow[6] -> CPanel[1] */
$panel-bg: $dn-light_blue;
$marked-fg: $dn-yellow;               /*  [ 87] Selected text -- CDoubleWindow[8] -> CPanel[3] */
$marked-bg: $dn-light_blue;
$cursor-fg: $dn-white;                /*> [ 88] Normal cursor -- CDoubleWindow[9] -> CPanel[4] */
$cursor-bg: $dn-black;
$marked-cursor-fg: $dn-yellow;        /*  [ 89] Selected cursor -- CDoubleWindow[10] -> CPanel[5] */
$marked-cursor-bg: $dn-black;
$divider-fg: $dn-white;               /*  [ 86] List divider -- CDoubleWindow[7] -> CPanel[2] */
$divider-bg: $dn-light_blue;
$active-title-fg: $dn-black;          /*> [ 90] Directory active -- CDoubleWindow[11] -> CTopView[1] */
$active-title-bg: $dn-white;
$title-fg: $dn-white;                 /*> [ 91] Directory passive -- CDoubleWindow[12] -> CTopView[2] */
$title-bg: $dn-light_blue;
$column-title-fg: $dn-yellow;         /*  [165] Column title -- CDoubleWindow[32] -> CPanel[6] */
$column-title-bg: $dn-light_blue;

/* -- Highlight ----------------------------------------------------------- */
$directory-fg: $dn-white;             /*> [172] Directories -- CDoubleWindow[33] -> CPanel[7], ttDirectory */
$directory-bg: $dn-light_blue;
$executable-fg: $dn-white;            /*  [173] Executables -- CDoubleWindow[34] -> CPanel[8], ttExec */
$executable-bg: $dn-light_blue;
$archive-fg: $dn-light_green;         /*  [174] Archives -- CDoubleWindow[35] -> CPanel[9], ttArc */
$archive-bg: $dn-light_blue;
$highlight-custom-1-fg: $dn-light_cyan;/*  [175] Custom 1 */
$highlight-custom-1-bg: $dn-light_blue;
$highlight-custom-2-fg: $dn-light_gray;/*  [176] Custom 2 */
$highlight-custom-2-bg: $dn-light_blue;
$highlight-custom-3-fg: $dn-light_magenta;/*  [177] Custom 3 */
$highlight-custom-3-bg: $dn-light_blue;
$highlight-custom-4-fg: $dn-black;    /*  [180] Custom 4 */
$highlight-custom-4-bg: $dn-light_blue;
$highlight-custom-5-fg: $dn-light_cyan;/*  [181] Custom 5 */
$highlight-custom-5-bg: $dn-light_blue;

/* -- Drive Line ---------------------------------------------------------- */
$drive-line-drive-letters-fg: $dn-white;/*  [186] Drive letters */
$drive-line-drive-letters-bg: $dn-light_blue;
$drive-line-drive-selected-fg: $dn-light_cyan;/*  [188] Drive selected */
$drive-line-drive-selected-bg: $dn-light_blue;
$drive-line-frame-fg: $dn-white;      /*  [187] Frame */
$drive-line-frame-bg: $dn-light_blue;

/* -- Info ---------------------------------------------------------------- */
$info-current-file-fg: $dn-white;     /*  [119] Current file */
$info-current-file-bg: $dn-light_blue;
$info-selected-text-fg: $dn-light_cyan;/*  [120] Selected text */
$info-selected-text-bg: $dn-light_blue;
