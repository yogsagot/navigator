$editor-highlight-current-column-bg: $dn-dark_gray;

/* -- Menu ---------------------------------------------------------------- */
$editor-menu-normal-fg: $dn-black;    /*  [ 64] Normal */
$editor-menu-normal-bg: $dn-white;
$editor-menu-disabled-fg: $dn-light_gray;/*  [ 65] Disabled */
$editor-menu-disabled-bg: $dn-white;
