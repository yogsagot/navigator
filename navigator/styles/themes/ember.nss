/*
 * Ember -- warm charcoal, parchment text, one amber accent.
 *
 * An original Navigator palette.
 *
 * Generated by tools/themegen.py; edit that, not this.
 * Load it after navigator.nss, whose rules read the names below:
 *
 *     python -m navigator --theme ember
 *
 * Exact RGB throughout, so a 256-colour or truecolor terminal shows it
 * as designed; with --colors 16 the renderer picks the nearest of the
 * sixteen.
 */

/* The theme's roles: every slot below takes one of them. */
$color-desktop: #141312;              /* behind the windows */
$color-ground: #1c1a19;               /* panels, the viewer and the editor */
$color-ground_alt: #2a2624;           /* the editor's current line */
$color-surface: #57504a;              /* dialogs */
$color-raised: #6c635b;               /* buttons and scroll bars */
$color-field: #3e3833;                /* input lines, lists and trees in a dialog */
$color-field_focus: #161413;          /* the input line being typed in */
$color-overlay: #2c2826;              /* menus, the menu bar and the key bar */
$color-border: #a89c8e;               /* frames */
$color-border_dim: #655d55;           /* the frame of a window without focus */
$color-shadow: #0c0b0a;               /* a button's shadow */
$color-text: #e8e2d9;                 /* ordinary text */
$color-text_dim: #b3aa9f;             /* secondary text: titles, totals */
$color-text_faint: #958b80;           /* disabled items */
$color-text_strong: #fff7ea;          /* emphasis */
$color-accent: #f59e42;               /* the cursor and the focused control */
$color-on_accent: #1c1a19;            /* text on the accent */
$color-on_accent_alt: #6b3300;        /* a hotkey or a marked file under the cursor */
$color-on_accent_faint: #8a4f14;      /* a disabled item under the cursor */
$color-selection: #5a4630;            /* selected text, and the cursor where the focus is not */
$color-on_selection: #fff3e0;         /* text on the selection */
$color-hotkey: #7fd1d8;               /* a hotkey letter */
$color-marked: #f2c46d;               /* a marked file */
$color-dir: #fff7ea;                  /* directories */
$color-exec: #9ccf8a;                 /* executables */
$color-archive: #e8846a;              /* archives */
$color-image: #6fc2c9;                /* images */
$color-media: #d9a05b;                /* audio and video */
$color-document: #c9b99a;             /* documents, devices and sockets */
$color-source: #9cc6e8;               /* source code */
$color-link: #86bdb1;                 /* symbolic links */
$color-broken: #ef6461;               /* a link that points nowhere */
$color-temp: #7a7168;                 /* backups and temporaries */
$color-comment: #8f8579;              /* comments */
$color-string: #b5cc7a;               /* strings */
$color-number: #f2a65a;               /* numbers */
$color-keyword: #f59e42;              /* keywords */
$color-symbol: #d4c6b0;               /* operators and punctuation */
$color-warn: #f2c46d;                 /* warnings: the error box's icons */
$color-error: #9e3a32;                /* the error box */
$color-error_shadow: #0c0b0a;         /* a button's shadow on the error box */
$color-modified: #f2c46d;             /* a changed file's title in the editor */
$color-drop_shadow: #0b0a09;          /* the shadow a window, a dialog or a menu casts */
$color-drop_shadow_text: #5a534c;     /* what shows through a drop shadow */
$color-on_error: #fff3e0;             /* text on the error box */

/* All 144 entries DOS Navigator's Colors dialog exposes, in its groups and
   its order, each drawn in two of the roles above. */

/* -- Timer --------------------------------------------------------------- */
$desktop-fg: $color-text_dim;         /*> [  1] Color -- CBackground[1] */
$desktop-bg: $color-desktop;

/* -- Menus --------------------------------------------------------------- */
$bar-fg: $color-text;                 /*> [  2] Normal -- CMenuView, CStatusLine[1] */
$bar-bg: $color-overlay;
$bar-disabled-fg: $color-text_faint;  /*  [  3] Disabled -- CMenuView, CStatusLine[2] */
$bar-disabled-bg: $color-overlay;
$bar-key-fg: $color-hotkey;           /*> [  4] Shortcut -- CMenuView, CStatusLine[3] */
$bar-key-bg: $color-overlay;
$bar-selected-fg: $color-on_accent;   /*  [  5] Selected -- CMenuView, CStatusLine[4] */
$bar-selected-bg: $color-accent;
$bar-selected-disabled-fg: $color-on_accent_faint;/*  [  6] Selected disabled -- CMenuView, CStatusLine[5] */
$bar-selected-disabled-bg: $color-accent;
$bar-selected-key-fg: $color-on_accent_alt;/*  [  7] Shortcut selected -- CMenuView, CStatusLine[6] */
$bar-selected-key-bg: $color-accent;

/* -- Dialogs ------------------------------------------------------------- */
$dialog-frame-background-fg: $color-border;/*  [ 33] Frame/background */
$dialog-frame-background-bg: $color-surface;
$dialog-frame-icons-fg: $color-accent;/*  [ 34] Frame icons */
$dialog-frame-icons-bg: $color-surface;
$dialog-scroll-bar-page-fg: $color-text_dim;/*  [ 35] Scroll bar page */
$dialog-scroll-bar-page-bg: $color-raised;
$dialog-scroll-bar-icons-fg: $color-text;/*  [ 36] Scroll bar icons */
$dialog-scroll-bar-icons-bg: $color-raised;
$dialog-static-text-fg: $color-text;  /*  [ 37] Static text */
$dialog-static-text-bg: $color-surface;
$dialog-label-normal-fg: $color-text; /*  [ 38] Label normal */
$dialog-label-normal-bg: $color-surface;
$dialog-label-selected-fg: $color-text_strong;/*  [ 39] Label selected */
$dialog-label-selected-bg: $color-surface;
$dialog-label-shortcut-fg: $color-hotkey;/*  [ 40] Label shortcut */
$dialog-label-shortcut-bg: $color-surface;
$dialog-button-normal-fg: $color-text;/*  [ 41] Button normal */
$dialog-button-normal-bg: $color-raised;
$dialog-button-default-fg: $color-text_strong;/*  [ 42] Button default */
$dialog-button-default-bg: $color-raised;
$dialog-button-selected-fg: $color-on_accent;/*  [ 43] Button selected */
$dialog-button-selected-bg: $color-accent;
$dialog-button-disabled-fg: $color-text_faint;/*  [ 44] Button disabled */
$dialog-button-disabled-bg: $color-surface;
$dialog-button-shortcut-fg: $color-hotkey;/*  [ 45] Button shortcut */
$dialog-button-shortcut-bg: $color-raised;
$dialog-shortcut-selected-fg: $color-on_accent_alt;/*  [178] Shortcut selected */
$dialog-shortcut-selected-bg: $color-accent;
$dialog-shortcut-default-fg: $color-hotkey;/*  [179] Shortcut default */
$dialog-shortcut-default-bg: $color-raised;
$dialog-button-shadow-fg: $color-shadow;/*  [ 46] Button shadow */
$dialog-button-shadow-bg: $color-surface;
$dialog-cluster-normal-fg: $color-text;/*  [ 47] Cluster normal */
$dialog-cluster-normal-bg: $color-surface;
$dialog-cluster-selected-fg: $color-text_strong;/*  [ 48] Cluster selected */
$dialog-cluster-selected-bg: $color-surface;
$dialog-cluster-shortcut-fg: $color-hotkey;/*  [ 49] Cluster shortcut */
$dialog-cluster-shortcut-bg: $color-surface;
$dialog-input-normal-fg: $color-text; /*  [ 50] Input normal */
$dialog-input-normal-bg: $color-field;
$dialog-input-selected-fg: $color-text_strong;/*  [ 51] Input selected */
$dialog-input-selected-bg: $color-field_focus;
$dialog-input-arrow-fg: $color-accent;/*  [ 52] Input arrow */
$dialog-input-arrow-bg: $color-field;
$dialog-history-button-fg: $color-text;/*  [ 53] History button */
$dialog-history-button-bg: $color-raised;
$dialog-history-sides-fg: $color-raised;/*  [ 54] History sides */
$dialog-history-sides-bg: $color-surface;
$dialog-history-bar-page-fg: $color-text_dim;/*  [ 55] History bar page */
$dialog-history-bar-page-bg: $color-raised;
$dialog-history-bar-icons-fg: $color-text;/*  [ 56] History bar icons */
$dialog-history-bar-icons-bg: $color-raised;
$dialog-list-normal-fg: $color-text;  /*  [ 57] List normal */
$dialog-list-normal-bg: $color-field;
$dialog-list-focused-fg: $color-on_accent;/*  [ 58] List focused */
$dialog-list-focused-bg: $color-accent;
$dialog-list-selected-fg: $color-on_selection;/*  [ 59] List selected */
$dialog-list-selected-bg: $color-selection;
$dialog-list-divider-fg: $color-border;/*  [ 60] List divider */
$dialog-list-divider-bg: $color-field;
$dialog-information-pane-fg: $color-text_dim;/*  [ 61] Information pane */
$dialog-information-pane-bg: $color-raised;

/* -- Tree ---------------------------------------------------------------- */
$dialog-tree-normal-tree-fg: $color-text_dim;/*  [104] Normal tree */
$dialog-tree-normal-tree-bg: $color-field;
$dialog-tree-normal-nodes-fg: $color-text;/*  [105] Normal nodes */
$dialog-tree-normal-nodes-bg: $color-field;
$dialog-tree-selected-node-fg: $color-on_accent;/*  [106] Selected node */
$dialog-tree-selected-node-bg: $color-accent;
$dialog-tree-default-node-fg: $color-dir;/*  [107] Default node */
$dialog-tree-default-node-bg: $color-field;
$dialog-tree-selected-default-fg: $color-on_accent_alt;/*  [108] Selected default */
$dialog-tree-selected-default-bg: $color-accent;
$dialog-tree-selected-passive-fg: $color-on_selection;/*  [109] Selected passive */
$dialog-tree-selected-passive-bg: $color-selection;
$dialog-tree-selected-def-passive-fg: $color-dir;/*  [110] Selected def. passive */
$dialog-tree-selected-def-passive-bg: $color-selection;

/* -- File Manager -------------------------------------------------------- */
$frame-fg: $color-border_dim;         /*  [ 80] Frame passive -- CDoubleWindow[1] -> CFrame[1,2] */
$frame-bg: $color-ground;
$active-frame-fg: $color-border;      /*  [ 81] Frame active -- CDoubleWindow[2] -> CFrame[3,4] */
$active-frame-bg: $color-ground;
$frame-icon-fg: $color-accent;        /*  [ 82] Frame icons -- CDoubleWindow[3] -> CFrame[5] */
$frame-icon-bg: $color-ground;
$scrollbar-page-fg: $color-border_dim;/*  [ 83] Scroll bar page -- CDoubleWindow[4] -> CScrollBar[1] */
$scrollbar-page-bg: $color-ground;
$scrollbar-arrow-fg: $color-text_dim; /*  [ 84] Scroll bar icons -- CDoubleWindow[5] -> CScrollBar[2,3] */
$scrollbar-arrow-bg: $color-ground;

/* -- File Panel ---------------------------------------------------------- */
$panel-fg: $color-text;               /*> [ 85] Normal text -- CDoubleWindow[6] -> CPanel[1] */
$panel-bg: $color-ground;
$marked-fg: $color-marked;            /*  [ 87] Selected text -- CDoubleWindow[8] -> CPanel[3] */
$marked-bg: $color-ground;
$cursor-fg: $color-on_accent;         /*> [ 88] Normal cursor -- CDoubleWindow[9] -> CPanel[4] */
$cursor-bg: $color-accent;
$marked-cursor-fg: $color-on_accent_alt;/*  [ 89] Selected cursor -- CDoubleWindow[10] -> CPanel[5] */
$marked-cursor-bg: $color-accent;
$divider-fg: $color-border_dim;       /*  [ 86] List divider -- CDoubleWindow[7] -> CPanel[2] */
$divider-bg: $color-ground;
$active-title-fg: $color-on_accent;   /*> [ 90] Directory active -- CDoubleWindow[11] -> CTopView[1] */
$active-title-bg: $color-accent;
$title-fg: $color-text_dim;           /*> [ 91] Directory passive -- CDoubleWindow[12] -> CTopView[2] */
$title-bg: $color-ground;
$column-title-fg: $color-accent;      /*> [165] Column title -- CDoubleWindow[32] -> CPanel[6] */
$column-title-bg: $color-ground;

/* -- Highlight ----------------------------------------------------------- */
$directory-fg: $color-dir;            /*> [172] Directories -- CDoubleWindow[33] -> CPanel[7], ttDirectory */
$directory-bg: $color-ground;
$executable-fg: $color-exec;          /*> [173] Executables -- CDoubleWindow[34] -> CPanel[8], ttExec */
$executable-bg: $color-ground;
$archive-fg: $color-archive;          /*> [174] Archives -- CDoubleWindow[35] -> CPanel[9], ttArc */
$archive-bg: $color-ground;
$highlight-custom-1-fg: $color-image; /*> [175] Custom 1 */
$highlight-custom-1-bg: $color-ground;
$highlight-custom-2-fg: $color-media; /*> [176] Custom 2 */
$highlight-custom-2-bg: $color-ground;
$highlight-custom-3-fg: $color-document;/*> [177] Custom 3 */
$highlight-custom-3-bg: $color-ground;
$highlight-custom-4-fg: $color-broken;/*> [180] Custom 4 */
$highlight-custom-4-bg: $color-ground;
$highlight-custom-5-fg: $color-source;/*> [181] Custom 5 */
$highlight-custom-5-bg: $color-ground;

/* -- Drive Line ---------------------------------------------------------- */
$drive-line-drive-letters-fg: $color-text;/*  [186] Drive letters */
$drive-line-drive-letters-bg: $color-overlay;
$drive-line-drive-selected-fg: $color-on_accent;/*  [188] Drive selected */
$drive-line-drive-selected-bg: $color-accent;
$drive-line-frame-fg: $color-border;  /*  [187] Frame */
$drive-line-frame-bg: $color-overlay;

/* -- Info ---------------------------------------------------------------- */
$info-current-file-fg: $color-text;   /*  [119] Current file */
$info-current-file-bg: $color-ground;
$info-selected-text-fg: $color-marked;/*  [120] Selected text */
$info-selected-text-bg: $color-ground;
$info-selected-numbers-fg: $color-marked;/*  [121] Selected numbers */
$info-selected-numbers-bg: $color-ground;
$info-totals-text-fg: $color-text_dim;/*  [122] Totals text */
$info-totals-text-bg: $color-ground;
$info-totals-numbers-fg: $color-text; /*  [123] Totals numbers */
$info-totals-numbers-bg: $color-ground;
$info-free-space-text-fg: $color-text_dim;/*  [124] Free space text */
$info-free-space-text-bg: $color-ground;
$info-free-space-numbers-fg: $color-text;/*  [125] Free space numbers */
$info-free-space-numbers-bg: $color-ground;

/* -- Tree ---------------------------------------------------------------- */
$tree-normal-tree-fg: $color-text_dim;/*  [ 94] Normal tree */
$tree-normal-tree-bg: $color-ground;
$tree-normal-nodes-fg: $color-text;   /*  [ 95] Normal nodes */
$tree-normal-nodes-bg: $color-ground;
$tree-selected-node-fg: $color-on_accent;/*  [ 96] Selected node */
$tree-selected-node-bg: $color-accent;
$tree-default-node-fg: $color-dir;    /*  [ 97] Default node */
$tree-default-node-bg: $color-ground;
$tree-selected-default-fg: $color-on_accent_alt;/*  [ 98] Selected default */
$tree-selected-default-bg: $color-accent;
$tree-selected-passive-fg: $color-on_selection;/*  [ 99] Selected passive */
$tree-selected-passive-bg: $color-selection;
$tree-selected-def-passive-fg: $color-dir;/*  [100] Selected def. passive */
$tree-selected-def-passive-bg: $color-selection;
$tree-info-box-fg: $color-text;       /*  [101] Info box */
$tree-info-box-bg: $color-raised;

/* -- Quick View ---------------------------------------------------------- */
$quick-view-normal-text-fg: $color-text;/*  [ 92] Normal text */
$quick-view-normal-text-bg: $color-ground;
$quick-view-selected-text-fg: $color-on_selection;/*  [ 93] Selected text */
$quick-view-selected-text-bg: $color-selection;

/* -- Disk Info ----------------------------------------------------------- */
$disk-info-normal-text-fg: $color-text;/*  [103] Normal text */
$disk-info-normal-text-bg: $color-ground;
$disk-info-highlighted-text-fg: $color-accent;/*  [102] Highlighted text */
$disk-info-highlighted-text-bg: $color-ground;

/* -- File Viewer --------------------------------------------------------- */
$viewer-frame-passive-fg: $color-border_dim;/*  [112] Frame passive */
$viewer-frame-passive-bg: $color-ground;
$viewer-frame-active-fg: $color-border;/*  [113] Frame active */
$viewer-frame-active-bg: $color-ground;
$viewer-frame-icons-fg: $color-accent;/*  [114] Frame icons */
$viewer-frame-icons-bg: $color-ground;
$viewer-scroll-bar-page-fg: $color-border_dim;/*  [115] Scroll bar page */
$viewer-scroll-bar-page-bg: $color-ground;
$viewer-scroll-bar-icons-fg: $color-text_dim;/*  [116] Scroll bar icons */
$viewer-scroll-bar-icons-bg: $color-ground;
$viewer-normal-text-fg: $color-text;  /*  [117] Normal text */
$viewer-normal-text-bg: $color-ground;
$viewer-selected-text-fg: $color-on_selection;/*  [118] Selected text */
$viewer-selected-text-bg: $color-selection;

/* -- Editor/Spreadsheet -------------------------------------------------- */
$editor-frame-passive-fg: $color-border_dim;/*  [ 70] Frame passive */
$editor-frame-passive-bg: $color-ground;
$editor-frame-active-fg: $color-border;/*  [ 71] Frame active */
$editor-frame-active-bg: $color-ground;
$editor-frame-icons-fg: $color-accent;/*  [ 73] Frame icons */
$editor-frame-icons-bg: $color-ground;
$editor-frame-title-fg: $color-text_strong;/*  [ 72] Frame title */
$editor-frame-title-bg: $color-ground;
$editor-scroll-bar-page-fg: $color-border_dim;/*  [ 74] Scroll bar page */
$editor-scroll-bar-page-bg: $color-ground;
$editor-scroll-bar-icons-fg: $color-text_dim;/*  [ 75] Scroll bar icons */
$editor-scroll-bar-icons-bg: $color-ground;
$editor-normal-text-fg: $color-text;  /*  [ 76] Normal text */
$editor-normal-text-bg: $color-ground;
$editor-selected-text-fg: $color-on_selection;/*  [ 77] Selected text */
$editor-selected-text-bg: $color-selection;

/* -- Highlight ----------------------------------------------------------- */
$editor-highlight-comments-fg: $color-comment;/*  [164] Comments */
$editor-highlight-comments-bg: $color-ground;
$editor-highlight-symbols-fg: $color-symbol;/*  [189] Symbols */
$editor-highlight-symbols-bg: $color-ground;
$editor-highlight-strings-fg: $color-string;/*  [190] Strings */
$editor-highlight-strings-bg: $color-ground;
$editor-highlight-numbers-fg: $color-number;/*  [191] Numbers */
$editor-highlight-numbers-bg: $color-ground;
$editor-highlight-current-line-fg: $color-text;/*  [182] Current line */
$editor-highlight-current-line-bg: $color-ground_alt;
$editor-highlight-cur-line-comments-fg: $color-comment;/*  [184] Cur. line comments */
$editor-highlight-cur-line-comments-bg: $color-ground_alt;
$editor-highlight-current-line-selected-fg: $color-on_selection;/*  [183] Current line selected */
$editor-highlight-current-line-selected-bg: $color-selection;
$editor-highlight-current-column-fg: $color-text;/*  [185] Current column */
$editor-highlight-current-column-bg: $color-ground_alt;

/* -- Menu ---------------------------------------------------------------- */
$editor-menu-normal-fg: $color-text;  /*  [ 64] Normal */
$editor-menu-normal-bg: $color-overlay;
$editor-menu-disabled-fg: $color-text_faint;/*  [ 65] Disabled */
$editor-menu-disabled-bg: $color-overlay;
$editor-menu-shortcut-fg: $color-hotkey;/*  [ 66] Shortcut */
$editor-menu-shortcut-bg: $color-overlay;
$editor-menu-selected-fg: $color-on_accent;/*  [ 67] Selected */
$editor-menu-selected-bg: $color-accent;
$editor-menu-selected-disabled-fg: $color-on_accent_faint;/*  [ 68] Selected disabled */
$editor-menu-selected-disabled-bg: $color-accent;
$editor-menu-shortcut-selected-fg: $color-on_accent_alt;/*  [ 69] Shortcut selected */
$editor-menu-shortcut-selected-bg: $color-accent;

/* -- Disk Fixer ---------------------------------------------------------- */
$fixer-frame-passive-fg: $color-border_dim;/*  [153] Frame passive */
$fixer-frame-passive-bg: $color-ground;
$fixer-frame-active-fg: $color-border;/*  [154] Frame active */
$fixer-frame-active-bg: $color-ground;
$fixer-frame-icons-fg: $color-accent; /*  [156] Frame icons */
$fixer-frame-icons-bg: $color-ground;
$fixer-frame-title-fg: $color-text_strong;/*  [155] Frame title */
$fixer-frame-title-bg: $color-ground;
$fixer-scroll-bar-page-fg: $color-border_dim;/*  [157] Scroll bar page */
$fixer-scroll-bar-page-bg: $color-ground;
$fixer-scroll-bar-icons-fg: $color-text_dim;/*  [158] Scroll bar icons */
$fixer-scroll-bar-icons-bg: $color-ground;
$fixer-normal-text-fg: $color-text;   /*  [159] Normal text */
$fixer-normal-text-bg: $color-ground;
$fixer-selected-text-fg: $color-on_selection;/*  [160] Selected text */
$fixer-selected-text-bg: $color-selection;
$fixer-sector-title-fg: $color-accent;/*  [161] Sector title */
$fixer-sector-title-bg: $color-ground;
$fixer-edit-line-fg: $color-text_strong;/*  [162] Edit line */
$fixer-edit-line-bg: $color-field;

/* -- Menu ---------------------------------------------------------------- */
$fixer-menu-normal-fg: $color-text;   /*  [147] Normal */
$fixer-menu-normal-bg: $color-overlay;
$fixer-menu-disabled-fg: $color-text_faint;/*  [148] Disabled */
$fixer-menu-disabled-bg: $color-overlay;
$fixer-menu-shortcut-fg: $color-hotkey;/*  [149] Shortcut */
$fixer-menu-shortcut-bg: $color-overlay;
$fixer-menu-selected-fg: $color-on_accent;/*  [150] Selected */
$fixer-menu-selected-bg: $color-accent;
$fixer-menu-selected-disabled-fg: $color-on_accent_faint;/*  [151] Selected disabled */
$fixer-menu-selected-disabled-bg: $color-accent;
$fixer-menu-shortcut-selected-fg: $color-on_accent_alt;/*  [152] Shortcut selected */
$fixer-menu-shortcut-selected-bg: $color-accent;

/* -- Terminal ------------------------------------------------------------ */
$terminal-frame-passive-fg: $color-border_dim;/*  [  8] Frame passive */
$terminal-frame-passive-bg: $color-ground;
$terminal-frame-active-fg: $color-border;/*  [  9] Frame active */
$terminal-frame-active-bg: $color-ground;
$terminal-frame-icons-fg: $color-accent;/*  [ 10] Frame icons */
$terminal-frame-icons-bg: $color-ground;
$terminal-scroll-bar-page-fg: $color-border_dim;/*  [ 11] Scroll bar page */
$terminal-scroll-bar-page-bg: $color-ground;
$terminal-scroll-bar-icons-fg: $color-text_dim;/*  [ 12] Scroll bar icons */
$terminal-scroll-bar-icons-bg: $color-ground;

/* -- dBase viewer -------------------------------------------------------- */
$dbase-frame-passive-fg: $color-border_dim;/*  [166] Frame passive */
$dbase-frame-passive-bg: $color-ground;
$dbase-frame-active-fg: $color-border;/*  [167] Frame active */
$dbase-frame-active-bg: $color-ground;
$dbase-frame-icons-fg: $color-accent; /*  [168] Frame icons */
$dbase-frame-icons-bg: $color-ground;
$dbase-fields-titles-fg: $color-accent;/*  [169] Fields titles */
$dbase-fields-titles-bg: $color-raised;
$dbase-normal-text-fg: $color-text;   /*  [170] Normal text */
$dbase-normal-text-bg: $color-ground;
$dbase-cursor-fg: $color-on_accent;   /*  [171] Cursor */
$dbase-cursor-bg: $color-accent;

/* -- Navigator's own: no DN slot ---------------------------------------- */
$image-fg: $color-image;              /*  images -- DN's Custom 1 */
$image-bg: $color-ground;
$media-fg: $color-media;              /*  audio and video -- DN's Custom 2 */
$media-bg: $color-ground;
$document-fg: $color-document;        /*  documents -- DN's Custom 3 */
$document-bg: $color-ground;
$stale-link-fg: $color-broken;        /*  a symlink pointing nowhere -- DN's Custom 4 */
$stale-link-bg: $color-ground;
$source-fg: $color-source;            /*  source code -- DN's Custom 5 */
$source-bg: $color-ground;
$symlink-fg: $color-link;             /*  a symlink -- Midnight Commander's class, on Custom 1 */
$symlink-bg: $color-ground;
$device-fg: $color-document;          /*  a character or block device -- MC's class, on Custom 3 */
$device-bg: $color-ground;
$special-fg: $color-document;         /*  a socket or a FIFO -- MC's class, on Custom 3 */
$special-bg: $color-ground;
$temp-fg: $color-temp;                /*  backups and temporaries -- MC's class, on Normal text */
$temp-bg: $color-ground;
$root-title-fg: $color-on_error;      /*  a title while running as root -- no slot */
$root-title-bg: $color-error;
$error-dialog-fg: $color-on_error;    /*  the error box, frame and text -- no slot: DN's error boxes were grey */
$error-dialog-bg: $color-error;
$error-dialog-icons-fg: $color-warn;  /*  the error box's frame icons -- no slot */
$error-dialog-icons-bg: $color-error;
$error-dialog-shadow-fg: $color-error_shadow;/*  the error box's button shadows -- no slot */
$error-dialog-shadow-bg: $color-error;
$keyword-fg: $color-keyword;          /*  the editor's keywords -- DN loaded KEYWORDS1 and never painted them; on Normal text */
$keyword-bg: $color-ground;
$modified-title-fg: $color-modified;  /*  a changed file's title in the editor -- no slot: DN marked it on the info line */
$modified-title-bg: $color-ground;
$shadow-fg: $color-drop_shadow_text;  /*  the drop shadow a window, a dialog or a menu casts -- no slot: Turbo Vision's ShadowAttr, $08 */
$shadow-bg: $color-drop_shadow;
$command-line-fg: $color-text;        /*  the command line -- no slot: TCommandLine.Draw wrote $07 */
$command-line-bg: $color-desktop;
$command-line-prompt-fg: $color-accent;/*  the command line's prompt -- no slot: TCommandLine.Draw wrote $0F */
$command-line-prompt-bg: $color-desktop;
$viewer-comments-fg: $color-comment;  /*  the viewer's comments -- DN's viewer had no highlighting; on Comments */
$viewer-comments-bg: $color-ground;
$viewer-symbols-fg: $color-symbol;    /*  the viewer's symbols -- on Symbols */
$viewer-symbols-bg: $color-ground;
$viewer-strings-fg: $color-string;    /*  the viewer's strings -- on Strings */
$viewer-strings-bg: $color-ground;
$viewer-numbers-fg: $color-number;    /*  the viewer's numbers -- on Numbers */
$viewer-numbers-bg: $color-ground;
$viewer-keyword-fg: $color-keyword;   /*  the viewer's keywords and headings -- on the editor's Normal text */
$viewer-keyword-bg: $color-ground;
$viewer-links-fg: $color-accent;      /*  the viewer's links and bullets -- on its Frame icons */
$viewer-links-bg: $color-ground;
